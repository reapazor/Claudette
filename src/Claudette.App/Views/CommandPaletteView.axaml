<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">
  <UserControl.Styles>
    <!-- What kind an entry is: a quiet label beside it. -->
    <Style Selector="TextBlock.palettegroup">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinWidth" Value="60" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.paletteshortcut">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- The command palette (DESIGN.md §4, "Command palette") -->
  <Border Classes="dialog" Width="620" Padding="12">
    <DockPanel>
      <TextBox x:Name="QueryBox" DockPanel.Dock="Top" Text="{Binding Query}" PlaceholderText="Type a command, a tab, a folder or a setting"
               AutomationProperties.Name="Command palette" Margin="0,0,0,8" />
      <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Margin="0,8,0,0" Text="Enter runs · ↑↓ choose · Esc closes" />
      <StackPanel>
        <TextBlock Classes="muted small" Text="Nothing matches." IsVisible="{Binding !HasResults}" Margin="4,12" />
        <ListBox x:Name="Results" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="420"
                 IsVisible="{Binding HasResults}" DoubleTapped="OnResultDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:PaletteEntry">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Background="Transparent">
                <TextBlock Classes="palettegroup" Text="{Binding Group}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted small" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Classes="paletteshortcut" IsVisible="{Binding HasShortcut}">
                  <TextBlock Classes="muted small" Text="{Binding Shortcut}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
