<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:conv="using:Claudette.App.Conversation"
             xmlns:core="using:Claudette.Core.Sessions"
             xmlns:settings="using:Claudette.Core.Settings"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Claudette.App.Views.TabView"
             x:DataType="vm:TabViewModel"
             FontSize="{DynamicResource ConversationFontSize}">

  <UserControl.Styles>
    <Style Selector="Border.diffline.added">
      <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
    </Style>
    <Style Selector="Border.diffline.removed">
      <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
    </Style>
    <Style Selector="Border.diffline.hunk">
      <Setter Property="Background" Value="{DynamicResource DiffHunkBrush}" />
    </Style>
    <Style Selector="Border.codeblock">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBlock.done">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,2,4,2" />
    </Style>
    <Style Selector="Border.chip.kept">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Conversation templates (DESIGN.md §5). Declared on the control so nested subagent groups use them too. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="conv:UserMessageItem">
      <Border Background="{DynamicResource UserBoxBrush}" BorderBrush="{DynamicResource UserBoxBorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12,8" Margin="0,6,0,2">
        <StackPanel Spacing="4">
          <TextBlock Classes="muted small" Text="Automatic check-in" IsVisible="{Binding IsCheckIn}" />
          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <SelectableTextBlock Classes="muted small" Text="{Binding SuffixText}" TextWrapping="Wrap" IsVisible="{Binding HasSuffix}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="conv:AssistantTextItem">
      <md:MarkdownRenderer MarkdownBuilder="{Binding Markdown}"
                           LinkCommand="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).OpenLinkCommand}" />
    </DataTemplate>

    <DataTemplate DataType="conv:ThinkingItem">
      <StackPanel Spacing="2">
        <Button Classes="flat row" Command="{Binding ToggleCommand}" IsHitTestVisible="{Binding HasText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted" Text="✻" />
            <TextBlock Classes="muted" FontStyle="Italic" Text="{Binding Header}" />
          </StackPanel>
        </Button>
        <SelectableTextBlock Classes="muted" FontStyle="Italic" TextWrapping="Wrap" Margin="22,0,0,4"
                             Text="{Binding Text}" IsVisible="{Binding IsExpanded}" />
      </StackPanel>
    </DataTemplate>

    <!-- Subagent: must come before ToolUseItem, which it derives from. -->
    <DataTemplate DataType="conv:SubagentItem">
      <StackPanel Spacing="2">
        <Button Classes="flat row" Command="{Binding ToggleCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="status" Classes.busy="{Binding !IsComplete}" Classes.ok="{Binding IsComplete}" Classes.failed="{Binding IsError}" Text="●" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Icon}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock FontWeight="SemiBold" Text="{Binding AgentType}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border BorderBrush="{DynamicResource SubagentLineBrush}" BorderThickness="2,0,0,0" Margin="10,0,0,0" Padding="12,2,0,2"
                IsVisible="{Binding IsExpanded}">
          <StackPanel Spacing="6">
            <SelectableTextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" MaxHeight="120" IsVisible="{Binding HasDetail}" />
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="conv:ToolUseItem">
      <StackPanel Spacing="4">
        <Button Classes="flat row" Command="{Binding ToggleCommand}" IsHitTestVisible="{Binding CanExpand}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <TextBlock Classes="status" Classes.busy="{Binding !IsComplete}" Classes.ok="{Binding IsComplete}" Classes.failed="{Binding IsError}"
                       Text="●" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Summary}" MaxWidth="560" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="mono small" Text="{Binding DiffStats}" IsVisible="{Binding HasDiff}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </Button>
        <TextBlock Classes="muted small mono" Text="{Binding ResultSummary}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis"
                   Margin="22,0,0,0" IsVisible="{Binding HasResultSummary}" />

        <!-- Expanded -->
        <StackPanel Spacing="6" Margin="22,2,0,4" IsVisible="{Binding IsExpanded}">
          <Border Classes="codeblock" IsVisible="{Binding IsBash}">
            <SelectableTextBlock Classes="mono" Text="{Binding Command, StringFormat='$ {0}'}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="codeblock" IsVisible="{Binding HasDetail}">
            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Classes="mono small" Text="{Binding Detail}" />
            </ScrollViewer>
          </Border>
          <Border Classes="codeblock" Padding="0" IsVisible="{Binding HasDiff}">
            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Diff.Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="conv:DiffLine">
                    <Border Classes="diffline" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.hunk="{Binding IsHunk}" Padding="6,0">
                      <Grid ColumnDefinitions="36,36,14,*">
                        <TextBlock Classes="mono muted small" Text="{Binding OldNumberText}" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Classes="mono muted small" Text="{Binding NewNumberText}" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="2" Classes="mono" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Text="{Binding Marker}" />
                        <SelectableTextBlock Grid.Column="3" Classes="mono" Text="{Binding Text}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Border Classes="codeblock" IsVisible="{Binding HasOutput}">
            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Classes="mono small" Text="{Binding Output}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="conv:PermissionItem">
      <Border Padding="12,10" CornerRadius="8" BorderThickness="1" Margin="0,2"
              BorderBrush="{DynamicResource CautionBorderBrush}" Background="{DynamicResource CautionBackgroundBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
          <SelectableTextBlock Classes="mono" Text="{Binding Detail}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPending}">
            <Button Classes="accent" Content="Allow" Command="{Binding AllowCommand}" />
            <Button Content="Deny" Command="{Binding DenyCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding Outcome}" IsVisible="{Binding !IsPending}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="conv:NoteItem">
      <SelectableTextBlock Classes="muted small" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding Text}"
                           Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" />
    </DataTemplate>

    <DataTemplate DataType="conv:TurnSummaryItem">
      <TextBlock Classes="muted small" Text="{Binding Text}" Opacity="0.8" Margin="0,0,0,4" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="*,Auto">

    <!-- Conversation -->
    <Grid Grid.Row="0">
      <DockPanel>
        <!-- Pinned to-do list -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding TodoList.HasItems}" Background="{DynamicResource SubtleBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,4">
          <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <Button Classes="flat row" Command="{Binding TodoList.ToggleExpandedCommand}">
              <TextBlock Classes="muted small" FontWeight="SemiBold" Text="{Binding TodoList.Summary}" />
            </Button>
            <ItemsControl ItemsSource="{Binding TodoList.Items}" IsVisible="{Binding TodoList.IsExpanded}" Margin="4,0,0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="conv:TodoItem">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Glyph}" Classes.status="{Binding IsActive}" Classes.busy="{Binding IsActive}" />
                    <TextBlock Text="{Binding DisplayText}" Classes.done="{Binding IsDone}" FontWeight="{Binding IsActive, Converter={x:Static vm:Converters.BoldIfTrue}}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ScrollViewer x:Name="ConversationScroll" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Items}" Margin="24,16,24,24" MaxWidth="900">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Button x:Name="JumpToLatest" Content="↓ Jump to latest" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12"
              IsVisible="False" Click="OnJumpToLatest" />

      <!-- Model switch confirmation (DESIGN.md §5) -->
      <Border Classes="overlay" IsVisible="{Binding HasPendingModel}">
        <Border Classes="dialog" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="Switch model?" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding PendingModelMessage}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Command="{Binding CancelModelSwitchCommand}" />
              <Button Classes="accent" Content="Switch model" Command="{Binding ConfirmModelSwitchCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <!-- Composer (DESIGN.md §5) -->
    <StackPanel Grid.Row="1" Margin="16,4,16,12" MaxWidth="948" Spacing="6">

      <!-- Possibly stuck (check-ins) -->
      <Border Classes="codeblock" IsVisible="{Binding IsPossiblyStuck}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="warning" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Claude hasn't answered two check-ins. It may be stuck." />
          <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" />
        </Grid>
      </Border>

      <!-- Quick suffix chips -->
      <ItemsControl ItemsSource="{Binding Chips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SuffixChip">
            <Border Classes="chip" Classes.kept="{Binding IsKept}" ToolTip.Tip="{Binding Suffix.Text}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="small" Text="{Binding Label}" VerticalAlignment="Center" />
                <Button Classes="flat" Padding="3" ToolTip.Tip="Remove"
                        Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).RemoveChipCommand}" CommandParameter="{Binding}">
                  <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
                </Button>
              </StackPanel>
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Keep on this tab / stop keeping" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ToggleKeepCommand}" CommandParameter="{Binding}" />
                </ContextMenu>
              </Border.ContextMenu>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="composer">
        <Grid RowDefinitions="Auto,Auto">
          <TextBox x:Name="Composer" Text="{Binding ComposerText}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="40" MaxHeight="240" Padding="2,6"
                   PlaceholderText="Message Claude…  (Enter to send, Shift+Enter for a new line, Esc to stop)" />

          <!-- Control bar -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="SuffixButton" Classes="flat" ToolTip.Tip="Quick suffixes (Ctrl/Cmd+Shift+S)">
                <TextBlock Classes="muted small" Text="Suffixes ▾" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel MinWidth="260" Spacing="2">
                      <ItemsControl ItemsSource="{Binding AvailableSuffixes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="settings:QuickSuffix">
                            <Button Classes="flat row" ToolTip.Tip="{Binding Text}" Click="OnSuffixPicked"
                                    Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).AddSuffixCommand}" CommandParameter="{Binding}">
                              <TextBlock Text="{Binding Label}" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Separator Margin="0,4" />
                      <TextBlock Classes="muted small" Text="Edit suffixes in Settings → Quick suffixes" Margin="6,0,6,4" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Model">
                <TextBlock Classes="muted small" Text="{Binding ModelName, StringFormat='{}{0} ▾', TargetNullValue='Model ▾'}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <ItemsControl ItemsSource="{Binding Models}" MinWidth="240">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="core:ModelInfo">
                          <Button Classes="flat row" Click="OnFlyoutItemPicked"
                                  Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChooseModelCommand}" CommandParameter="{Binding}">
                            <StackPanel>
                              <TextBlock Text="{Binding DisplayName}" />
                              <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="320" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Effort">
                <TextBlock Classes="muted small" Text="{Binding EffortName, StringFormat='{}{0} ▾'}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel MinWidth="160">
                      <Button Classes="flat row" Content="Default" Click="OnFlyoutItemPicked" Command="{Binding ChooseEffortCommand}" CommandParameter="{x:Null}" />
                      <ItemsControl ItemsSource="{Binding EffortLevels}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="flat row" Content="{Binding}" Click="OnFlyoutItemPicked"
                                    Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChooseEffortCommand}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <TextBlock Classes="muted small" VerticalAlignment="Center" Margin="6,0" Text="{Binding PermissionMode, StringFormat='Mode: {0}'}"
                         IsVisible="{Binding PermissionMode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
              <TextBlock Classes="muted small" Classes.warning="{Binding IsContextHigh}" VerticalAlignment="Center" Margin="4,0"
                         Text="{Binding ContextText}" ToolTip.Tip="{Binding ContextDetail}"
                         IsVisible="{Binding ContextText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <Button Classes="flat" ToolTip.Tip="Tokens used by this tab">
                <TextBlock Classes="muted small" Text="{Binding TokensShort}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="8" MinWidth="420">
                      <TextBlock FontWeight="SemiBold" Text="Tokens used by this tab" />
                      <Grid ColumnDefinitions="*,70,70,80,80,60">
                        <TextBlock Classes="muted small" Text="Model" />
                        <TextBlock Grid.Column="1" Classes="muted small" Text="Input" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="muted small" Text="Output" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="muted small" Text="Cache write" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="muted small" Text="Cache read" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Classes="muted small" Text="Cost" HorizontalAlignment="Right" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding TokenRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:TokenRow">
                            <Grid ColumnDefinitions="*,70,70,80,80,60">
                              <TextBlock Classes="small" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="small mono" Text="{Binding Input}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="2" Classes="small mono" Text="{Binding Output}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="3" Classes="small mono" Text="{Binding CacheWrite}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="4" Classes="small mono" Text="{Binding CacheRead}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="5" Classes="small mono" Text="{Binding Cost}" HorizontalAlignment="Right" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="muted small" Text="{Binding TokenSummary}" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Tab info">
                <TextBlock Classes="muted small" Text="ⓘ" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <ItemsControl ItemsSource="{Binding InfoRows}" MinWidth="320" MaxWidth="480">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:InfoRow">
                          <Grid ColumnDefinitions="72,*" Margin="0,1">
                            <TextBlock Classes="muted small" Text="{Binding Label}" />
                            <SelectableTextBlock Grid.Column="1" Classes="small" Text="{Binding Value}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="accent" Content="Send" Padding="14,4" Margin="6,0,0,0" Command="{Binding SendCommand}" IsVisible="{Binding !IsWorking}" />
              <Button Content="■" Padding="12,4" Margin="6,0,0,0" ToolTip.Tip="Stop (Esc)" AutomationProperties.Name="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsWorking}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Status line -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0">
        <TextBlock Classes="muted small" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" MaxWidth="520" />
        <TextBlock Classes="muted small" Text="{Binding StatusTip}" />
        <Button Classes="flat" Padding="4,0" IsVisible="{Binding CanRestart}" Command="{Binding RestartCommand}">
          <TextBlock Classes="small" Text="Restart" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
