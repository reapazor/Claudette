<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:views="using:Claudette.App.Views"
             x:Class="Claudette.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Classes.compact="{Binding IsCompact}"
             Classes.claude="{Binding IsClaudeStyle}"
             Classes.fullwidth="{Binding IsFullWidth}">
  <!-- Settings → Appearance → Density (DESIGN.md §14): "compact" tightens the rows, the conversation and the composer,
       through the styles in App.axaml and TabView. Settings → Appearance → Style (DESIGN.md §3): "claude" gives them
       the Claude apps' shapes. Settings → Appearance → Full-width conversation (DESIGN.md §14): "fullwidth" lets the
       conversation and the composer fill the tab. -->

  <UserControl.Resources>
    <!-- The tab info card (DESIGN.md §4), used as the tab tooltip. -->
    <DataTemplate x:Key="InfoCard" DataType="vm:TabViewModel">
      <StackPanel Spacing="4" MaxWidth="480">
        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding InfoRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:InfoRow">
              <Grid ColumnDefinitions="88,*">
                <TextBlock Classes="muted small" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="small" Text="{Binding Value}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- The Mark submenu of a tab's menu (DESIGN.md §4, "Marks"), in the full sidebar and the rail: each mark with its
         icon, the tab's own ticked. Each item ticks itself as it's clicked; the menu is made again as the mark changes,
         so the binding stays one-way. -->
    <ControlTheme x:Key="MarkMenuItemTheme" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:MarkMenuItem">
      <Setter Property="ToggleType" Value="CheckBox" />
      <Setter Property="IsChecked" Value="{Binding IsOn, Mode=OneWay}" />
      <Setter Property="Command" Value="{Binding Toggle}" />
      <Setter Property="CommandParameter" Value="{Binding Mark}" />
    </ControlTheme>
    <!-- Assign to thread: one entry per thread in the group (DESIGN.md §18, "Threads"). -->
    <ControlTheme x:Key="ThreadMenuItemTheme" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ThreadMenuItem">
      <Setter Property="Header" Value="{Binding Name}" />
      <Setter Property="Command" Value="{Binding Assign}" />
      <Setter Property="CommandParameter" Value="{Binding Thread}" />
    </ControlTheme>
    <DataTemplate x:Key="MarkMenuItemTemplate" DataType="vm:MarkMenuItem">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <views:MarkIcon Mark="{Binding Mark}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The sidebar's own rows: New tab, History, the update badge and Settings. The icon keeps its place when the
         sidebar collapses to its rail. -->
    <Style Selector="Button.side">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="13,7,8,7" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.side Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.side.update Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- Only the badge's own label: its flyout's text is inside the button too. -->
    <Style Selector="Button.side.update TextBlock.badge">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- A thread's sub-threads sit indented under it (DESIGN.md §18, "Threads"). -->
    <Style Selector="StackPanel.subthread">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="Border#SidebarEdge:pointerover">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <!-- A tab's Claude app icon while it connects or reconnects (DESIGN.md §18, "Remote Control"). -->
    <Style Selector="Border#RemoteIcon.settling">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Switched off and waiting to disconnect: fainter still. After .settling, so it wins when both apply. -->
    <Style Selector="Border#RemoteIcon.leaving">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <!-- How many tasks a tab still has running once its turn is over (DESIGN.md §4, "Sidebar"): no taller than the
         name beside it, so the row keeps its height. -->
    <Style Selector="Border.taskbadge">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinWidth" Value="15" />
      <Setter Property="Padding" Value="3,0" />
    </Style>
    <Style Selector="Border.taskbadge > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector=".claude Border.taskbadge">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- Where a tab works, at the right of its row's second line (DESIGN.md §4, "Sidebar"): the git branch or worktree,
         and the Perforce changelist. A long branch name is cut short rather than squeezing the model out. -->
    <Style Selector="Button.rowbadge">
      <Setter Property="Padding" Value="0" />
      <!-- Its border mustn't make the line, and so the row, taller than the text beside it -->
      <Setter Property="Margin" Value="0,-1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="120" />
    </Style>
    <Style Selector="Border.rowbadge">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector=".claude Border.rowbadge">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- The sidebar: tabs grouped by folder, with New tab above and History, updates and Settings below
         (DESIGN.md §3, §4). Collapses to a rail of status icons. -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="{Binding Layout.SidebarDisplayWidth}" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- New tab, and collapsing -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,8,6,4" IsVisible="{Binding Layout.IsSidebarExpanded}">
          <Button Classes="flat side" Command="{Binding NewTabCommand}" ToolTip.Tip="{Binding Tips.NewTab}" AutomationProperties.Name="New tab">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="icon" Data="{StaticResource IconPlus}" />
              <TextBlock Text="New tab" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="flat" Padding="8" Command="{Binding Layout.ToggleSidebarCommand}"
                  ToolTip.Tip="{Binding Tips.CollapseSidebar}" AutomationProperties.Name="Collapse the sidebar">
            <Path Data="{StaticResource IconSidebar}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
          </Button>
        </Grid>
        <StackPanel Grid.Row="0" Margin="6,8,6,4" Spacing="2" IsVisible="{Binding Layout.IsSidebarCollapsed}">
          <Button Classes="flat side" Command="{Binding Layout.ToggleSidebarCommand}" ToolTip.Tip="{Binding Tips.ExpandSidebar}" AutomationProperties.Name="Expand the sidebar">
            <Path Classes="icon" Data="{StaticResource IconSidebar}" />
          </Button>
          <Button Classes="flat side" Command="{Binding NewTabCommand}" ToolTip.Tip="{Binding Tips.NewTab}" AutomationProperties.Name="New tab">
            <Path Classes="icon" Data="{StaticResource IconPlus}" />
          </Button>
        </StackPanel>

        <!-- Groups and their tabs. Drag a tab to reorder it in its group, or a group's label to move the group
             (DESIGN.md §4). -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Layout.IsSidebarExpanded}">
          <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}" Margin="6,0,6,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TabGroupViewModel">
                <StackPanel Margin="0,6,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <!-- Group label: click to collapse; right-click for group actions -->
                    <Button Classes="flat grouplabel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,4"
                            ToolTip.Tip="{Binding Summary}"
                            Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).ToggleGroupCollapsedCommand}" CommandParameter="{Binding}">
                      <DockPanel>
                        <Panel DockPanel.Dock="Left" Width="12" Margin="0,0,4,0">
                          <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform"
                                IsVisible="{Binding IsExpanded}" VerticalAlignment="Center" />
                          <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform"
                                IsVisible="{Binding IsCollapsed}" VerticalAlignment="Center" />
                        </Panel>
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock DockPanel.Dock="Right" Classes="status alert" Text="{Binding UrgentGlyph}" IsVisible="{Binding IsCollapsed}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="New tab here" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewTabInGroupCommand}" CommandParameter="{Binding}" />
                          <!-- Its own git worktree, so its edits don't meet the other tabs' (DESIGN.md §4, "Worktree tabs") -->
                          <MenuItem Header="New tab in a worktree" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewWorktreeTabCommand}" CommandParameter="{Binding}"
                                    IsVisible="{Binding CanMakeWorktrees}" ToolTip.Tip="A tab whose Claude works in a separate checkout, on its own branch" />
                          <!-- History listing only this project's sessions (DESIGN.md §9, "History") -->
                          <MenuItem Header="History for this folder" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenHistoryForGroupCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="{Binding CollapseMenuText}" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).ToggleGroupCollapsedCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Change color…" Click="OnChangeGroupColor" />
                          <Separator />
                          <MenuItem Header="Close group" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseGroupCommand}" CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <Button Grid.Column="1" Classes="flat" Padding="6" ToolTip.Tip="New tab in this folder" AutomationProperties.Name="New tab in this folder"
                            Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewTabInGroupCommand}" CommandParameter="{Binding}" VerticalAlignment="Center">
                      <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                    </Button>
                  </Grid>

                  <!-- Tabs, under a line in the group's color -->
                  <Border Margin="9,2,0,0" Padding="5,0,0,0" BorderBrush="{Binding Brush}" BorderThickness="2,0,0,0" IsVisible="{Binding IsExpanded}">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TabViewModel">
                          <StackPanel Spacing="1" Classes.subthread="{Binding IsSubThread}">
                            <Button Classes="tab tabrow" Classes.selected="{Binding IsSelected}" Classes.bypass="{Binding IsBypassMode}"
                                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}"
                                    DoubleTapped="OnTabDoubleTapped" ToolTip.ShowDelay="600" ToolTip.Placement="Right">
                              <ToolTip.Tip>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InfoCard}" />
                              </ToolTip.Tip>
                              <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="6">
                                <TextBlock Classes="status" Classes.busy="{Binding IsBusyStatus}" Classes.alert="{Binding IsAlertStatus}"
                                           Classes.failed="{Binding IsErrorStatus}" Classes.unread="{Binding IsUnread}"
                                           Text="{Binding StatusGlyph}" ToolTip.Tip="{Binding StatusTip}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <!-- The user's own mark (DESIGN.md §4, "Marks"), or the reviewed icon over it: under the status
                                     icon, level with the second line. The border gives the tip somewhere to hover. -->
                                <Border x:Name="RowMark" Background="Transparent" IsVisible="{Binding ShowsMarkIcon}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,2" ToolTip.Tip="{Binding MarkTip}" AutomationProperties.Name="{Binding MarkTip}">
                                  <views:MarkIcon Mark="{Binding Mark}" IsReviewed="{Binding AllFilesReviewed}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconPin}" Fill="{DynamicResource MutedTextBrush}" Width="8" Height="10" Stretch="Uniform"
                                          IsVisible="{Binding IsPinned}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <!-- The tab copies its session to the session library (DESIGN.md §9); the border gives the tip somewhere to hover -->
                                    <Border DockPanel.Dock="Left" Background="Transparent" IsVisible="{Binding SyncToLibrary}" VerticalAlignment="Center" Margin="0,0,5,0"
                                            ToolTip.Tip="Synced to the session library" AutomationProperties.Name="Synced to the session library">
                                      <Path Data="{StaticResource IconSync}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="9" Height="9" Stretch="Uniform" />
                                    </Border>
                                    <!-- A thread (DESIGN.md §18, "Threads"), with how many sub-threads it has as the tip -->
                                    <Border x:Name="ThreadIcon" DockPanel.Dock="Left" Background="Transparent" IsVisible="{Binding IsThread}" VerticalAlignment="Center" Margin="0,0,5,0"
                                            ToolTip.Tip="{Binding ThreadTip}" AutomationProperties.Name="{Binding ThreadTip}">
                                      <Path Data="{StaticResource IconThread}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="9" Height="9" Stretch="Uniform" />
                                    </Border>
                                    <!-- Works in a git worktree of its own (DESIGN.md §4, "Worktree tabs"); in the branch badge while that shows -->
                                    <Border DockPanel.Dock="Left" Background="Transparent" IsVisible="{Binding ShowWorktreeIcon}" VerticalAlignment="Center" Margin="0,0,5,0"
                                            ToolTip.Tip="{Binding WorktreeTip}" AutomationProperties.Name="{Binding WorktreeTip}">
                                      <Path Data="{StaticResource IconBranch}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="9" Height="9" Stretch="Uniform" />
                                    </Border>
                                    <!-- Connected to the Claude app (DESIGN.md §18, "Remote Control"); dimmed while it connects or reconnects,
                                         and more once it's switched off and waiting to disconnect -->
                                    <Border x:Name="RemoteIcon" DockPanel.Dock="Left" Background="Transparent" IsVisible="{Binding RemoteControl.ShowIcon}" VerticalAlignment="Center" Margin="0,0,5,0"
                                            Classes.settling="{Binding RemoteControl.IsSettling}" Classes.leaving="{Binding RemoteControl.IsLeaving}"
                                            ToolTip.Tip="{Binding RemoteControl.StatusTip}" AutomationProperties.Name="{Binding RemoteControl.StatusTip}">
                                      <Path Data="{StaticResource IconPhone}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="7" Height="10" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Left" Classes="status busy small" Text="⚙" IsVisible="{Binding ProcessMonitor.HasBusyProcesses}" VerticalAlignment="Center" Margin="0,0,5,0"
                                               ToolTip.Tip="A process this tab started is using CPU" />
                                    <!-- Tasks still running once the turn is over (DESIGN.md §4, "Sidebar"; §5, "Running tasks") -->
                                    <Border x:Name="TaskBadge" DockPanel.Dock="Left" Classes="taskbadge" IsVisible="{Binding ShowTaskBadge}" VerticalAlignment="Center" Margin="0,0,5,0"
                                            ToolTip.Tip="{Binding TaskBadgeTip}" AutomationProperties.Name="{Binding TaskBadgeTip}">
                                      <TextBlock Text="{Binding RunningTaskCount}" />
                                    </Border>
                                    <Panel>
                                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}" />
                                      <TextBox Text="{Binding RenameText}" IsVisible="{Binding IsRenaming}" Padding="4,1" MinHeight="0"
                                               KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" AttachedToVisualTree="OnRenameAttached" />
                                    </Panel>
                                  </DockPanel>
                                  <!-- The model and effort, or what needs attention; at its right, where the tab works (DESIGN.md §4, "Sidebar") -->
                                  <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                                      <!-- How far Claude's tasks have got (DESIGN.md §5, "Tasks"): selects the tab and opens the Tasks page -->
                                      <Button x:Name="TaskProgressBadge" Classes="flat rowbadge" IsVisible="{Binding ShowTaskProgressBadge}" Command="{Binding ShowTasksFromRowCommand}"
                                              ToolTip.Tip="{Binding TodoList.ProgressTip}" AutomationProperties.Name="{Binding TodoList.ProgressTip}">
                                        <Border Classes="rowbadge">
                                          <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Path Data="{StaticResource IconToolTodo}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform"
                                                  StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                                            <TextBlock Classes="muted small" Text="{Binding TodoList.ProgressShort}" />
                                          </StackPanel>
                                        </Border>
                                      </Button>
                                      <!-- The git branch, or the worktree: separate from the name, so renaming keeps it -->
                                      <Button x:Name="BranchBadge" Classes="flat rowbadge" IsVisible="{Binding ShowBranchBadge}"
                                              ToolTip.Tip="{Binding BranchBadgeTip}" AutomationProperties.Name="{Binding BranchBadgeTip}">
                                        <Border Classes="rowbadge">
                                          <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Path Data="{StaticResource IconBranch}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform"
                                                  VerticalAlignment="Center" IsVisible="{Binding IsInWorktree}" />
                                            <TextBlock Classes="muted small" Text="{Binding BranchBadge}" TextTrimming="CharacterEllipsis" />
                                          </StackPanel>
                                        </Border>
                                        <Button.Flyout>
                                          <MenuFlyout>
                                            <MenuItem Header="Copy branch name" Command="{Binding CopyBranchCommand}" />
                                          </MenuFlyout>
                                        </Button.Flyout>
                                      </Button>
                                      <!-- The Perforce changelist (DESIGN.md §18): separate from the name, so renaming keeps it -->
                                      <Button Classes="flat rowbadge changelist" IsVisible="{Binding Perforce.ShowChangelistBadge}"
                                              ToolTip.Tip="{Binding Perforce.ChangelistBadgeTip}" AutomationProperties.Name="{Binding Perforce.ChangelistBadge}">
                                        <Border Classes="rowbadge">
                                          <TextBlock Classes="muted small" Text="{Binding Perforce.ChangelistBadge}" />
                                        </Border>
                                        <Button.Flyout>
                                          <MenuFlyout>
                                            <MenuItem Header="Copy changelist number" Command="{Binding Perforce.CopyChangelistCommand}" CommandParameter="{x:Null}" />
                                            <MenuItem Header="Open in P4V" Command="{Binding Perforce.OpenChangelistInP4VCommand}" CommandParameter="{x:Null}" />
                                          </MenuFlyout>
                                        </Button.Flyout>
                                      </Button>
                                    </StackPanel>
                                    <TextBlock Classes="muted small" Classes.warning="{Binding IsAlertStatus}" Classes.error="{Binding IsErrorStatus}"
                                               Text="{Binding RowDetail}" TextTrimming="CharacterEllipsis" />
                                  </DockPanel>
                                </StackPanel>
                                <Panel Grid.Column="2">
                                  <Button Classes="flat closetab" Padding="4" VerticalAlignment="Top" ToolTip.Tip="Close tab" AutomationProperties.Name="Close tab"
                                          Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
                                  </Button>
                                  <!-- How full the tab's context is (DESIGN.md §4, §6): muted, amber near auto-compact, red when
                                       nearly full. Under the close button, level with the second line. Clicking it shows what
                                       fills the context, as the composer's indicator does, without selecting the tab. -->
                                  <Button x:Name="ContextRing" Classes="flat" Width="16" Height="16" Padding="0" VerticalAlignment="Bottom"
                                          IsVisible="{Binding Context.ShowRing}" ToolTip.Tip="{Binding Context.Tip}" AutomationProperties.Name="{Binding Context.Text}">
                                    <Panel Width="13" Height="13">
                                      <Ellipse Classes="contexttrack" />
                                      <Arc Classes="contextarc" Classes.high="{Binding Context.IsHigh}" Classes.critical="{Binding Context.IsCritical}"
                                           StartAngle="-90" SweepAngle="{Binding Context.Sweep}" />
                                    </Panel>
                                    <Button.Flyout>
                                      <Flyout Placement="RightEdgeAlignedBottom">
                                        <views:ContextBreakdownView />
                                      </Flyout>
                                    </Button.Flyout>
                                  </Button>
                                </Panel>
                              </Grid>
                              <Button.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" />
                                  <MenuItem Header="Reset name" Command="{Binding ResetNameCommand}" IsVisible="{Binding HasUserName}" />
                                  <MenuItem Header="{Binding PinMenuText}" Command="{Binding TogglePinCommand}" />
                                  <!-- An icon of the user's own under the status icon (DESIGN.md §4, "Marks") -->
                                  <MenuItem Header="Mark" ItemsSource="{Binding MarkMenu}" ItemContainerTheme="{StaticResource MarkMenuItemTheme}"
                                            ItemTemplate="{StaticResource MarkMenuItemTemplate}" />
                                  <MenuItem Header="Clear mark" Command="{Binding ClearMarkCommand}" IsVisible="{Binding HasMark}" />
                                  <!-- The item ticks itself as it's clicked, then runs the command, so the binding stays one-way -->
                                  <MenuItem Header="Sync to other machines" ToggleType="CheckBox" IsChecked="{Binding SyncToLibrary, Mode=OneWay}"
                                            Command="{Binding ToggleSyncToLibraryCommand}" />
                                  <!-- Copies to the library now, rather than after the next turn (DESIGN.md §9); disabled while Claude writes -->
                                  <MenuItem Header="Sync now" Command="{Binding SyncNowCommand}" IsVisible="{Binding SyncToLibrary}"
                                            ToolTip.Tip="{Binding SyncNowTip}" ToolTip.ShowOnDisabled="True" />
                                  <!-- Remote Control (DESIGN.md §18): disabled, with the reason as its tip, when the account can't use it -->
                                  <MenuItem Header="Connect to the Claude app" ToggleType="CheckBox" IsChecked="{Binding RemoteControl.IsOn, Mode=OneWay}"
                                            Command="{Binding RemoteControl.ToggleCommand}" ToolTip.Tip="{Binding RemoteControl.ToggleTip}" ToolTip.ShowOnDisabled="True" />
                                  <MenuItem Header="Open in the Claude app" Command="{Binding RemoteControl.OpenInClaudeAppCommand}" IsVisible="{Binding RemoteControl.HasUrl}" />
                                  <MenuItem Header="Tab settings…" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenTabSettingsCommand}" CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                      <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentStatusBrush}" IsVisible="{Binding HasOverrides}"
                                               ToolTip.Tip="This tab has its own settings" />
                                    </MenuItem.Icon>
                                  </MenuItem>
                                  <MenuItem Header="Duplicate tab" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).DuplicateTabCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="A new tab that carries this session on as a copy" />
                                  <!-- Threads (DESIGN.md §18): a tab whose Claude hands work to others in its group -->
                                  <MenuItem Header="Thread">
                                    <MenuItem Header="Make this tab a thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).MakeThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanMakeThread}"
                                              ToolTip.Tip="Its Claude can hand work to other tabs in this folder, its sub-threads, and gets their results back" />
                                    <MenuItem Header="New sub-thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewSubThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsThread}" />
                                    <MenuItem Header="New sub-thread in a worktree" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewSubThreadInWorktreeCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsThread}" />
                                    <MenuItem Header="Assign to thread" ItemsSource="{Binding AssignableThreads}" ItemContainerTheme="{StaticResource ThreadMenuItemTheme}" IsVisible="{Binding CanBeAssigned}" />
                                    <MenuItem Header="Go to thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).GoToThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsSubThread}" />
                                    <MenuItem Header="Detach from thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).DetachFromThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsSubThread}" />
                                    <MenuItem Header="Ask before sending to sub-threads" ToggleType="CheckBox" IsChecked="{Binding AskBeforeSendingToSubThreads, Mode=OneWay}"
                                              Command="{Binding ToggleAskBeforeSendingToSubThreadsCommand}" IsVisible="{Binding IsThread}" />
                                    <MenuItem Header="Stop being a thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).StopBeingThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsThread}"
                                              ToolTip.Tip="Its sub-threads carry on as ordinary tabs" />
                                  </MenuItem>

                                  <MenuItem Header="Export conversation…" Command="{Binding ExportConversationCommand}"
                                            ToolTip.Tip="Save the conversation as a Markdown file or a web page" />
                                  <MenuItem Header="Copy session ID" Command="{Binding CopySessionIdCommand}" IsVisible="{Binding HasSessionId}"
                                            ToolTip.Tip="What claude --resume takes" />
                                  <!-- Started without the folder's own configuration (DESIGN.md §7, "Folder trust") -->
                                  <MenuItem Header="Trust this folder" Command="{Binding TrustFolderCommand}" IsVisible="{Binding IsWithoutFolderSettings}"
                                            ToolTip.Tip="Start Claude Code again with this folder's own settings, MCP servers and CLAUDE.md" />
                                  <Separator />
                                  <MenuItem Header="Move up" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).MoveTabUpCommand}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Move down" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).MoveTabDownCommand}" CommandParameter="{Binding}" />
                                  <Separator />
                                  <MenuItem Header="Close" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Close other tabs" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseOtherTabsCommand}" CommandParameter="{Binding}" />
                                </ContextMenu>
                              </Button.ContextMenu>
                            </Button>
                            <!-- The tab's project runs, newest last, each with its log (DESIGN.md §4, §18). They stay until
                                 closed: × on a finished one, and Stop in its place while one runs. -->
                            <ItemsControl Classes="runs" ItemsSource="{Binding ProjectTools.Runs.Items}" IsVisible="{Binding ProjectTools.Runs.HasRuns}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="1" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ProjectRunViewModel">
                                  <Button Classes="flat runrow" Classes.showing="{Binding IsShowing}" Command="{Binding OpenCommand}"
                                          ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Right">
                                    <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="6">
                                      <TextBlock Classes="status runglyph" Classes.busy="{Binding IsRunning}" Classes.ok="{Binding Succeeded}" Classes.failed="{Binding Failed}"
                                                 Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                      <StackPanel Grid.Column="1">
                                        <TextBlock Classes="runname" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted rundetail" Classes.error="{Binding Failed}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                      </StackPanel>
                                      <Panel Grid.Column="2" VerticalAlignment="Top">
                                        <Button Classes="flat runclose" Padding="4" ToolTip.Tip="Close; its log goes too" AutomationProperties.Name="Close"
                                                Command="{Binding CloseCommand}" IsVisible="{Binding !IsRunning}">
                                          <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
                                        </Button>
                                        <Button Classes="flat runstop" Padding="4" ToolTip.Tip="Stop: ends the job and every process it started" AutomationProperties.Name="Stop"
                                                Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}">
                                          <Path Data="{StaticResource IconStop}" Fill="{DynamicResource MutedTextBrush}" Width="8" Height="8" Stretch="Uniform" />
                                        </Button>
                                      </Panel>
                                    </Grid>
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- The rail: each group's color, then a square per tab with its initial and status. A collapsed group shows
             its most urgent status. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding Layout.IsSidebarCollapsed}">
          <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TabGroupViewModel">
                <StackPanel Margin="0,6,0,0" Spacing="1">
                  <Button Classes="flat grouplabel" Width="38" Padding="0,5" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                          ToolTip.Tip="{Binding Label}" ToolTip.Placement="Right" AutomationProperties.Name="{Binding Label}"
                          Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).ToggleGroupCollapsedCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Border Width="16" Height="4" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center" />
                      <TextBlock Classes="status alert small" Text="{Binding UrgentGlyph}" IsVisible="{Binding IsCollapsed}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="New tab here" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewTabInGroupCommand}" CommandParameter="{Binding}" />
                        <!-- Its own git worktree, so its edits don't meet the other tabs' (DESIGN.md §4, "Worktree tabs") -->
                        <MenuItem Header="New tab in a worktree" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewWorktreeTabCommand}" CommandParameter="{Binding}"
                                  IsVisible="{Binding CanMakeWorktrees}" ToolTip.Tip="A tab whose Claude works in a separate checkout, on its own branch" />
                        <!-- History listing only this project's sessions (DESIGN.md §9, "History") -->
                        <MenuItem Header="History for this folder" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenHistoryForGroupCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="{Binding CollapseMenuText}" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).ToggleGroupCollapsedCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="Change color…" Click="OnChangeGroupColor" />
                        <Separator />
                        <MenuItem Header="Close group" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseGroupCommand}" CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Tabs}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:TabViewModel">
                        <Button Classes="tab" Classes.selected="{Binding IsSelected}" Classes.bypass="{Binding IsBypassMode}"
                                Width="38" Height="34" Padding="0" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}"
                                ToolTip.ShowDelay="300" ToolTip.Placement="Right" AutomationProperties.Name="{Binding DisplayName}">
                          <ToolTip.Tip>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InfoCard}" />
                          </ToolTip.Tip>
                          <Panel>
                            <TextBlock Text="{Binding DisplayName, Converter={x:Static vm:Converters.Initial}}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Classes="status small" Classes.busy="{Binding IsBusyStatus}" Classes.alert="{Binding IsAlertStatus}"
                                       Classes.failed="{Binding IsErrorStatus}" Classes.unread="{Binding IsUnread}"
                                       Text="{Binding StatusGlyph}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,4,0" />
                            <!-- The user's own mark (DESIGN.md §4, "Marks"), or the reviewed icon over it, in the corner across
                                 from the status icon -->
                            <views:MarkIcon x:Name="RailMark" Mark="{Binding Mark}" IsReviewed="{Binding AllFilesReviewed}" Width="8" Height="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" AutomationProperties.Name="{Binding MarkTip}" />
                          </Panel>
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" />
                              <MenuItem Header="{Binding PinMenuText}" Command="{Binding TogglePinCommand}" />
                              <MenuItem Header="Mark" ItemsSource="{Binding MarkMenu}" ItemContainerTheme="{StaticResource MarkMenuItemTheme}"
                                        ItemTemplate="{StaticResource MarkMenuItemTemplate}" />
                              <MenuItem Header="Clear mark" Command="{Binding ClearMarkCommand}" IsVisible="{Binding HasMark}" />
                              <MenuItem Header="Sync to other machines" ToggleType="CheckBox" IsChecked="{Binding SyncToLibrary, Mode=OneWay}"
                                        Command="{Binding ToggleSyncToLibraryCommand}" />
                              <MenuItem Header="Sync now" Command="{Binding SyncNowCommand}" IsVisible="{Binding SyncToLibrary}"
                                        ToolTip.Tip="{Binding SyncNowTip}" ToolTip.ShowOnDisabled="True" />
                              <MenuItem Header="Connect to the Claude app" ToggleType="CheckBox" IsChecked="{Binding RemoteControl.IsOn, Mode=OneWay}"
                                        Command="{Binding RemoteControl.ToggleCommand}" ToolTip.Tip="{Binding RemoteControl.ToggleTip}" ToolTip.ShowOnDisabled="True" />
                              <MenuItem Header="Open in the Claude app" Command="{Binding RemoteControl.OpenInClaudeAppCommand}" IsVisible="{Binding RemoteControl.HasUrl}" />
                              <MenuItem Header="Tab settings…" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenTabSettingsCommand}" CommandParameter="{Binding}">
                                  <MenuItem.Icon>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentStatusBrush}" IsVisible="{Binding HasOverrides}"
                                             ToolTip.Tip="This tab has its own settings" />
                                  </MenuItem.Icon>
                                </MenuItem>
                              <MenuItem Header="Duplicate tab" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).DuplicateTabCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="A new tab that carries this session on as a copy" />
                              <!-- Threads (DESIGN.md §18): a tab whose Claude hands work to others in its group -->
                              <MenuItem Header="Thread">
                                <MenuItem Header="Make this tab a thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).MakeThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanMakeThread}"
                                          ToolTip.Tip="Its Claude can hand work to other tabs in this folder, its sub-threads, and gets their results back" />
                                <MenuItem Header="New sub-thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewSubThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsThread}" />
                                <MenuItem Header="New sub-thread in a worktree" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).NewSubThreadInWorktreeCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsThread}" />
                                <MenuItem Header="Assign to thread" ItemsSource="{Binding AssignableThreads}" ItemContainerTheme="{StaticResource ThreadMenuItemTheme}" IsVisible="{Binding CanBeAssigned}" />
                                <MenuItem Header="Go to thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).GoToThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsSubThread}" />
                                <MenuItem Header="Detach from thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).DetachFromThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsSubThread}" />
                                <MenuItem Header="Ask before sending to sub-threads" ToggleType="CheckBox" IsChecked="{Binding AskBeforeSendingToSubThreads, Mode=OneWay}"
                                          Command="{Binding ToggleAskBeforeSendingToSubThreadsCommand}" IsVisible="{Binding IsThread}" />
                                <MenuItem Header="Stop being a thread" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).StopBeingThreadCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsThread}"
                                          ToolTip.Tip="Its sub-threads carry on as ordinary tabs" />
                              </MenuItem>

                              <MenuItem Header="Export conversation…" Command="{Binding ExportConversationCommand}"
                                        ToolTip.Tip="Save the conversation as a Markdown file or a web page" />
                              <MenuItem Header="Copy session ID" Command="{Binding CopySessionIdCommand}" IsVisible="{Binding HasSessionId}"
                                        ToolTip.Tip="What claude --resume takes" />
                              <!-- Started without the folder's own configuration (DESIGN.md §7, "Folder trust") -->
                              <MenuItem Header="Trust this folder" Command="{Binding TrustFolderCommand}" IsVisible="{Binding IsWithoutFolderSettings}"
                                        ToolTip.Tip="Start Claude Code again with this folder's own settings, MCP servers and CLAUDE.md" />
                              <Separator />
                              <MenuItem Header="Close" Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- The selected tab's project, History, the Claude Code update badge (DESIGN.md §12) and Settings -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="6">
          <StackPanel Spacing="2">
            <!-- The selected tab's project tools and links (DESIGN.md §18, "Project tools"): the project's name and version,
                 else the folder's name, or while a job runs, its name; a click opens the project's menu -->
            <Button x:Name="ProjectButton" Classes="flat side" HorizontalContentAlignment="Stretch"
                    IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{Binding SelectedTab.ProjectTools.ButtonTip}" ToolTip.Placement="Right" AutomationProperties.Name="Project tools">
              <DockPanel>
                <!-- As wide as the other icons, so the busy dot lines up with them -->
                <Panel DockPanel.Dock="Left" Width="13" VerticalAlignment="Center">
                  <Path Classes="icon" Data="{StaticResource IconProject}" IsVisible="{Binding !SelectedTab.ProjectTools.Runs.IsJobRunning, FallbackValue=True}" />
                  <TextBlock Classes="status busy" Text="●" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding SelectedTab.ProjectTools.Runs.IsJobRunning, FallbackValue=False}" />
                </Panel>
                <Path DockPanel.Dock="Right" Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="9" Height="9"
                      Stretch="Uniform" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding Layout.IsSidebarExpanded}" />
                <TextBlock Margin="10,0,0,0" Text="{Binding SelectedTab.ProjectTools.ButtonText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Layout.IsSidebarExpanded}" />
              </DockPanel>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom" Opened="OnProjectMenuOpened">
                  <StackPanel x:Name="ProjectMenu" MinWidth="300" MaxWidth="440" Spacing="1" DataContext="{Binding SelectedTab}" x:DataType="vm:TabViewModel">
                    <TextBlock Text="{Binding ProjectTools.HeaderTitle}" FontWeight="SemiBold" Margin="8,2,8,0" />
                    <ItemsControl ItemsSource="{Binding ProjectTools.HeaderLines}" Margin="8,0,8,2">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="muted small" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Entries of claudette.json that were skipped, and why (DESIGN.md §18) -->
                    <ItemsControl ItemsSource="{Binding ProjectTools.FileProblems}" Margin="8,0,8,2" IsVisible="{Binding ProjectTools.HasFileProblems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="small warning" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,2" />
                    <ItemsControl ItemsSource="{Binding ProjectTools.Menu}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ProjectMenuEntry">
                          <Panel>
                            <Separator Margin="0,3" IsVisible="{Binding IsSeparator}" />
                            <TextBlock Classes="muted small" Text="{Binding Label}" Margin="8,4,8,1" IsVisible="{Binding IsHeader}" />
                            <Button Classes="flat row" IsVisible="{Binding IsButton}" IsEnabled="{Binding IsEnabled}" HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True" Click="OnProjectMenuItemPicked"
                                    Command="{Binding Command}" CommandParameter="{Binding Parameter}">
                              <Grid ColumnDefinitions="16,*">
                                <TextBlock Classes="small" Text="{Binding Mark}" VerticalAlignment="Center" IsVisible="{Binding HasMark}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" />
                              </Grid>
                            </Button>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="flat side" Command="{Binding OpenHistoryCommand}" ToolTip.Tip="{Binding Tips.History}" ToolTip.Placement="Right" AutomationProperties.Name="History">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconHistory}" />
                <TextBlock Text="History" VerticalAlignment="Center" IsVisible="{Binding Layout.IsSidebarExpanded}" />
              </StackPanel>
            </Button>
            <!-- "Claude Code 2.1.290 is ready" (DESIGN.md §12, "Applying it"): small and non-blocking -->
            <Button x:Name="UpdateBadge" Classes="flat side update" DataContext="{Binding Updates}" x:DataType="vm:ClaudeUpdateViewModel"
                    IsVisible="{Binding HasBadge, FallbackValue=False}" ToolTip.Tip="{Binding BadgeText}" ToolTip.Placement="Right"
                    AutomationProperties.Name="Claude Code update">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconUpdate}" />
                <TextBlock Classes="badge" Text="{Binding BadgeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Layout.IsSidebarExpanded, FallbackValue=False}" />
              </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="RightEdgeAlignedBottom">
                    <StackPanel Spacing="10" Width="420" Margin="4">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
                      <Button Classes="flat" Content="What's new in Claude Code" Command="{Binding OpenChangelogCommand}" HorizontalAlignment="Left" Padding="0,2" />
                      <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                      <StackPanel Spacing="4" IsVisible="{Binding HasManualCommand}">
                        <TextBlock Classes="small" Text="Run this in a terminal to update:" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="8,6">
                            <SelectableTextBlock Text="{Binding ManualCommand}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" />
                          </Border>
                          <Button Grid.Column="1" Content="Copy" Command="{Binding CopyManualCommandCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                      <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Classes="accent" Content="Update now" Command="{Binding UpdateNowCommand}" IsVisible="{Binding CanUpdateNow}" />
                        <Button Classes="accent" Content="Update on next launch" Command="{Binding UpdateOnNextLaunchCommand}"
                                IsVisible="{Binding CanUpdateOnNextLaunch}" IsEnabled="{Binding !IsUpdateScheduled}" />
                        <Button Content="Don't update on next launch" Command="{Binding CancelUpdateOnNextLaunchCommand}" IsVisible="{Binding IsUpdateScheduled}" />
                        <Button Classes="flat" Content="Dismiss" Command="{Binding DismissCommand}" />
                      </WrapPanel>
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                      <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="8,6" MaxHeight="180" IsVisible="{Binding HasOutput}">
                        <ScrollViewer>
                          <SelectableTextBlock Text="{Binding Output}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                      </Border>
                      <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
            </Button>
            <!-- A new build of Claudette itself, when it runs from a source build (DESIGN.md §9, "Working on Claudette") -->
            <Button x:Name="NewBuildBadge" Classes="flat side update" DataContext="{Binding NewBuild}" x:DataType="vm:NewBuildViewModel"
                    IsVisible="{Binding HasBadge, FallbackValue=False}" ToolTip.Tip="{Binding BadgeText}" ToolTip.Placement="Right"
                    AutomationProperties.Name="New build of Claudette">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconRestart}" />
                <TextBlock Classes="badge" Text="{Binding BadgeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Layout.IsSidebarExpanded, FallbackValue=False}" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <StackPanel Spacing="10" Width="420" Margin="4">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding RunningText}" TextWrapping="Wrap" />
                    <TextBlock Classes="warning" Text="{Binding WorkingText}" TextWrapping="Wrap"
                               IsVisible="{Binding WorkingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Background="{DynamicResource CautionBackgroundBrush}" BorderBrush="{DynamicResource CautionBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" MaxHeight="220" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <ScrollViewer>
                        <SelectableTextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12" />
                      </ScrollViewer>
                    </Border>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button Classes="accent" Content="Restart now" Command="{Binding RestartNowCommand}" IsVisible="{Binding CanRestart}" />
                      <Button Content="Restart when idle" Command="{Binding RestartWhenIdleCommand}" IsVisible="{Binding CanRestartWhenIdle}" />
                      <Button Content="Don't restart" Command="{Binding CancelWaitingCommand}" IsVisible="{Binding IsWaitingForIdle}" />
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding RestartAutomatically}" Content="Restart into new builds by itself when no tab is working" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRestarting}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- A new release of Claudette (DESIGN.md §2, "Updating Claudette"): small and non-blocking, like Claude Code's -->
            <Button x:Name="AppUpdateBadge" Classes="flat side update" DataContext="{Binding AppUpdate}" x:DataType="vm:AppUpdateViewModel"
                    IsVisible="{Binding HasBadge, FallbackValue=False}" ToolTip.Tip="{Binding BadgeText}" ToolTip.Placement="Right"
                    AutomationProperties.Name="Claudette update">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconUpdate}" />
                <TextBlock Classes="badge" Text="{Binding BadgeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).Layout.IsSidebarExpanded, FallbackValue=False}" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <StackPanel Spacing="10" Width="420" Margin="4">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding CurrentVersionText}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding ReleasedText}" TextWrapping="Wrap"
                               IsVisible="{Binding ReleasedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="8,6" MaxHeight="220" IsVisible="{Binding HasNotes}">
                      <ScrollViewer>
                        <SelectableTextBlock Text="{Binding NotesText}" TextWrapping="Wrap" FontSize="12" />
                      </ScrollViewer>
                    </Border>
                    <Button Classes="flat" Content="Release notes on GitHub" Command="{Binding OpenReleasePageCommand}" HorizontalAlignment="Left" Padding="0,2"
                            IsVisible="{Binding HasRelease}" />
                    <TextBlock Classes="muted small" Text="{Binding ManualText}" TextWrapping="Wrap" IsVisible="{Binding HasManualText}" />
                    <TextBlock Classes="warning" Text="{Binding WorkingText}" TextWrapping="Wrap"
                               IsVisible="{Binding WorkingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border Background="{DynamicResource CautionBackgroundBrush}" BorderBrush="{DynamicResource CautionBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" MaxHeight="160" IsVisible="{Binding HasError}">
                      <ScrollViewer>
                        <SelectableTextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12" />
                      </ScrollViewer>
                    </Border>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button Classes="accent" Content="{Binding RestartLabel}" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding CanRestartToUpdate}" />
                      <Button Content="Update when idle" Command="{Binding UpdateWhenIdleCommand}" IsVisible="{Binding CanUpdateWhenIdle}" />
                      <Button Content="Don't update" Command="{Binding CancelWaitingCommand}" IsVisible="{Binding IsWaitingForIdle}" />
                      <Button Content="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
                      <Button Content="Cancel download" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
                      <Button Content="{Binding OpenPackageLabel}" Command="{Binding OpenPackageCommand}" IsVisible="{Binding CanOpenPackage}" />
                      <Button Classes="flat" Content="Skip this version" Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}" />
                    </WrapPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsVisible="{Binding IsDownloading}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInstalling}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="flat side" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{Binding Tips.Settings}" ToolTip.Placement="Right" AutomationProperties.Name="Settings">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconSettings}" />
                <TextBlock Text="Settings" VerticalAlignment="Center" IsVisible="{Binding Layout.IsSidebarExpanded}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Drag the sidebar's edge to resize it; double-click for the default width. -->
    <Border x:Name="SidebarEdge" Grid.Column="0" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" Background="Transparent"
            Cursor="SizeWestEast" ZIndex="1" IsVisible="{Binding Layout.IsSidebarExpanded}" />

    <!-- Tabs: one view per tab, kept alive while hidden -->
    <ItemsControl Grid.Column="1" ItemsSource="{Binding OpenTabs}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:TabViewModel">
          <views:TabView IsVisible="{Binding IsSelected}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- No tabs -->
    <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasTabs}">
      <TextBlock Classes="title" Text="Start a Claude Code session" HorizontalAlignment="Center" />
      <TextBlock Classes="muted" Text="Pick the folder Claude should work in." HorizontalAlignment="Center" />
      <Button Classes="accent" Content="New tab…" HorizontalAlignment="Center" Command="{Binding NewTabCommand}" />
    </StackPanel>

    <!-- New tab picker (DESIGN.md §4, "Opening a tab") -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding IsPickerOpen}" PointerPressed="OnOverlayPressed">
      <ContentControl Content="{Binding Picker}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:NewTabPickerViewModel">
            <views:NewTabPickerView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- Command palette (DESIGN.md §4, "Command palette") -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding IsPaletteOpen}" PointerPressed="OnPaletteOverlayPressed">
      <ContentControl Content="{Binding Palette}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:CommandPaletteViewModel">
            <views:CommandPaletteView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- History (DESIGN.md §9) -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding IsHistoryOpen}" PointerPressed="OnHistoryOverlayPressed">
      <ContentControl Content="{Binding History}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,20">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:HistoryViewModel">
            <views:HistoryView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- Tab settings (per-tab overrides) -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding HasTabSettings}">
      <ContentControl Content="{Binding TabSettings}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:TabSettingsViewModel">
            <views:TabSettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <!-- Confirmation -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding HasConfirmation}">
      <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" DataContext="{Binding Confirmation}">
        <StackPanel Spacing="14" x:DataType="vm:ConfirmationViewModel">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding HasCancel}" />
            <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondary}" />
            <Button Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <!-- Announcements for screen readers (DESIGN.md §3, "Accessibility"): read out, never seen. -->
    <TextBlock x:Name="Announcer" Grid.ColumnSpan="2" Text="{Binding Announcement}" Opacity="0" IsHitTestVisible="False"
               Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
               AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Announcement}" />
  </Grid>
</UserControl>
