<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.TabSettingsView"
             x:DataType="vm:TabSettingsViewModel">
  <Border Classes="dialog" Width="480">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="These replace the defaults from Settings for this tab only, and are saved with the tab." />

      <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="Model" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}" />
        <TextBlock Grid.Row="1" Text="Effort" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding EffortChoices}" SelectedItem="{Binding SelectedEffort}" />
        <TextBlock Grid.Row="2" Text="Permission mode" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedMode}" />
        <TextBlock Grid.Row="3" Text="Process monitor" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding MonitorChoices}" SelectedItem="{Binding SelectedMonitor}"
                  ToolTip.Tip="The processes this tab starts, with their CPU and memory, in the composer bar and the side panel" />
      </Grid>

      <CheckBox Content="Use different check-in settings for this tab" IsChecked="{Binding UseCustomCheckIns}" />
      <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" IsVisible="{Binding UseCustomCheckIns}">
        <TextBlock Text="Check-ins" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" Content="On" IsChecked="{Binding CheckInsEnabled}" />
        <TextBlock Grid.Row="1" Text="Run time (min)" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="600" Increment="1" FormatString="0" Value="{Binding RunTimeMinutes}" />
        <TextBlock Grid.Row="2" Text="Quiet time (min)" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="600" Increment="1" FormatString="0" Value="{Binding QuietTimeMinutes}" />
        <TextBlock Grid.Row="3" Text="Message" VerticalAlignment="Top" Margin="0,6,0,0" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CheckInMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
        <CheckBox Grid.Row="4" Grid.Column="1" Content="Notify me when a check-in is sent" IsChecked="{Binding NotifyOnCheckIn}" />
      </Grid>

      <!-- The session library (DESIGN.md §9): the tab's own choice, not an override, so Use defaults leaves it -->
      <CheckBox Content="Sync to other machines" IsChecked="{Binding SyncToLibrary}" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                 Text="Copies this session to the session library after each turn, so another machine can open it from History." />

      <!-- The folder's custom project actions, in its claudette.json files (DESIGN.md §18, "Custom actions"); saved with Apply -->
      <TextBlock Text="Project actions" FontWeight="SemiBold" Margin="0,4,0,0" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ProjectActionFiles}" SelectedItem="{Binding SelectedProjectActionFile}"
                AutomationProperties.Name="Project actions file" />
      <TextBlock Classes="muted small" Text="{Binding ProjectActionsNote}" TextWrapping="Wrap" Margin="0,-4,0,0" />
      <TextBlock Classes="small error" Text="{Binding ProjectActionFileError}" TextWrapping="Wrap" IsVisible="{Binding !CanEditProjectActionFile}" />
      <ListBox ItemsSource="{Binding ProjectActions}" SelectedItem="{Binding SelectedProjectAction}" MaxHeight="130"
               IsVisible="{Binding ProjectActions.Count}" AutomationProperties.Name="Project actions">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CustomActionRow">
            <StackPanel>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted small mono" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel ItemSpacing="6" LineSpacing="6">
        <Button Content="Add…" Command="{Binding AddProjectActionCommand}" />
        <Button Content="Edit…" Command="{Binding EditProjectActionCommand}" />
        <Button Content="Remove" Command="{Binding RemoveProjectActionCommand}" />
        <Button Content="Move up" Command="{Binding MoveProjectActionUpCommand}" />
        <Button Content="Move down" Command="{Binding MoveProjectActionDownCommand}" />
        <Button Content="Open file" Command="{Binding OpenProjectActionFileCommand}" ToolTip.Tip="Open the file in your editor, for links and anything else" />
      </WrapPanel>

      <Grid ColumnDefinitions="*,Auto">
        <Button Content="Use defaults" Command="{Binding UseDefaultsCommand}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Classes="accent" Content="Apply" Command="{Binding ApplyCommand}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
