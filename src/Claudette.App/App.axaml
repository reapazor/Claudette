<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:views="using:Claudette.App.Views"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Claudette.App.App"
             Name="Claudette"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS light/dark setting (DESIGN.md §2); Settings → Appearance can force one. -->

  <Application.DataTemplates>
    <DataTemplate DataType="vm:BusyViewModel">
      <views:BusyView />
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="vm:SignInViewModel">
      <views:SignInView />
    </DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel">
      <views:ShellView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- LiveMarkdown brings its own fonts (Arial for text, Consolas for code); use the conversation's and code's from
         Settings → Appearance instead. Later styles win, so these follow the include. -->
    <Style Selector="md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource ConversationFont}" />
    </Style>
    <Style Selector="md|CodeBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <Style Selector="md|CodeBlock md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <Style Selector="md|CodeInline">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="MaxWidth" Value="520" />
    </Style>

    <!-- :is() so the classes also apply to SelectableTextBlock. -->
    <Style Selector=":is(TextBlock).title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
    </Style>
    <Style Selector=":is(TextBlock).warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).ok">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).added">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).removed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>

    <!-- Flat buttons: rows, chips and toolbar items that only show a background on hover. -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- Tabs: rows in the sidebar (DESIGN.md §4) -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- A row's close button shows on hover and on the selected tab, so the list stays quiet and names get the room. -->
    <Style Selector="Button.tab Button.closetab">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.tab:pointerover Button.closetab, Button.tab.selected Button.closetab">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
    </Style>
    <!-- A tab in Bypass permissions mode stands out (DESIGN.md §7). -->
    <Style Selector="Button.tab.bypass /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BypassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Status dots and glyphs -->
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.busy">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.status.alert">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.status.failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.unread">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Composer box -->
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource ComposerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComposerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6,6,6" />
    </Style>
    <Style Selector="Border.composer.bypass">
      <Setter Property="BorderBrush" Value="{DynamicResource BypassBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.composer TextBox, Border.composer TextBox:focus, Border.composer TextBox:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:focus /template/ Border#PART_BorderElement, Border.composer TextBox:pointerover /template/ Border#PART_BorderElement, Border.composer TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Overlays -->
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 8 32 0 #40000000" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Updated from Settings → Appearance. -->
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
      <FontFamily x:Key="ConversationFont">$Default</FontFamily>
      <!-- The page's background: none, except under Mica (MainWindow sets it then). -->
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="Transparent" />
      <!-- Updated from Settings → Appearance. -->
      <x:Double x:Key="ConversationFontSize">14</x:Double>
      <x:Double x:Key="CodeFontSize">13</x:Double>

      <!-- Small vector icons, so they look the same on every platform. -->
      <StreamGeometry x:Key="IconClose">M2,2 L10,10 M10,2 L2,10</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M6,1 L6,11 M1,6 L11,6</StreamGeometry>
      <StreamGeometry x:Key="IconPin">M4,1 L8,1 L8,5 L10,7 L6.5,7 L6,11 L5.5,7 L2,7 L4,5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M1,3 L11,3 M1,9 L11,9 M4,1 L4,5 M8,7 L8,11</StreamGeometry>
      <StreamGeometry x:Key="IconHistory">M6,1 A5,5 0 1 1 1.67,3.5 M1.2,1.2 L1.67,3.5 L4,3.2 M6,3.5 L6,6 L8,7.2</StreamGeometry>
      <StreamGeometry x:Key="IconSidebar">M1.5,2 L10.5,2 L10.5,10 L1.5,10 Z M4.5,2 L4.5,10</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M3,4.5 L6,7.5 L9,4.5</StreamGeometry>
      <StreamGeometry x:Key="IconChevronRight">M4.5,3 L7.5,6 L4.5,9</StreamGeometry>
      <StreamGeometry x:Key="IconUpdate">M6,10.5 L6,2 M2.5,5.5 L6,2 L9.5,5.5</StreamGeometry>
      <StreamGeometry x:Key="IconRestart">M10.5,6 A4.5,4.5 0 1 1 9.18,2.82 M9.4,0.6 L9.18,2.82 L6.96,2.6</StreamGeometry>

      <!-- Claudette's color tokens, per theme. Views use only these, never Fluent's internal resource names. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- With Mica on Windows 11 (MainWindow): the page stays opaque and the sidebar lets the backdrop through. -->
          <SolidColorBrush x:Key="MicaPageBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaSidebarBrush" Color="#66F3F3F3" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6368" />
          <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="CardBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="ToolCardBrush" Color="#F3F3F5" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#F4F4F6" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#F0F0F2" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComposerBorderBrush" Color="#2A000000" />
          <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#33000000" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="OkTextBrush" Color="#107C10" />
          <SolidColorBrush x:Key="AccentStatusBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="CautionBorderBrush" Color="#D9A400" />
          <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FFF6D6" />
          <SolidColorBrush x:Key="DiffAddedBrush" Color="#E6F4EA" />
          <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FCE8E6" />
          <SolidColorBrush x:Key="DiffHunkBrush" Color="#EEF1F8" />
          <SolidColorBrush x:Key="UserBoxBrush" Color="#F4F4F6" />
          <SolidColorBrush x:Key="UserBoxBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="SubagentLineBrush" Color="#33000000" />
          <SolidColorBrush x:Key="BypassBorderBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MeterBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="MeterWarningBrush" Color="#D98A00" />
          <SolidColorBrush x:Key="MeterCriticalBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MicaPageBrush" Color="#202020" />
          <SolidColorBrush x:Key="MicaSidebarBrush" Color="#66141416" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A6A6" />
          <SolidColorBrush x:Key="DividerBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="CardBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="ToolCardBrush" Color="#1A1A1C" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#1C1C1F" />
          <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="TabSelectedBrush" Color="#2B2B2F" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#141416" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#1C1C1F" />
          <SolidColorBrush x:Key="ComposerBorderBrush" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="DialogBrush" Color="#202023" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="OkTextBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="AccentStatusBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="CautionBorderBrush" Color="#8A6D00" />
          <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#2B2610" />
          <SolidColorBrush x:Key="DiffAddedBrush" Color="#1D3B26" />
          <SolidColorBrush x:Key="DiffRemovedBrush" Color="#46201F" />
          <SolidColorBrush x:Key="DiffHunkBrush" Color="#23283A" />
          <SolidColorBrush x:Key="UserBoxBrush" Color="#1E1E22" />
          <SolidColorBrush x:Key="UserBoxBorderBrush" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="SubagentLineBrush" Color="#40FFFFFF" />
          <SolidColorBrush x:Key="BypassBorderBrush" Color="#E0605A" />
          <SolidColorBrush x:Key="MeterTrackBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="MeterBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="MeterWarningBrush" Color="#F2B233" />
          <SolidColorBrush x:Key="MeterCriticalBrush" Color="#FF6B61" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
