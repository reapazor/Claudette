<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Claudette.App.ViewModels"
        xmlns:controls="using:Claudette.App.Controls"
        x:Class="Claudette.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Claudette"
        Icon="/Assets/claudette.ico"
        Width="1100" Height="800"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="ProgressBar.meter">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MeterBrush}" />
    </Style>
    <Style Selector="ProgressBar.meter.warning">
      <Setter Property="Foreground" Value="{DynamicResource MeterWarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.meter.critical">
      <Setter Property="Foreground" Value="{DynamicResource MeterCriticalBrush}" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </Window.Styles>

  <Grid>
    <DockPanel>
      <!-- Header: usage meters (DESIGN.md §6) and the account -->
      <Border DockPanel.Dock="Top" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Claudette" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"
                     IsVisible="{Binding !HasUsage}" />

          <!-- Click anywhere on the meters for the Usage panel -->
          <Button Classes="header" IsVisible="{Binding HasUsage}" Command="{Binding Usage.OpenPanelCommand}"
                  ToolTip.Tip="Usage details (click)" AutomationProperties.Name="Usage details">
            <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14">
              <!-- Session, the most prominent -->
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Usage.Session.Tooltip}">
                <TextBlock Text="Session" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressBar Classes="meter" Width="160" Value="{Binding Usage.Session.Percent}"
                             Classes.warning="{Binding Usage.Session.IsWarning}" Classes.critical="{Binding Usage.Session.IsCritical}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Usage.Session.PercentText}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Classes.warning="{Binding Usage.Session.IsWarning}" Classes.error="{Binding Usage.Session.IsCritical}" />
                <TextBlock Classes="muted small" Text="{Binding Usage.Session.ResetText}" VerticalAlignment="Center" />
              </StackPanel>
              <controls:UsageChart Grid.Row="0" Grid.Column="1" Width="120" Height="22" VerticalAlignment="Center"
                                   Points="{Binding Usage.SessionPoints}" Projection="{Binding Usage.SessionProjection}"
                                   RangeStart="{Binding Usage.WindowStart}" RangeEnd="{Binding Usage.WindowEnd}"
                                   WarnLevel="{Binding Usage.WarnPercent}" CriticalLevel="{Binding Usage.CriticalPercent}"
                                   LineBrush="{DynamicResource MeterBrush}" ProjectionBrush="{DynamicResource MutedTextBrush}"
                                   WarnBrush="{DynamicResource MeterWarningBrush}" CriticalBrush="{DynamicResource MeterCriticalBrush}" />

              <!-- Weekly limits, smaller -->
              <ItemsControl Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Usage.Weekly}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="14" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:MeterViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Tooltip}">
                      <TextBlock Classes="muted small" Text="{Binding Label}" VerticalAlignment="Center" />
                      <ProgressBar Classes="meter" Width="60" Value="{Binding Percent}"
                                   Classes.warning="{Binding IsWarning}" Classes.critical="{Binding IsCritical}" VerticalAlignment="Center" />
                      <TextBlock Classes="small" Text="{Binding PercentText}" VerticalAlignment="Center"
                                 Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsCritical}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- The plain-language projection -->
              <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                <TextBlock Classes="small muted" Classes.warning="{Binding Usage.IsProjectionWarning}" Text="{Binding Usage.ProjectionText}" />
                <TextBlock Classes="small muted" Text="{Binding Usage.AsOfText}" IsVisible="{Binding Usage.AsOfText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Grid>
          </Button>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="muted small" Text="{Binding UsageNote}" VerticalAlignment="Center"
                       IsVisible="{Binding UsageNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- The account menu (DESIGN.md §11): the email and plan from claude auth status, and Sign out -->
            <Button Classes="header" IsVisible="{Binding Account.Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="Your Claude Code account" AutomationProperties.Name="Account">
              <TextBlock Classes="muted" Text="{Binding Account.HeaderName}" VerticalAlignment="Center" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="10" Width="300" Margin="4" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
                    <StackPanel Spacing="2" IsVisible="{Binding IsSignedIn}">
                      <TextBlock Classes="muted small" Text="Signed in to Claude Code as" />
                      <TextBlock Text="{Binding Email, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap"
                                 IsVisible="{Binding Email, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Text="{Binding PlanText, FallbackValue=''}" TextWrapping="Wrap"
                                 IsVisible="{Binding PlanText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Classes="muted small" Text="{Binding Organization, FallbackValue=''}" TextWrapping="Wrap"
                                 IsVisible="{Binding Organization, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <TextBlock Text="Claude Code isn't signed in." IsVisible="{Binding IsSignedOut}" />
                    <TextBlock Classes="error small" Text="{Binding SignOutError}" TextWrapping="Wrap" IsVisible="{Binding HasSignOutError}" />
                    <Button Classes="flat" Content="{Binding BillingText}" Command="{Binding OpenBillingCommand}" IsVisible="{Binding HasBilling}"
                            ToolTip.Tip="{Binding BillingTip}" HorizontalAlignment="Left" Padding="0,2" />
                    <Button Content="Sign out…" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" HorizontalAlignment="Left" />
                    <Button Classes="accent" Content="Sign in" Command="{Binding BeginSignInCommand}" IsVisible="{Binding CanBeginSignIn}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- The plan beside the email opens billing in the browser (DESIGN.md §11) -->
            <Button Classes="header" Command="{Binding Account.OpenBillingCommand}" IsVisible="{Binding Account.HeaderPlan, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{Binding Account.BillingTip}" AutomationProperties.Name="Plan and billing">
              <TextBlock Classes="muted" Text="{Binding Account.HeaderPlan}" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Claude Code needs a sign-in mid-session (DESIGN.md §11): a banner across all tabs, which stay open -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding Account.NeedsSignIn}" Background="{DynamicResource CautionBackgroundBrush}"
              BorderBrush="{DynamicResource CautionBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
            <Run FontWeight="SemiBold" Text="Claude Code needs you to sign in." />
            <Run Text="Messages you send wait until you have." />
          </TextBlock>
          <Button Grid.Column="1" Classes="accent" Content="Sign in" Command="{Binding Account.BeginSignInCommand}" />
        </Grid>
      </Border>

      <!-- A usage alert, until OS notifications arrive (milestone 7) -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding Usage.HasAlert, FallbackValue=False}" Background="{DynamicResource CautionBackgroundBrush}"
              BorderBrush="{DynamicResource CautionBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
            <Run FontWeight="SemiBold" Text="{Binding Usage.Alert.Title, FallbackValue=''}" />
            <Run Text="{Binding Usage.Alert.Message, FallbackValue=''}" />
          </TextBlock>
          <Button Grid.Column="1" Classes="flat" Content="Dismiss" Command="{Binding Usage.DismissAlertCommand}" />
        </Grid>
      </Border>

      <ContentControl Content="{Binding CurrentPage}" Background="{DynamicResource PageBackgroundBrush}" />
    </DockPanel>

    <!-- The sign-in dialog the banner opens (DESIGN.md §11) -->
    <Border Classes="overlay" IsVisible="{Binding Account.HasSignIn}">
      <ContentControl Content="{Binding Account.SignIn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- Signing out asks first, because every tab stops working -->
    <Border Classes="overlay" IsVisible="{Binding Account.HasSignOutConfirmation}">
      <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" DataContext="{Binding Account.SignOutConfirmation}">
        <StackPanel Spacing="14" x:DataType="vm:ConfirmationViewModel">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
