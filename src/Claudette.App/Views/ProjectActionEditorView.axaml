<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.ProjectActionEditorView"
             x:DataType="vm:ProjectActionEditorViewModel">
  <!-- A custom project action (DESIGN.md §18, "Custom actions"), over Settings' Actions page -->
  <Border Classes="dialog" Width="460">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
      <TextBlock Text="Name" />
      <TextBox Text="{Binding Name}" PlaceholderText="for example: Run the game's tests" AutomationProperties.Name="Name" />
      <TextBlock Text="Command" Margin="0,4,0,0" />
      <TextBox Classes="mono" Text="{Binding Command}" PlaceholderText="{Binding CommandPlaceholder}" AutomationProperties.Name="Command" />
      <TextBlock Classes="muted small" Text="{Binding ShellText}" TextWrapping="Wrap" />
      <TextBlock Text="Working folder" Margin="0,4,0,0" />
      <TextBox Classes="mono" Text="{Binding WorkingFolder}" PlaceholderText="The tab's folder" AutomationProperties.Name="Working folder" />
      <TextBlock Classes="muted small" Text="{Binding Folder, StringFormat='Relative to {0}'}" TextWrapping="Wrap" />
      <StackPanel Spacing="4" IsVisible="{Binding AsksForFile}" Margin="0,4,0,0">
        <TextBlock Text="Save in" />
        <RadioButton GroupName="ProjectActionFile" Content="{Binding LocalText}" IsChecked="{Binding SaveToLocal}" />
        <RadioButton GroupName="ProjectActionFile" Content="{Binding SharedText}" IsChecked="{Binding SaveToShared}" />
        <TextBlock Classes="muted small" Text="{Binding FileNote}" TextWrapping="Wrap" />
      </StackPanel>
      <RadioButton GroupName="ProjectActionMode" Content="Run with output" IsChecked="{Binding RunWithOutput}" Margin="0,4,0,0" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-6,0,0"
                 Text="The output shows on the Project page, with Stop, and a notification says when it ends." />
      <RadioButton GroupName="ProjectActionMode" Content="Launch and forget" IsChecked="{Binding LaunchAndForget}" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-6,0,0"
                 Text="For programs that keep running on their own, such as an editor or a server." />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
