<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <!-- DESIGN.md §9, "History" -->
  <Border Classes="dialog" Width="760" MaxHeight="620" Padding="0">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Margin="16,14,16,8" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="History" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="flat" Content="Refresh" Command="{Binding RefreshCommand}" />
        </Grid>
        <TextBox x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="Search by title or prompt; Enter searches Claude's replies too" />
      </StackPanel>

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <StackPanel Spacing="12" Margin="8,0,8,4">
          <TextBlock Classes="muted" Margin="8" Text="Reading your sessions…" IsVisible="{Binding IsLoading}" />
          <TextBlock Classes="error" Margin="8" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="muted" Margin="8" Text="No sessions found." IsVisible="{Binding IsEmpty}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
            <Button Classes="flat" Content="Search Claude's replies too" Command="{Binding SearchRepliesCommand}"
                    IsVisible="{Binding !IsSearchingReplies}" ToolTip.Tip="Reads each session's transcript, so it takes a moment" />
            <TextBlock Classes="muted small" Text="{Binding ReplySearchText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{Binding HasReplySearchText}" />
          </StackPanel>
        </StackPanel>
        <!-- One list of folder headings and sessions, virtualized: only the rows on screen are built. -->
        <ScrollViewer Grid.Row="1" Padding="8,0,8,8">
          <ItemsControl x:Name="HistoryRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:HistoryHeading">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,12,8,2" ToolTip.Tip="{Binding Folder}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                  <TextBlock Classes="muted small" Text="{Binding Folder}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" MaxWidth="520" />
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="vm:HistoryEntry">
                <Button Classes="flat row" Padding="8,5" Margin="0,1"
                        Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Resume in a new tab">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding FirstPrompt}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasFirstPrompt}" />
                    <TextBlock Classes="small" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasMatchedReply}">
                      <Run Classes="muted" Text="Claude: " />
                      <Run Text="{Binding MatchedReply}" />
                    </TextBlock>
                    <TextBlock Classes="muted small" Text="{Binding Details}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Sessions from Claude Code on this machine (including the terminal) and from the session library." />
          <Button Grid.Column="1" Content="Close" Command="{Binding CloseCommand}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
