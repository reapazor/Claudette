<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:conv="using:Claudette.App.Conversation"
             xmlns:core="using:Claudette.Core.Sessions"
             xmlns:settings="using:Claudette.Core.Settings"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:controls="using:Claudette.App.Controls"
             xmlns:protocol="using:Claudette.Core.Protocol"
             xmlns:services="using:Claudette.App.Services"
             xmlns:views="using:Claudette.App.Views"
             xmlns:tools="using:Claudette.Core.ProjectTools"
             x:Class="Claudette.App.Views.TabView"
             x:DataType="vm:TabViewModel"
             FontSize="{DynamicResource ConversationFontSize}"
             FontFamily="{DynamicResource ConversationFont}">

  <UserControl.Resources>
    <!-- A message's time and Copy button (DESIGN.md §5, "Copy and times"): a small chip on its top-right corner, shown
         on hover and while it has keyboard focus. -->
    <DataTemplate x:Key="MessageTools" x:DataType="conv:MessageItem">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <TextBlock Classes="muted small" Background="Transparent" Text="{Binding TimeText}" ToolTip.Tip="{Binding TimeTip}" IsVisible="{Binding HasTime}"
                   VerticalAlignment="Center" Margin="6,0,2,0" />
        <Button Classes="flat" Padding="5,3" VerticalAlignment="Center" ToolTip.Tip="Copy message" AutomationProperties.Name="Copy message"
                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).CopyMessageCommand}" CommandParameter="{Binding}">
          <Panel>
            <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.1" StrokeJoin="Round"
                  Width="12" Height="12" Stretch="None" IsVisible="{Binding !IsCopied}" />
            <TextBlock Classes="muted small" Text="Copied" IsVisible="{Binding IsCopied}" />
          </Panel>
        </Button>
      </StackPanel>
    </DataTemplate>
    <!-- Where a waiting prompt stands among the tab's, with the way to the others (DESIGN.md §7, "Several prompts waiting"). -->
    <DataTemplate x:Key="PromptPosition" x:DataType="conv:PromptItem">
      <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasPosition}">
        <Button Classes="flat" Padding="5,1" Content="‹" AutomationProperties.Name="Previous waiting prompt" ToolTip.Tip="The waiting prompt before this one"
                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ShowPreviousWaitingPromptCommand}" CommandParameter="{Binding}" />
        <TextBlock Classes="muted small" Text="{Binding PositionText}" VerticalAlignment="Center" />
        <Button Classes="flat" Padding="5,1" Content="›" AutomationProperties.Name="Next waiting prompt" ToolTip.Tip="The waiting prompt after this one"
                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ShowNextWaitingPromptCommand}" CommandParameter="{Binding}" />
      </StackPanel>
    </DataTemplate>
    <!-- A message the user sent: its time and Copy, and a menu to go back to it (DESIGN.md §5, "Rewind and branch"). -->
    <DataTemplate x:Key="UserMessageTools" x:DataType="conv:UserMessageItem">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MessageTools}" />
        <Button x:Name="MessageMenuButton" Classes="flat" Padding="5,3" VerticalAlignment="Center" ToolTip.Tip="More" AutomationProperties.Name="More for this message">
          <Path Data="{StaticResource IconMore}" Fill="{DynamicResource MutedTextBrush}" Width="12" Height="12" Stretch="None" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Edit and resend…" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).EditAndResendCommand}" CommandParameter="{Binding}" />
              <MenuItem Header="Branch from here" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).BranchFromHereCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="A new tab that carries the conversation on from just before this message, which is in its composer" />
              <MenuItem Header="Restore files to before this…" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).RestoreFilesBeforeCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding CanRestoreFiles}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The chip with a message's time and Copy button: quiet until the message is hovered or focused. -->
    <Style Selector="ContentControl.messagetools">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,-10,4,0" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.message:pointerover > ContentControl.messagetools, Panel.message:focus-within > ContentControl.messagetools">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Settings → Appearance → Density (DESIGN.md §14): ShellView takes the "compact" class. -->
    <Style Selector="ItemsControl#ConversationItems">
      <Setter Property="Margin" Value="24,16,24,24" />
    </Style>
    <Style Selector=".compact ItemsControl#ConversationItems">
      <Setter Property="Margin" Value="20,10,20,14" />
    </Style>
    <!-- The conversation is virtualized (DESIGN.md §5): only the items in view have controls. The panel has no spacing
         of its own, so each item keeps its distance from the next. -->
    <Style Selector="ItemsControl#ConversationItems > ContentPresenter">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector=".compact ItemsControl#ConversationItems > ContentPresenter">
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <!-- A subagent group's items, the same: the panel has no spacing of its own. -->
    <Style Selector="ItemsControl.subagentitems > ContentPresenter">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector=".compact ItemsControl.subagentitems > ContentPresenter">
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <!-- Find in the conversation (DESIGN.md §5, "Find"): a bar over the conversation, and the match it shows marked. -->
    <Style Selector="Border.findbar">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,4" />
    </Style>
    <Style Selector="TextBox.findbox">
      <Setter Property="Width" Value="260" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="ItemsControl#ConversationItems > ContentPresenter.findcurrent">
      <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.usermessage">
      <Setter Property="Background" Value="{DynamicResource UserBoxBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource UserBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style Selector=".compact Border.usermessage">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,3,0,1" />
    </Style>
    <!-- Settings → Appearance → Style → Claude (DESIGN.md §3): your messages are bubbles on the right, as in the Claude
         apps, and Claude's replies run full width beside them. -->
    <Style Selector=".claude Border.usermessage">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="72,10,0,6" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector=".claude.compact Border.usermessage">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="72,4,0,2" />
    </Style>
    <Style Selector="StackPanel.toolcard">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector=".compact StackPanel.toolcard">
      <Setter Property="Spacing" Value="1" />
    </Style>
    <!-- Tool, thinking and subagent rows -->
    <Style Selector=".compact VirtualizingStackPanel.conversation Button.row">
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="StackPanel.composerarea">
      <Setter Property="Margin" Value="16,4,16,12" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector=".compact StackPanel.composerarea">
      <Setter Property="Margin" Value="12,2,12,6" />
      <Setter Property="Spacing" Value="3" />
    </Style>
    <Style Selector="TextBox#Composer">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="2,6" />
    </Style>
    <Style Selector=".compact TextBox#Composer">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="2,3" />
    </Style>

    <Style Selector="Border.diffline.added">
      <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
    </Style>
    <Style Selector="Border.diffline.removed">
      <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
    </Style>
    <Style Selector="Border.diffline.hunk">
      <Setter Property="Background" Value="{DynamicResource DiffHunkBrush}" />
    </Style>
    <Style Selector="Border.codeblock">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector=".compact Border.codeblock">
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector=".claude Border.codeblock">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBlock.done">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,2,4,2" />
    </Style>
    <Style Selector="Border.chip.kept">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- Prompts waiting on the user (DESIGN.md §7); quieter once answered. -->
    <Style Selector="Border.prompt">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource CautionBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
    </Style>
    <Style Selector=".compact Border.prompt">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector=".claude Border.prompt">
      <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- Send and Stop. In the Claude style they're round, with an arrow for Send, as in the Claude apps, and a drawn
         square for Stop: the ■ character sits off-center in a circle, by its font's ascent and descent. The icons fill
         the button and have no border, so nothing puts them off the middle (IconSendArrow in App.axaml says why). -->
    <Style Selector="Button.send">
      <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="Button.send Path.sendarrow, Button.stop Path.stopsquare">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".claude Button.send, .claude Button.stop">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=".claude Button.send TextBlock.sendlabel, .claude Button.stop TextBlock.stoplabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector=".claude Button.send Path.sendarrow, .claude Button.stop Path.stopsquare">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.prompt.question">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="Border.prompt.answered">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Tool card icons (DESIGN.md §5): 12×12 strokes from App.axaml, drawn as they are. -->
    <Style Selector="Path.toolicon">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Attached images (DESIGN.md §5, "Attachments") -->
    <Style Selector="Border.thumbnail">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.composer.dropping">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- The side panel's pages (DESIGN.md §3), as tabs over a divider: the page showing in full text with an accent line
         under it, over the divider, and the others muted. -->
    <Style Selector="Border.pagetabs">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="6,4,6,0" />
    </Style>
    <Style Selector="Button.pagetab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="4,4,0,0" />
      <Setter Property="Padding" Value="8,6,8,6" />
      <Setter Property="Margin" Value="0,0,0,-1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector=".compact Button.pagetab">
      <Setter Property="Padding" Value="8,3,8,4" />
    </Style>
    <Style Selector="Button.pagetab.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pagetab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.pagetab:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.pagetab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- Changed files (DESIGN.md §8, "Reviewed"): a small box before each file, and a reviewed file drawn faintly -->
    <Style Selector="CheckBox.reviewed">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.changedfile.reviewed > TextBlock, Grid.changedfile.reviewed > StackPanel">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- A project job's output (DESIGN.md §18): dense lines, like a terminal -->
    <Style Selector="ListBox#ProjectOutputList ListBoxItem">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- The running tasks list (DESIGN.md §5, "Running tasks"), under the chip in the composer bar -->
    <Style Selector="StackPanel.tasklist">
      <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector=".compact StackPanel.tasklist">
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="Button.taskrow">
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector=".compact Button.taskrow">
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector=".claude Button.taskrow">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <!-- The / and @ autocomplete (DESIGN.md §5, "Composer") -->
    <Style Selector="Button.completion.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Conversation templates (DESIGN.md §5). Declared on the control so nested subagent groups use them too. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="conv:UserMessageItem">
      <Panel Classes="message">
        <Border Classes="usermessage">
          <StackPanel Spacing="4">
            <TextBlock Classes="muted small" Text="{Binding AutomaticLabel}" IsVisible="{Binding AutomaticLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Attached images (DESIGN.md §5, "Attachments") -->
            <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="protocol:MessageImage">
                  <Border Classes="thumbnail">
                    <Image Source="{Binding Data, Converter={x:Static services:ImageFiles.Thumbnail}}" Height="72" MaxWidth="160" Stretch="UniformToFill"
                           AutomationProperties.Name="Attached image" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <SelectableTextBlock Classes="muted small" Text="{Binding SuffixText}" TextWrapping="Wrap" IsVisible="{Binding HasSuffix}" />
            <!-- Waiting its turn behind Claude's work (DESIGN.md §5, "Queued messages") -->
            <StackPanel Classes="queued" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsQueued}">
              <TextBlock Classes="muted small" Text="Queued: sent when Claude can take it" VerticalAlignment="Center" />
              <Button Classes="flat" Padding="0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).CancelQueuedMessageCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Takes the message back before Claude reads it, and puts it in the composer">
                <TextBlock Classes="small" Foreground="{DynamicResource AccentStatusBrush}" Text="Cancel" TextDecorations="Underline" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
        <ContentControl Classes="messagetools" Content="{Binding}" ContentTemplate="{StaticResource UserMessageTools}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="conv:AssistantTextItem">
      <Panel Classes="message">
        <md:MarkdownRenderer MarkdownBuilder="{Binding Markdown}"
                             LinkCommand="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).OpenLinkCommand}" />
        <ContentControl Classes="messagetools" Content="{Binding}" ContentTemplate="{StaticResource MessageTools}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="conv:ThinkingItem">
      <StackPanel Spacing="2">
        <Button Classes="flat row" Command="{Binding ToggleCommand}" IsHitTestVisible="{Binding HasText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted" Text="✻" />
            <TextBlock Classes="muted" FontStyle="Italic" Text="{Binding Header}" />
          </StackPanel>
        </Button>
        <SelectableTextBlock Classes="muted" FontStyle="Italic" TextWrapping="Wrap" Margin="22,0,0,4"
                             Text="{Binding ShownText}" IsVisible="{Binding IsExpanded}" />
      </StackPanel>
    </DataTemplate>

    <!-- Subagent: must come before ToolUseItem, which it derives from. -->
    <DataTemplate DataType="conv:SubagentItem">
      <StackPanel Spacing="2">
        <Button Classes="flat row" Command="{Binding ToggleCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="status" Classes.busy="{Binding !IsComplete}" Classes.ok="{Binding IsSucceeded}" Classes.failed="{Binding IsError}" Text="●" VerticalAlignment="Center" />
            <Path Classes="toolicon" Data="{Binding IconKey, Converter={x:Static conv:ToolIcons.Geometry}}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding AgentType}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border BorderBrush="{DynamicResource SubagentLineBrush}" BorderThickness="2,0,0,0" Margin="10,0,0,0" Padding="12,2,0,2"
                IsVisible="{Binding IsExpanded}">
          <StackPanel Spacing="6">
            <SelectableTextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" MaxHeight="120" IsVisible="{Binding HasDetail}" />
            <!-- Virtualized like the conversation: a collapsed group builds nothing, an open one only what's in view. -->
            <ItemsControl Classes="subagentitems" ItemsSource="{Binding Items}" ClipToBounds="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="conv:ToolUseItem">
      <StackPanel Classes="toolcard">
        <Grid ColumnDefinitions="*,Auto">
          <Button Classes="flat row" Command="{Binding ToggleCommand}" IsHitTestVisible="{Binding CanExpand}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
              <TextBlock Classes="status" Classes.busy="{Binding !IsComplete}" Classes.ok="{Binding IsComplete}" Classes.failed="{Binding IsError}"
                         Text="●" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Path Grid.Column="1" Classes="toolicon" Data="{Binding IconKey, Converter={x:Static conv:ToolIcons.Geometry}}" Margin="0,0,6,0" />
              <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding Summary}" MaxWidth="560" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding FullSummary}" />
              <TextBlock Grid.Column="5" Classes="mono small" Text="{Binding DiffStats}" IsVisible="{Binding HasDiff}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
          </Button>
          <!-- Edit / Write: the file in the diff view (DESIGN.md §5, §8) -->
          <Button Grid.Column="1" Classes="flat" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanOpenDiff}"
                  ToolTip.Tip="Open in the diff view" AutomationProperties.Name="Open in the diff view"
                  Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.OpenToolDiffCommand}" CommandParameter="{Binding}">
            <TextBlock Classes="muted small" Text="Open diff" />
          </Button>
        </Grid>
        <TextBlock Classes="muted small mono" Text="{Binding ResultSummary}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis"
                   Margin="22,0,0,0" IsVisible="{Binding HasResultSummary}" />

        <!-- Expanded -->
        <StackPanel Spacing="6" Margin="22,2,0,4" IsVisible="{Binding IsExpanded}">
          <Border Classes="codeblock" IsVisible="{Binding IsBash}">
            <SelectableTextBlock Classes="mono" Text="{Binding Command, StringFormat='$ {0}'}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="codeblock" IsVisible="{Binding HasDetail}">
            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Classes="mono small" Text="{Binding Detail}" />
            </ScrollViewer>
          </Border>
          <Border Classes="codeblock" Padding="0" IsVisible="{Binding HasDiff}">
            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Diff.Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Border Classes="codeblock" IsVisible="{Binding HasOutput}">
            <StackPanel Spacing="4">
              <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Classes="mono small" Text="{Binding ShownOutput}" />
              </ScrollViewer>
              <Button Classes="flat" HorizontalAlignment="Left" Content="{Binding ShowAllOutputText}" Command="{Binding ShowAllOutputCommand}" IsVisible="{Binding IsOutputCut}"
                      ToolTip.Tip="Only the start of this long output is shown, to keep the conversation quick" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="conv:DiffLine">
      <Border Classes="diffline" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.hunk="{Binding IsHunk}" Padding="6,0">
        <Grid ColumnDefinitions="36,36,14,*">
          <TextBlock Classes="mono muted small" Text="{Binding OldNumberText}" HorizontalAlignment="Right" Margin="0,0,6,0" />
          <TextBlock Grid.Column="1" Classes="mono muted small" Text="{Binding NewNumberText}" HorizontalAlignment="Right" Margin="0,0,6,0" />
          <TextBlock Grid.Column="2" Classes="mono" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Text="{Binding Marker}" />
          <SelectableTextBlock Grid.Column="3" Classes="mono" Text="{Binding Text}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Permission prompt (DESIGN.md §7) -->
    <DataTemplate DataType="conv:PermissionItem">
      <Border Classes="prompt" Classes.answered="{Binding !IsPending}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource PromptPosition}" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Classes="muted small" Text="{Binding Asker, StringFormat='Asked by the {0}'}" TextWrapping="Wrap" IsVisible="{Binding HasAsker}" />
          <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
          <Border Classes="codeblock" IsVisible="{Binding HasCommand}">
            <SelectableTextBlock Classes="mono" Text="{Binding Command, StringFormat='$ {0}'}" TextWrapping="Wrap" />
          </Border>
          <SelectableTextBlock Classes="mono" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
          <Border Classes="codeblock" Padding="0" IsVisible="{Binding HasDiff}">
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Diff.Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <TextBlock Classes="muted small" Text="{Binding Reason}" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />

          <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding IsPending}">
            <Button Classes="accent" Content="Allow" Command="{Binding AllowCommand}" ToolTip.Tip="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).Tips.Allow}" />
            <SplitButton Content="Always allow…" Command="{Binding StartAlwaysAllowCommand}" IsVisible="{Binding CanAlwaysAllow}"
                         ToolTip.Tip="Save an allow rule to this folder's .claude/settings.local.json">
              <SplitButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Allow for this session only" Command="{Binding AllowForSessionCommand}" />
                </MenuFlyout>
              </SplitButton.Flyout>
            </SplitButton>
            <Button Content="{Binding ModeAction}" Command="{Binding AllowWithModeCommand}" IsVisible="{Binding HasModeAction}" />
            <Button Content="Deny" Command="{Binding DenyCommand}" ToolTip.Tip="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).Tips.Deny}" />
            <Button Classes="flat" Content="Deny with a message…" Command="{Binding StartDenyWithMessageCommand}" VerticalAlignment="Center" />
          </WrapPanel>

          <!-- Always allow: the exact rule, editable before it's saved -->
          <StackPanel Spacing="6" IsVisible="{Binding IsEditingRule}">
            <TextBlock Classes="small" Text="Always allow calls that match this rule:" />
            <TextBox Classes="mono" Text="{Binding RuleText}" AutomationProperties.Name="Rule" />
            <TextBlock Classes="small error" Text="{Binding RuleError}" TextWrapping="Wrap" IsVisible="{Binding HasRuleError}" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Claude Code saves it to .claude/settings.local.json in this folder (your personal, uncommitted settings), so terminal sessions here use it too." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Save rule and allow" Command="{Binding SaveRuleCommand}" />
              <Button Content="Allow for this session only" Command="{Binding AllowForSessionCommand}" />
              <Button Classes="flat" Content="Cancel" Command="{Binding CancelAlwaysAllowCommand}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- Deny with a message -->
          <StackPanel Spacing="6" IsVisible="{Binding IsWritingDenyMessage}">
            <TextBox Text="{Binding DenyMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                     PlaceholderText="Tell Claude what to do instead (optional)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Deny" Command="{Binding SendDenyMessageCommand}" />
              <Button Classes="flat" Content="Cancel" Command="{Binding CancelDenyWithMessageCommand}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <TextBlock Classes="muted small" Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Clarifying questions (AskUserQuestion) -->
    <DataTemplate DataType="conv:QuestionItem">
      <Border Classes="prompt question" Classes.answered="{Binding !IsPending}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource PromptPosition}" VerticalAlignment="Top" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Questions}" IsEnabled="{Binding IsPending}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="conv:QuestionEntry">
                <StackPanel Spacing="4">
                  <TextBlock Classes="muted small" FontWeight="SemiBold" Text="{Binding Header}" IsVisible="{Binding HasHeader}" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted small" Text="{Binding Hint}" />
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="conv:QuestionOption">
                        <Panel>
                          <RadioButton GroupName="{Binding Group}" IsChecked="{Binding IsSelected}"
                                       IsVisible="{Binding !$parent[ItemsControl].((conv:QuestionEntry)DataContext).MultiSelect}">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                            </StackPanel>
                          </RadioButton>
                          <CheckBox IsChecked="{Binding IsSelected}"
                                    IsVisible="{Binding $parent[ItemsControl].((conv:QuestionEntry)DataContext).MultiSelect}">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                            </StackPanel>
                          </CheckBox>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Text="{Binding OtherText}" PlaceholderText="Other: type your own answer" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPending}">
            <Button Classes="accent" Content="Send answers" Command="{Binding SubmitCommand}" ToolTip.Tip="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).Tips.Allow}" />
            <Button Content="Dismiss" Command="{Binding DismissCommand}" ToolTip.Tip="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).Tips.Deny}" />
          </StackPanel>
          <TextBlock Classes="muted small" Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A plan to approve (ExitPlanMode) -->
    <DataTemplate DataType="conv:PlanItem">
      <Border Classes="prompt question" Classes.answered="{Binding !IsPending}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Claude's plan" FontWeight="SemiBold" />
            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource PromptPosition}" VerticalAlignment="Top" />
          </Grid>
          <md:MarkdownRenderer MarkdownBuilder="{Binding Plan}" IsVisible="{Binding HasPlan}"
                               LinkCommand="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).OpenLinkCommand}" />
          <TextBlock Classes="muted" Text="Claude has finished planning and is ready to start making changes." TextWrapping="Wrap" IsVisible="{Binding !HasPlan}" />
          <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding IsPending}">
            <Button Classes="accent" Content="Approve, accept edits" Command="{Binding ApproveAcceptingEditsCommand}"
                    ToolTip.Tip="Start working, and edit files without asking" />
            <Button Content="Approve, ask before edits" Command="{Binding ApproveAskingForEditsCommand}" ToolTip.Tip="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).Tips.Allow}" />
            <Button Content="Keep planning…" Command="{Binding StartFeedbackCommand}" />
          </WrapPanel>
          <StackPanel Spacing="6" IsVisible="{Binding IsWritingFeedback}">
            <TextBox Text="{Binding Feedback}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                     PlaceholderText="What should change in the plan? (optional)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Keep planning" Command="{Binding KeepPlanningCommand}" />
              <Button Classes="flat" Content="Cancel" Command="{Binding CancelFeedbackCommand}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted small" Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- An MCP server asking for input (DESIGN.md §7, "MCP servers asking for input") -->
    <DataTemplate DataType="conv:McpInputItem">
      <Border Classes="prompt question" Classes.answered="{Binding !IsPending}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <!-- A form, built from the server's schema -->
          <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding IsForm}" IsEnabled="{Binding IsPending}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="conv:McpField">
                <StackPanel Spacing="3">
                  <TextBlock Classes="small" FontWeight="SemiBold" Text="{Binding Heading}" IsVisible="{Binding !IsBoolean}" />
                  <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}" AutomationProperties.Name="{Binding Label}" />
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsVisible="{Binding IsBoolean}" />
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" IsVisible="{Binding IsChoice}" MinWidth="200"
                            AutomationProperties.Name="{Binding Label}" />
                  <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                  <TextBlock Classes="small error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- A link to finish in the browser, such as signing in -->
          <StackPanel Spacing="6" IsVisible="{Binding IsUrl}">
            <TextBlock Classes="muted small" Text="{Binding Url}" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasOpenedUrl}"
                       Text="Finish in the browser, then choose Done if this doesn't close by itself." />
          </StackPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding IsPending}">
            <Button Classes="accent" Content="Send" Command="{Binding SendCommand}" IsVisible="{Binding IsForm}" />
            <Button Classes="accent" Content="Open in browser" Command="{Binding OpenUrlCommand}" IsVisible="{Binding IsUrl}" />
            <Button Content="Done" Command="{Binding SendCommand}" IsVisible="{Binding HasOpenedUrl}" />
            <Button Content="Decline" Command="{Binding DeclineCommand}" />
            <Button Classes="flat" Content="Dismiss" Command="{Binding DismissCommand}" VerticalAlignment="Center" />
          </WrapPanel>
          <TextBlock Classes="muted small" Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A hook from the user's or project's settings ran (DESIGN.md §5, "Hook runs") -->
    <DataTemplate DataType="conv:HookRunItem">
      <StackPanel Spacing="2">
        <ToggleButton Classes="flat row" IsChecked="{Binding IsExpanded}" IsHitTestVisible="{Binding HasOutput}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="muted" Text="⚙" />
            <TextBlock Classes="muted small" Text="{Binding Title}" />
            <TextBlock Classes="muted small" Classes.error="{Binding IsFailed}" Text="{Binding StatusText}" />
          </StackPanel>
        </ToggleButton>
        <Border Classes="codeblock" IsVisible="{Binding IsExpanded}" Margin="20,0,0,0">
          <SelectableTextBlock Classes="mono" Text="{Binding Output}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="conv:NoteItem">
      <StackPanel Spacing="2">
        <SelectableTextBlock Classes="muted small" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding Text}"
                             Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" />
        <!-- Such as the tab's session in the Claude app (DESIGN.md §18, "Remote Control") -->
        <Button Classes="flat" Padding="0" HorizontalAlignment="Left" IsVisible="{Binding HasLink}" ToolTip.Tip="Open in your browser"
                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding Link}">
          <TextBlock Classes="small" Foreground="{DynamicResource AccentStatusBrush}" Text="{Binding Link}" TextWrapping="Wrap" TextDecorations="Underline" />
        </Button>
      </StackPanel>
    </DataTemplate>

    <!-- Skipped by Claudette, shown while protocol logging is on (DESIGN.md §16) -->
    <DataTemplate DataType="conv:UnsupportedMessageItem">
      <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Padding="8,4">
        <SelectableTextBlock Text="{Binding Json}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
      </Expander>
    </DataTemplate>

    <DataTemplate DataType="conv:TurnSummaryItem">
      <TextBlock Classes="muted small" Text="{Binding Text}" Opacity="0.8" Margin="0,0,0,4" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">

    <!-- Side panel (DESIGN.md §3): changed files, agents, the project's tools and, when the monitor is on, processes -->
    <Border x:Name="SidePanel" Grid.Column="1" Grid.RowSpan="2" Width="{Binding SidePanelWidth}" IsVisible="{Binding IsSidePanelOpen}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SubtleBrush}">
      <DockPanel>
        <!-- The pages, as tabs: the one showing in full text over an accent line, the others muted -->
        <Border DockPanel.Dock="Top" Classes="pagetabs">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button Classes="pagetab" Classes.selected="{Binding IsFilesPage}" Command="{Binding ShowFilesPageCommand}">
              <TextBlock Text="Changed Files" Classes.muted="{Binding !IsFilesPage}" />
            </Button>
            <!-- Agents (DESIGN.md §18); a busy dot while a subagent runs -->
            <Button Grid.Column="1" Classes="pagetab" Classes.selected="{Binding IsAgentsPage}" Command="{Binding ShowAgentsPageCommand}" ToolTip.Tip="{Binding AgentsHeader}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Agents" Classes.muted="{Binding !IsAgentsPage}" />
                <TextBlock Classes="status busy" Text="●" FontSize="8" VerticalAlignment="Center" IsVisible="{Binding HasActiveAgents}" />
              </StackPanel>
            </Button>
            <!-- Project tools (DESIGN.md §18); a busy dot while a job runs -->
            <Button Grid.Column="2" Classes="pagetab" Classes.selected="{Binding IsProjectPage}" Command="{Binding ShowProjectPageCommand}" IsVisible="{Binding ProjectTools.HasTools}" ToolTip.Tip="{Binding ProjectTools.HeaderTitle}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Project" Classes.muted="{Binding !IsProjectPage}" />
                <TextBlock Classes="status busy" Text="●" FontSize="8" VerticalAlignment="Center" IsVisible="{Binding ProjectTools.IsJobRunning}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="pagetab" Classes.selected="{Binding IsProcessesPage}" Command="{Binding ShowProcessesPageCommand}" IsVisible="{Binding ProcessMonitor.IsOn}">
              <TextBlock Text="Processes" Classes.muted="{Binding !IsProcessesPage}" />
            </Button>
            <!-- Tasks (DESIGN.md §5, "Tasks"): "2 of 5" done -->
            <Button Grid.Column="4" Classes="pagetab" Classes.selected="{Binding IsTasksPage}" Command="{Binding ShowTasksPageCommand}" IsVisible="{Binding TodoList.HasAnything}"
                    ToolTip.Tip="{Binding TodoList.Summary}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Tasks" Classes.muted="{Binding !IsTasksPage}" />
                <TextBlock Classes="muted small" Text="{Binding TodoList.Badge}" VerticalAlignment="Center" IsVisible="{Binding TodoList.HasItems}" />
              </StackPanel>
            </Button>
            <!-- MCP servers (DESIGN.md §4, "MCP servers"); a warning dot when one failed -->
            <Button Grid.Column="5" Classes="pagetab" Classes.selected="{Binding IsMcpPage}" Command="{Binding ShowMcpPageCommand}" IsVisible="{Binding HasMcpServers}"
                    ToolTip.Tip="{Binding McpServers.Attention, TargetNullValue='MCP servers'}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="MCP" Classes.muted="{Binding !IsMcpPage}" />
                <TextBlock Classes="status warning" Text="●" FontSize="8" VerticalAlignment="Center"
                           IsVisible="{Binding McpServers.Attention, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="7" Classes="flat" Padding="6" VerticalAlignment="Center" ToolTip.Tip="Close the side panel" AutomationProperties.Name="Close side panel" Command="{Binding ToggleSidePanelCommand}">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
            </Button>
          </Grid>
        </Border>

        <Panel Margin="0,8,0,0">
          <!-- Changed files (DESIGN.md §8) -->
          <DockPanel IsVisible="{Binding IsFilesPage}">
            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted small" Text="{Binding ChangedFiles.Summary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="flat" Command="{Binding ChangedFiles.RefreshCommand}">
                  <TextBlock Classes="small" Text="Refresh" />
                </Button>
              </Grid>
              <CheckBox IsChecked="{Binding ChangedFiles.ShowGitChanges}" IsVisible="{Binding ChangedFiles.IsGitRepository}"
                        ToolTip.Tip="All changes in the repository, including ones made by commands or by you">
                <TextBlock Classes="small" Text="Working tree vs HEAD" />
              </CheckBox>
            </StackPanel>
            <ListBox x:Name="ChangedFilesList" ItemsSource="{Binding ChangedFiles.Files}" Background="Transparent"
                     Tapped="OnChangedFileTapped" DoubleTapped="OnChangedFileDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ChangedFileRow">
                  <Grid Classes="changedfile" Classes.reviewed="{Binding IsReviewed}" ColumnDefinitions="Auto,18,*,Auto" ToolTip.Tip="{Binding StatusText}" Background="Transparent">
                    <!-- DESIGN.md §8, "Reviewed": unticks when Claude changes the file again -->
                    <CheckBox Classes="reviewed" IsChecked="{Binding IsReviewed, Mode=OneWay}"
                              Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.ToggleFileReviewedCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="Reviewed" ToolTip.Tip="Reviewed. Unticks when Claude changes the file again." />
                    <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold" Text="{Binding Status}" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsDeleted}" />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" Text="{Binding DisplayPath}" TextTrimming="PathSegmentEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Classes="mono small muted" Text="{Binding Stats}" VerticalAlignment="Top" Margin="6,2,0,0" />
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open diff" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.OpenFileDiffCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="Open in diff tool" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.OpenFileInDiffToolCommand}" CommandParameter="{Binding}"
                                  IsVisible="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.HasDiffTool}" />
                        <MenuItem Header="Open in editor" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.OpenFileInEditorCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="Reveal in folder" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.RevealFileCommand}" CommandParameter="{Binding}" />
                        <MenuItem Header="Copy path" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChangedFiles.CopyFilePathCommand}" CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Agents (DESIGN.md §18, "Agent map"): the tree, and the selected agent's prompt and result -->
          <Grid IsVisible="{Binding IsAgentsPage}" RowDefinitions="Auto,*,Auto,*">
            <Grid Margin="12,0,6,6" ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted small" Text="{Binding AgentsHeader}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="flat" Padding="6" ToolTip.Tip="Open the agent map in its own window" AutomationProperties.Name="Open the agent map in a window"
                      Command="{Binding OpenAgentWindowCommand}">
                <Path Data="{StaticResource IconOpenWindow}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
              </Button>
            </Grid>
            <views:AgentTree Grid.Row="1" />
            <GridSplitter Grid.Row="2" Height="5" Background="Transparent" ResizeDirection="Rows" IsVisible="{Binding HasAgents}"
                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" />
            <views:AgentDetails Grid.Row="3" IsVisible="{Binding HasAgents}" />
          </Grid>

          <!-- Project (DESIGN.md §18, "Project tools"): the project's details and the selected run's log: the newest, or the
               one clicked in the sidebar. The actions are in the project's menu at the sidebar's foot. -->
          <DockPanel x:Name="ProjectPage" IsVisible="{Binding IsProjectPage}">
            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6" Spacing="8">
              <TextBlock Text="{Binding ProjectTools.HeaderTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ProjectTools.FileProblems}" IsVisible="{Binding ProjectTools.HasFileProblems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="small warning" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ProjectTools.Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="tools:ProjectDetail">
                    <Grid ColumnDefinitions="84,*" Margin="0,1">
                      <TextBlock Classes="muted small" Text="{Binding Label}" />
                      <SelectableTextBlock Grid.Column="1" Classes="small" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ProjectTools.HasSelectedRun}">
                <TextBlock Classes="small" Classes.error="{Binding ProjectTools.SelectedRun.Failed, FallbackValue=False}" Text="{Binding ProjectTools.SelectedRun.Status, FallbackValue={x:Null}}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Stop" Command="{Binding ProjectTools.SelectedRun.StopCommand, FallbackValue={x:Null}}"
                        IsVisible="{Binding ProjectTools.SelectedRun.IsRunning, FallbackValue=False}" ToolTip.Tip="Ends the job and every process it started" />
                <Button Grid.Column="2" Content="Copy" Command="{Binding ProjectTools.CopyOutputCommand}" ToolTip.Tip="Copy the output" />
              </Grid>
              <TextBlock Classes="muted small" Text="{Binding ProjectTools.SelectedRun.OutputNote, FallbackValue={x:Null}}" TextWrapping="Wrap"
                         IsVisible="{Binding ProjectTools.SelectedRun.OutputNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
            </StackPanel>
            <ListBox x:Name="ProjectOutputList" ItemsSource="{Binding ProjectTools.SelectedRun.Output, FallbackValue={x:Null}}" Background="Transparent" Margin="8,0,8,8"
                     IsVisible="{Binding ProjectTools.HasSelectedRun}" AutomationProperties.Name="Output">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono small" Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Tasks (DESIGN.md §5, "Tasks"): the approved plan, then each task with its state, owner, what it waits on and times -->
          <DockPanel IsVisible="{Binding IsTasksPage}">
            <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="12,0,12,6" Text="{Binding TodoList.Summary}" IsVisible="{Binding TodoList.HasItems}" />
            <ScrollViewer>
              <StackPanel Margin="12,0,12,12" Spacing="10">
                <Border Classes="codeblock" IsVisible="{Binding TodoList.HasPlan}">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Plan" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding TodoList.PlanApprovedText}" VerticalAlignment="Center" />
                    </Grid>
                    <md:MarkdownRenderer MarkdownBuilder="{Binding TodoList.PlanMarkdown}" />
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding TodoList.Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="conv:TodoItem">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="{Binding Glyph}" Classes.muted="{Binding IsDone}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock TextWrapping="Wrap" Classes.muted="{Binding IsDone}" Classes.strong="{Binding IsActive}">
                            <Run Classes="muted" Text="{Binding NumberText}" />
                            <Run Text="{Binding DisplayText}" />
                          </TextBlock>
                          <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                          <TextBlock Classes="small warning" Text="{Binding BlockedText}" IsVisible="{Binding IsBlocked}" />
                          <TextBlock Classes="muted small" Text="{Binding DetailText}" IsVisible="{Binding HasDetail}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- MCP servers (DESIGN.md §4, "MCP servers") -->
          <DockPanel IsVisible="{Binding IsMcpPage}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,0,12,6">
              <TextBlock Classes="muted small" Text="This session's MCP servers." VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="flat" Content="Refresh" Command="{Binding McpServers.RefreshCommand}" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="small error" Margin="12,0,12,6" Text="{Binding McpServers.Error}" TextWrapping="Wrap" IsVisible="{Binding McpServers.HasError}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding McpServers.Servers}" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:McpServerRow">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="small" Classes.muted="{Binding !IsFailed}" Classes.warning="{Binding IsFailed}" Text="{Binding StateText}" />
                      </Grid>
                      <TextBlock Classes="muted small" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                      <SelectableTextBlock Classes="small error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                      <!-- Signing in, while the user finishes in the browser -->
                      <StackPanel Spacing="4" IsVisible="{Binding IsSigningIn}">
                        <TextBlock Classes="muted small" Text="{Binding SignInText}" TextWrapping="Wrap" />
                        <Button Classes="flat" Padding="0" HorizontalAlignment="Left" ToolTip.Tip="{Binding SignInUrl}"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.OpenSignInPageCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="small" Foreground="{DynamicResource AccentStatusBrush}" Text="Open the sign-in page again" TextDecorations="Underline" />
                        </Button>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding CanPasteAddress}">
                          <TextBox Text="{Binding PastedAddress}" PlaceholderText="If the page after signing in didn't load, paste its address here"
                                   AutomationProperties.Name="The address the browser ended on" />
                          <Button Grid.Column="1" Classes="flat" Content="Done"
                                  Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.FinishSignInCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsBusy}">
                        <Button Classes="flat" Content="Sign in" IsVisible="{Binding CanSignIn}" ToolTip.Tip="Opens the server's sign-in page in your browser"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.SignInCommand}" CommandParameter="{Binding}" />
                        <Button Classes="flat" Content="Sign out" IsVisible="{Binding CanSignOut}" ToolTip.Tip="Forget this server's sign-in; connecting it again asks you to sign in"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.SignOutCommand}" CommandParameter="{Binding}" />
                        <Button Classes="flat" Content="Reconnect" IsVisible="{Binding CanReconnect}"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.ReconnectCommand}" CommandParameter="{Binding}" />
                        <Button Classes="flat" Content="Turn off" IsVisible="{Binding !IsDisabled}" ToolTip.Tip="Disconnect it and remove its tools, for this session"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.ToggleCommand}" CommandParameter="{Binding}" />
                        <Button Classes="flat" Content="Turn on" IsVisible="{Binding IsDisabled}"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).McpServers.ToggleCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <!-- Processes (DESIGN.md §4, "Process monitor") -->
          <DockPanel IsVisible="{Binding IsProcessesPage}">
            <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="12,0,12,6" Text="{Binding ProcessMonitor.SummaryText, TargetNullValue='Only Claude Code is running.'}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding ProcessMonitor.Processes}" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ProcessRow">
                    <Border Padding="4,3" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                      <StackPanel Margin="{Binding Indent, Converter={x:Static vm:Converters.LeftMargin}}" Spacing="1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                            <Run Classes="muted" Text="{Binding Pid}" FontSize="11" />
                          </TextBlock>
                          <TextBlock Grid.Column="1" Classes="mono small" Text="{Binding CpuText}" Margin="8,0,0,0" MinWidth="44" TextAlignment="Right" />
                          <TextBlock Grid.Column="2" Classes="mono small muted" Text="{Binding MemoryText}" Margin="8,0,0,0" MinWidth="56" TextAlignment="Right" />
                        </Grid>
                        <TextBlock Classes="muted small">
                          <Run Text="{Binding RunningText}" />
                          <Run Text="{Binding IsDetached, Converter={x:Static vm:Converters.DetachedText}}" />
                        </TextBlock>
                        <TextBlock Classes="mono muted small" Text="{Binding CommandLine}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCommandLine}" />
                        <Button Classes="flat" Padding="0" IsVisible="{Binding HasTool}" HorizontalAlignment="Left"
                                Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ProcessMonitor.ShowProcessToolCommand}" CommandParameter="{Binding}">
                          <TextBlock Classes="small" Foreground="{DynamicResource AccentStatusBrush}" Text="{Binding ToolText}" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </StackPanel>
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Stop…" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ProcessMonitor.StopProcessCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsRoot}" />
                          <MenuItem Header="Copy command line" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ProcessMonitor.CopyCommandLineCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Reveal executable" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ProcessMonitor.RevealExecutableCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Show in conversation" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ProcessMonitor.ShowProcessToolCommand}" CommandParameter="{Binding}" IsEnabled="{Binding HasTool}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Drag the side panel's edge to resize it; double-click for the default width. -->
    <Border x:Name="SidePanelEdge" Grid.Column="1" Grid.RowSpan="2" Width="6" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent"
            Cursor="SizeWestEast" ZIndex="1" IsVisible="{Binding IsSidePanelOpen}" />

    <!-- Conversation -->
    <Grid Grid.Row="0">
      <DockPanel>
        <!-- Find in the conversation (DESIGN.md §5, "Find"): Enter for the next match, Shift+Enter the one before, Esc closes -->
        <Border DockPanel.Dock="Top" Classes="findbar" IsVisible="{Binding Find.IsOpen}">
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
            <TextBox x:Name="FindBox" Classes="findbox" PlaceholderText="Find in the conversation" Text="{Binding Find.Query}"
                     AutomationProperties.Name="Find in the conversation" KeyDown="OnFindKeyDown" />
            <TextBlock Classes="muted small" Text="{Binding Find.CountText}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
            <Button Classes="flat" Padding="6,4" VerticalAlignment="Center" Command="{Binding Find.PreviousCommand}"
                    ToolTip.Tip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match">
              <Path Data="{StaticResource IconChevronUp}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="None" />
            </Button>
            <Button Classes="flat" Padding="6,4" VerticalAlignment="Center" Command="{Binding Find.NextCommand}"
                    ToolTip.Tip="Next match (Enter)" AutomationProperties.Name="Next match">
              <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="None" />
            </Button>
            <Button Classes="flat" Padding="6,4" VerticalAlignment="Center" Click="OnCloseFind"
                    ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close find">
              <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Border>
        <!-- Pinned to-do list -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding TodoList.HasItems}" Background="{DynamicResource SubtleBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,4">
          <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <Button Classes="flat row" Command="{Binding TodoList.ToggleExpandedCommand}">
              <TextBlock Classes="muted small" FontWeight="SemiBold" Text="{Binding TodoList.Summary}" />
            </Button>
            <ItemsControl ItemsSource="{Binding TodoList.Items}" IsVisible="{Binding TodoList.IsExpanded}" Margin="4,0,0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="conv:TodoItem">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Glyph}" Classes.status="{Binding IsActive}" Classes.busy="{Binding IsActive}" />
                    <TextBlock Text="{Binding DisplayText}" Classes.done="{Binding IsDone}" FontWeight="{Binding IsActive, Converter={x:Static vm:Converters.BoldIfTrue}}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ScrollViewer x:Name="ConversationScroll" HorizontalScrollBarVisibility="Disabled">
          <!-- Not clipped, so the first message's time and Copy chip can sit over its top edge (DESIGN.md §5). -->
          <ItemsControl x:Name="ConversationItems" ItemsSource="{Binding Items}" MaxWidth="900" ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- The messages a screen above and below the view stay built (CacheLength), not only those in it. A
                     reply's Markdown lays out in the background, so a reply built again starts one line tall: following
                     the newest output, the list then measured shorter, then taller, from frame to frame, and the view
                     jumped with it (DESIGN.md §5). -->
                <VirtualizingStackPanel Classes="conversation" CacheLength="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Button x:Name="JumpToLatest" Content="↓ Jump to latest" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12"
              IsVisible="False" Click="OnJumpToLatest" />

      <!-- Model switch confirmation (DESIGN.md §5) -->
      <Border Classes="overlay" IsVisible="{Binding HasPendingModel}">
        <Border Classes="dialog" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="Switch model?" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding PendingModelMessage}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Command="{Binding CancelModelSwitchCommand}" />
              <Button Classes="accent" Content="Switch model" Command="{Binding ConfirmModelSwitchCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- Bypass permissions confirmation (DESIGN.md §7) -->
      <Border Classes="overlay" IsVisible="{Binding IsConfirmingBypass}">
        <Border Classes="dialog" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="Bypass permissions?" FontWeight="SemiBold" FontSize="16" />
            <TextBlock TextWrapping="Wrap"
                       Text="For the rest of this session, Claude will run commands and change files without asking. Claude Code's own deny and ask rules still apply. Only do this in a folder where mistakes are easy to undo." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Command="{Binding CancelBypassCommand}" />
              <Button Classes="accent" Content="Bypass permissions" Command="{Binding ConfirmBypassCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- Perforce password (DESIGN.md §18): "Ask each time", or a first "Stored by Claudette" login. A new prompt
           makes a new password box, which takes the focus. -->
      <Border Classes="overlay" IsVisible="{Binding HasPerforcePrompt}">
        <ContentControl Content="{Binding PerforcePrompt}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:PerforcePasswordPrompt">
              <Border Classes="dialog" MaxWidth="460">
                <StackPanel Spacing="12">
                  <TextBlock Text="Log in to Perforce" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                  <TextBlock Classes="small error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                  <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Password" AutomationProperties.Name="Perforce password"
                           AttachedToVisualTree="OnPerforcePasswordAttached" />
                  <CheckBox Content="{Binding SaveText}" IsChecked="{Binding Save}" IsVisible="{Binding OfferToSave}" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Claude never sees it: it goes straight to p4 login." />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Classes="accent" Content="Log in" Command="{Binding LogInCommand}" IsDefault="True" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Border>
    </Grid>

    <!-- Composer (DESIGN.md §5) -->
    <StackPanel Grid.Row="1" Classes="composerarea" MaxWidth="948">

      <!-- Working line (DESIGN.md §5): a twinkling glyph, a fun verb, the turn's time and tokens -->
      <Panel x:Name="WorkingLine" Margin="4,0,4,-2" IsVisible="{Binding IsWorkingLineShown}">
        <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding Working}" x:DataType="vm:WorkingLine"
                    Background="Transparent" ToolTip.Tip="{Binding ActivityDetail}">
          <TextBlock Classes="working-glyph" Text="{Binding Glyph}" Width="14" TextAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Classes="working-verb" Text="{Binding Verb}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="{Binding Detail}" VerticalAlignment="Center" />
        </StackPanel>
      </Panel>

      <!-- Possibly stuck (check-ins) -->
      <Border Classes="codeblock" IsVisible="{Binding IsPossiblyStuck}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="warning" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Claude hasn't answered two check-ins. It may be stuck." />
          <Button Grid.Column="1" Content="Stop" Command="{Binding StopCommand}" />
        </Grid>
      </Border>

      <!-- A check-in counting down: it can go now, or not at all (DESIGN.md §5, "Check-ins on long turns") -->
      <Border Classes="codeblock" IsVisible="{Binding HasCheckInCountdown}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding CheckInCountdownText}" ToolTip.Tip="{Binding CheckInCountdown.Message}" />
          <Button Grid.Column="1" Content="Send now" Command="{Binding SendCheckInNowCommand}" />
          <Button Grid.Column="2" Classes="flat" Padding="4" ToolTip.Tip="Don't check in" AutomationProperties.Name="Don't check in" VerticalAlignment="Center"
                  Command="{Binding SkipCheckInCommand}">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <!-- A usage limit stopped the task: it continues when the limit resets (DESIGN.md §6, "Continuing after a limit resets") -->
      <Border Classes="codeblock" IsVisible="{Binding HasLimitWait}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding LimitWaitText}" />
          <Button Grid.Column="1" Content="Don't continue" Command="{Binding DontContinueCommand}" IsVisible="{Binding WillContinueAfterLimit}"
                  ToolTip.Tip="Leave the task stopped. Send a message to go on yourself." />
          <Button Grid.Column="1" Content="{Binding ContinueAfterLimitText}" Command="{Binding ContinueAfterLimitCommand}" IsVisible="{Binding CanContinueAfterLimit}" />
          <Button Grid.Column="2" Classes="flat" Padding="4" ToolTip.Tip="Close" AutomationProperties.Name="Close" VerticalAlignment="Center"
                  Command="{Binding DismissLimitWaitCommand}" IsVisible="{Binding CanContinueAfterLimit}">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <!-- Quick suffix chips -->
      <ItemsControl ItemsSource="{Binding Chips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SuffixChip">
            <Border Classes="chip" Classes.kept="{Binding IsKept}" ToolTip.Tip="{Binding Suffix.Text}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="small" Text="{Binding Label}" VerticalAlignment="Center" />
                <Button Classes="flat" Padding="3" ToolTip.Tip="Remove" AutomationProperties.Name="{Binding Label, StringFormat='Remove {0}'}"
                        Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).RemoveChipCommand}" CommandParameter="{Binding}">
                  <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
                </Button>
              </StackPanel>
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Keep on this tab / stop keeping" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ToggleKeepCommand}" CommandParameter="{Binding}" />
                </ContextMenu>
              </Border.ContextMenu>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- What the folder's own configuration would run, before Claude Code first starts there (DESIGN.md §7, "Folder trust") -->
      <Border Classes="codeblock" IsVisible="{Binding IsAskingTrust}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Trust this folder?" />
          <TextBlock TextWrapping="Wrap" Text="{Binding TrustText}" />
          <ItemsControl ItemsSource="{Binding TrustRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TrustRow">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                  <TextBlock Classes="muted small" Text="{Binding Kind}" MinWidth="110" />
                  <StackPanel Grid.Column="1">
                    <SelectableTextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Text}" />
                    <TextBlock Classes="muted small" Text="{Binding File}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Trust this folder" Command="{Binding TrustFolderCommand}" />
            <Button Content="Start without it" Command="{Binding StartWithoutFolderSettingsCommand}"
                    ToolTip.Tip="Claude Code starts without this folder's own settings, MCP servers and CLAUDE.md" />
            <Button Content="{Binding CloseMissingText}" Command="{Binding UnpinAndCloseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The folder is gone, for example a deleted clone (DESIGN.md §9, "Missing folder") -->
      <Border Classes="codeblock" IsVisible="{Binding IsFolderMissing}">
        <StackPanel Spacing="8">
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding FolderMissingText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Choose folder…" Command="{Binding ChooseFolderCommand}" />
            <Button Content="{Binding CloseMissingText}" Command="{Binding UnpinAndCloseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The transcript is gone from here and the library (DESIGN.md §9, "Old sessions") -->
      <Border Classes="codeblock" IsVisible="{Binding IsSessionMissing}">
        <StackPanel Spacing="8">
          <TextBlock Classes="warning" TextWrapping="Wrap" Text="{x:Static vm:TabViewModel.SessionMissingText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Start a new session" Command="{Binding StartNewSessionCommand}" />
            <Button Content="{Binding CloseMissingText}" Command="{Binding UnpinAndCloseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Taken over by another machine (DESIGN.md §9) -->
      <Border Classes="codeblock" IsVisible="{Binding IsReadOnly}">
        <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding ReadOnlyText}" />
      </Border>

      <!-- Bypass mode warning -->
      <TextBlock Classes="small error" Margin="4,0" TextWrapping="Wrap" IsVisible="{Binding IsBypassMode}"
                 Text="Bypass permissions: Claude won't ask before running commands or changing files in this session." />

      <!-- Why a dropped or pasted file wasn't attached -->
      <Grid ColumnDefinitions="*,Auto" Margin="4,0" IsVisible="{Binding HasAttachmentError}">
        <TextBlock Classes="small error" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding AttachmentError}" />
        <Button Grid.Column="1" Classes="flat" Padding="4" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissAttachmentErrorCommand}">
          <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
        </Button>
      </Grid>

      <Border x:Name="ComposerBox" Classes="composer" Classes.bypass="{Binding IsBypassMode}" DragDrop.AllowDrop="True">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <!-- Attached images, removable (DESIGN.md §5, "Attachments") -->
          <ItemsControl x:Name="AttachmentList" ItemsSource="{Binding Attachments}" IsVisible="{Binding Attachments.Count}" Margin="0,4,0,2">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="6" LineSpacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ComposerAttachment">
                <Panel ToolTip.Tip="{Binding Name}">
                  <Border Classes="thumbnail">
                    <Image Source="{Binding Data, Converter={x:Static services:ImageFiles.Thumbnail}}" Height="56" MaxWidth="120" Stretch="UniformToFill"
                           AutomationProperties.Name="{Binding Name}" />
                  </Border>
                  <Button Classes="flat" Padding="4" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="9"
                          Background="{DynamicResource ComposerBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                          ToolTip.Tip="Remove" AutomationProperties.Name="Remove image"
                          Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
                  </Button>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBox x:Name="Composer" Grid.Row="1" Text="{Binding ComposerText}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="240"
                   PlaceholderText="{Binding Tips.ComposerPlaceholder}" />

          <!-- / and @ autocomplete (DESIGN.md §5, "Composer"): keyboard first, the text box keeps focus -->
          <Popup x:Name="CompletionPopup" Grid.Row="1" PlacementTarget="{Binding #ComposerBox}" Placement="TopEdgeAlignedLeft" VerticalOffset="-4"
                 IsOpen="{Binding Completions.IsOpen, Mode=OneWay}" IsLightDismissEnabled="False">
            <Border Classes="dialog" Padding="4" Width="{Binding #ComposerBox.Bounds.Width}" MaxHeight="340">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="muted small" FontWeight="SemiBold" Margin="8,4,8,2" Text="{Binding Completions.Header}" />
                <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="8,4,8,6" Text="{Binding Completions.Message}" IsVisible="{Binding Completions.HasMessage}" />
                <ScrollViewer x:Name="CompletionScroll" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="CompletionList" ItemsSource="{Binding Completions.Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:CompletionItem">
                        <Button Classes="flat row completion" Classes.selected="{Binding IsSelected}" Focusable="False" Padding="8,4"
                                HorizontalContentAlignment="Stretch" Click="OnCompletionClicked">
                          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <Path Classes="toolicon" Data="{Binding IconKey, Converter={x:Static conv:ToolIcons.Geometry}}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                              <TextBlock Classes="muted small mono" Text="{Binding Hint}" VerticalAlignment="Center"
                                         IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Popup>

          <!-- Control bar: the chips on the left, and on the right the counts and Send, which move under the chips when
               both don't fit on one line (DESIGN.md §5) -->
          <controls:ControlBarPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <!-- Attach a file (DESIGN.md §5, "Attachments"); dropping and pasting work too -->
              <Button Classes="flat" Padding="6,4" ToolTip.Tip="Attach a file or image (or drop or paste one)" AutomationProperties.Name="Attach a file"
                      Click="OnAttachClicked">
                <Path Data="{StaticResource IconAttach}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.1" StrokeLineCap="Round"
                      Width="12" Height="12" Stretch="None" />
              </Button>
              <Button x:Name="SuffixButton" Classes="flat" ToolTip.Tip="{Binding Tips.Suffixes}">
                <TextBlock Classes="muted small" Text="Suffixes ▾" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft" Opened="OnSuffixMenuOpened">
                    <!-- 1–9 pick the first nine (DESIGN.md §5) -->
                    <StackPanel x:Name="SuffixMenu" MinWidth="280" Spacing="2" KeyDown="OnSuffixMenuKeyDown">
                      <ItemsControl ItemsSource="{Binding SuffixMenu}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:SuffixMenuItem">
                            <!-- Picking a checked one takes it off the message -->
                            <Button Classes="flat row" ToolTip.Tip="{Binding Suffix.Text}" Click="OnSuffixPicked" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ToggleSuffixCommand}" CommandParameter="{Binding Suffix}">
                              <Grid ColumnDefinitions="14,18,*,Auto" ColumnSpacing="6">
                                <Path Data="{StaticResource IconCheck}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="12" Stretch="None" VerticalAlignment="Center" IsVisible="{Binding IsOn}" />
                                <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Number}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Suffix.Label}" />
                                <TextBlock Grid.Column="3" Classes="muted small" Text="{Binding Shortcut}" VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Separator Margin="0,4" />
                      <Button Classes="flat row" Content="Edit suffixes…" Click="OnFlyoutItemPicked" Command="{Binding EditSuffixesCommand}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Model">
                <TextBlock Classes="muted small" Text="{Binding ModelName, StringFormat='{}{0} ▾', TargetNullValue='Model ▾'}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <ItemsControl ItemsSource="{Binding Models}" MinWidth="240">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="core:ModelInfo">
                          <Button Classes="flat row" Click="OnFlyoutItemPicked"
                                  Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChooseModelCommand}" CommandParameter="{Binding}">
                            <StackPanel>
                              <TextBlock Text="{Binding DisplayName}" />
                              <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="320" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Effort">
                <TextBlock Classes="muted small" Text="{Binding EffortName, StringFormat='{}{0} ▾'}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel MinWidth="160">
                      <Button Classes="flat row" Content="Default" Click="OnFlyoutItemPicked" Command="{Binding ChooseEffortCommand}" CommandParameter="{x:Null}" />
                      <ItemsControl ItemsSource="{Binding EffortLevels}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="flat row" Content="{Binding}" Click="OnFlyoutItemPicked"
                                    Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChooseEffortCommand}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- Permission mode (DESIGN.md §7) -->
              <Button Classes="flat" ToolTip.Tip="Permission mode for this session">
                <TextBlock Classes="muted small" Classes.error="{Binding IsBypassMode}" Text="{Binding PermissionModeName, StringFormat='{}{0} ▾'}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <ItemsControl ItemsSource="{Binding PermissionModeChoices}" MinWidth="280">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PermissionModeChoice">
                          <Button Classes="flat row" Click="OnFlyoutItemPicked"
                                  Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ChooseModeCommand}" CommandParameter="{Binding}">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" Classes.error="{Binding IsBypass}" />
                              <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="320" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2">
              <!-- Processes summary (DESIGN.md §4) -->
              <Button Classes="flat" IsVisible="{Binding ProcessMonitor.ShowSummary}"
                      ToolTip.Tip="Processes this tab started" Click="OnShowProcesses">
                <TextBlock Classes="muted small" Text="{Binding ProcessMonitor.SummaryText}" />
              </Button>

              <!-- Agents (DESIGN.md §18, "Agent map"), while the tab has subagents -->
              <Button Classes="flat" IsVisible="{Binding HasAgents}" ToolTip.Tip="What this tab's subagents are doing"
                      Command="{Binding OpenAgentsPageCommand}">
                <TextBlock Classes="muted small" Text="{Binding AgentsButtonText}" />
              </Button>

              <!-- Running tasks (DESIGN.md §5, "Running tasks"): what Claude Code keeps going in the background -->
              <Button x:Name="TasksChip" Classes="flat" IsVisible="{Binding HasRunningTasks}" ToolTip.Tip="Work Claude Code keeps running in the background"
                      AutomationProperties.Name="{Binding RunningTasksText}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Classes="status busy" Text="●" FontSize="9" VerticalAlignment="Center" />
                  <TextBlock Classes="muted small" Text="{Binding RunningTasksText}" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight" Opened="OnTaskListOpened" Closed="OnTaskListClosed">
                    <StackPanel x:Name="TaskList" Classes="tasklist" MinWidth="320" MaxWidth="480">
                      <TextBlock Text="{Binding RunningTasksText}" FontWeight="SemiBold" Margin="6,2,6,0" />
                      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="6,0,6,4"
                                 Text="Claude Code keeps these going after the turn, and tells Claude when each one ends." />
                      <ItemsControl ItemsSource="{Binding Tasks.Running}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="conv:RunningTask">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                              <Button Classes="flat row taskrow" ToolTip.Tip="{Binding Tooltip}" Click="OnFlyoutItemPicked"
                                      Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ShowTaskCommand}" CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <Path Classes="toolicon" Data="{Binding IconKey, Converter={x:Static conv:ToolIcons.Geometry}}" Margin="0,0,8,0" />
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted small" Text="{Binding KindText}" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding RunningText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                              </Button>
                              <Button Grid.Column="1" Classes="flat" Content="Stop" VerticalAlignment="Center" Click="OnFlyoutItemPicked"
                                      ToolTip.Tip="Stop it through Claude Code, which tells Claude it ended"
                                      Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).StopTaskCommand}" CommandParameter="{Binding}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- Changed files (DESIGN.md §8) -->
              <Button Classes="flat" ToolTip.Tip="Changed files" Command="{Binding ToggleSidePanelCommand}">
                <TextBlock Classes="muted small" Text="{Binding ChangedFiles.Count, StringFormat='Files ({0})'}" />
              </Button>

              <!-- Context window (DESIGN.md §6, "Per-tab context"): what fills it, as the tab's context ring shows it -->
              <Button x:Name="ContextButton" Classes="flat" ToolTip.Tip="{Binding ContextDetail}"
                      IsVisible="{Binding ContextText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="muted small" Classes.warning="{Binding IsContextHigh}" Text="{Binding ContextText}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <views:ContextBreakdownView />
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Tokens used by this tab">
                <TextBlock Classes="muted small" Text="{Binding TokensShort}" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight" Opened="OnTokenDetailsOpened" Closed="OnTokenDetailsClosed">
                    <StackPanel Spacing="8" MinWidth="420">
                      <TextBlock FontWeight="SemiBold" Text="Tokens used by this tab" />
                      <Grid ColumnDefinitions="*,70,70,80,80,60">
                        <TextBlock Classes="muted small" Text="Model" />
                        <TextBlock Grid.Column="1" Classes="muted small" Text="Input" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="muted small" Text="Output" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="muted small" Text="Cache write" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="muted small" Text="Cache read" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Classes="muted small" Text="Cost" HorizontalAlignment="Right" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding TokenRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:TokenRow">
                            <Grid ColumnDefinitions="*,70,70,80,80,60">
                              <TextBlock Classes="small" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="small mono" Text="{Binding Input}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="2" Classes="small mono" Text="{Binding Output}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="3" Classes="small mono" Text="{Binding CacheWrite}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="4" Classes="small mono" Text="{Binding CacheRead}" HorizontalAlignment="Right" />
                              <TextBlock Grid.Column="5" Classes="small mono" Text="{Binding Cost}" HorizontalAlignment="Right" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="muted small" Text="{Binding TokenSummary}" TextWrapping="Wrap" MaxWidth="420" />
                      <TextBlock Classes="small" Text="{Binding TokenWindowText}" IsVisible="{Binding TokenWindowText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <StackPanel Spacing="2" IsVisible="{Binding TurnPoints.Count}">
                        <TextBlock Classes="muted small" Text="Tokens per turn" />
                        <controls:UsageChart Height="48" Points="{Binding TurnPoints}" Maximum="{Binding TurnChartMaximum}"
                                             LineBrush="{DynamicResource MeterBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="flat" ToolTip.Tip="Tab info">
                <TextBlock Classes="muted small" Text="ⓘ" />
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel Spacing="8" MinWidth="320" MaxWidth="480">
                      <ItemsControl ItemsSource="{Binding InfoRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:InfoRow">
                            <Grid ColumnDefinitions="88,*" Margin="0,1">
                              <TextBlock Classes="muted small" Text="{Binding Label}" />
                              <SelectableTextBlock Grid.Column="1" Classes="small" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Perforce changelists, with Copy and Open in P4V (DESIGN.md §18) -->
                      <ItemsControl ItemsSource="{Binding ChangelistRows}" IsVisible="{Binding HasChangelists}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:ChangelistRow">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                              <TextBlock Classes="small" Text="{Binding Text}" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="flat" Content="Copy" Click="OnFlyoutItemPicked"
                                      Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).CopyChangelistCommand}" CommandParameter="{Binding Number}" />
                              <Button Grid.Column="2" Classes="flat" Content="Open in P4V" Click="OnFlyoutItemPicked"
                                      Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).OpenChangelistInP4VCommand}" CommandParameter="{Binding Number}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <Button Classes="accent send" Margin="6,0,0,0" Command="{Binding SendCommand}" IsVisible="{Binding !IsWorking}" AutomationProperties.Name="Send">
                <Panel>
                  <TextBlock Classes="sendlabel" Text="Send" />
                  <Path Classes="sendarrow" Data="{StaticResource IconSendArrow}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                        StrokeLineCap="Round" StrokeJoin="Round" Width="32" Height="32" Stretch="None" />
                </Panel>
              </Button>
              <Button Classes="stop" Margin="6,0,0,0" ToolTip.Tip="Stop (Esc)" AutomationProperties.Name="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsWorking}">
                <Panel>
                  <TextBlock Classes="stoplabel" Text="■" />
                  <Path Classes="stopsquare" Data="{StaticResource IconStopRound}" Fill="{Binding $parent[Button].Foreground}" Width="32" Height="32" Stretch="None" />
                </Panel>
              </Button>
            </StackPanel>
          </controls:ControlBarPanel>
        </Grid>
      </Border>

      <!-- Status line -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,0">
        <TextBlock Classes="muted small" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" MaxWidth="520" />
        <TextBlock Classes="muted small" Text="{Binding StatusTip}" />
        <Button Classes="flat" Padding="4,0" IsVisible="{Binding CanRestart}" Command="{Binding RestartCommand}">
          <TextBlock Classes="small" Text="Restart" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
