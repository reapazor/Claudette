<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.ProjectLinkEditorView"
             x:DataType="vm:ProjectLinkEditorViewModel">
  <!-- A link on Settings' Links page (DESIGN.md §18, "Links"), checked as the sidebar opens links -->
  <Border Classes="dialog" Width="460">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
      <TextBlock Text="Name" />
      <TextBox Text="{Binding Name}" PlaceholderText="for example: Board (the address shows when it's empty)" AutomationProperties.Name="Name" />
      <TextBlock Text="Address" Margin="0,4,0,0" />
      <TextBox Classes="mono" Text="{Binding Url}" PlaceholderText="https://github.com/org/repo/compare/{branch}?expand=1" AutomationProperties.Name="Address" />
      <TextBlock Classes="small error" Text="{Binding UrlProblem}" TextWrapping="Wrap" IsVisible="{Binding HasUrlProblem}" />
      <TextBlock Classes="muted small" Text="{Binding PlaceholderHint}" TextWrapping="Wrap" />
      <StackPanel Spacing="4" IsVisible="{Binding AsksForFile}" Margin="0,4,0,0">
        <TextBlock Text="Save in" />
        <RadioButton GroupName="ProjectLinkFile" Content="{Binding LocalText}" IsChecked="{Binding SaveToLocal}" />
        <RadioButton GroupName="ProjectLinkFile" Content="{Binding SharedText}" IsChecked="{Binding SaveToShared}" />
      </StackPanel>
      <TextBlock Text="{Binding FileText}" IsVisible="{Binding !AsksForFile}" Margin="0,4,0,0" />
      <TextBlock Classes="muted small" Text="{Binding FileNote}" TextWrapping="Wrap" />
      <TextBlock Classes="small error" Text="{Binding FileProblem}" TextWrapping="Wrap" IsVisible="{Binding HasFileProblem}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
