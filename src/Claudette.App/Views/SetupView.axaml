<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             x:Class="Claudette.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
    <StackPanel Spacing="12">
      <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
      <SelectableTextBlock Classes="muted"
                           Text="{Binding FoundPath}"
                           IsVisible="{Binding HasFoundPath}"
                           FontFamily="{StaticResource MonoFont}"
                           TextWrapping="Wrap" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Claudette runs your installed Claude Code. Install it, or point Claudette at the claude executable." />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <!-- DESIGN.md §12, "Minimum version": the same Update now as the header badge -->
        <Button Classes="accent" Content="Update now" Command="{Binding UpdateNowCommand}" IsVisible="{Binding CanUpdate}" />
        <Button Classes="accent" Content="Check again" Command="{Binding CheckAgainCommand}" IsVisible="{Binding !CanUpdate}" />
        <Button Content="Check again" Command="{Binding CheckAgainCommand}" IsVisible="{Binding CanUpdate}" />
        <Button Content="Choose claude…" Command="{Binding BrowseCommand}" />
        <Button Content="Install instructions" Command="{Binding OpenInstallDocsCommand}" />
      </WrapPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsUpdating}" />
      <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="10,8" IsVisible="{Binding HasOutput}" MaxHeight="200">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding Output}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <TextBlock Text="{Binding UpdateResult}" TextWrapping="Wrap"
                 IsVisible="{Binding UpdateResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </Border>
</UserControl>
