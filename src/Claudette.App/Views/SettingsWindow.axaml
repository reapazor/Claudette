<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Claudette.App.ViewModels"
        xmlns:installation="using:Claudette.Core.Installation"
        x:Class="Claudette.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="820" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- DESIGN.md §14: a sidebar of categories; changes apply immediately. -->
  <Grid ColumnDefinitions="190,*">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- DESIGN.md §14: a search box filters settings by name -->
        <TextBox DockPanel.Dock="Top" Margin="8,8,8,2" Text="{Binding SearchText}" PlaceholderText="Search settings"
                 AutomationProperties.Name="Search settings" />
        <Panel>
          <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" Margin="6"
                   IsVisible="{Binding !IsSearching}" />
          <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" Background="Transparent" Margin="6"
                   IsVisible="{Binding IsSearching}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SettingsSearchResult">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted small" Text="{Binding Category}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="muted small" Text="No settings match." Margin="14,10" TextWrapping="Wrap" VerticalAlignment="Top">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsSearching" />
                <Binding Path="!SearchResults.Count" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
        </Panel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="24,20">
      <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">

        <!-- General -->
        <StackPanel Spacing="12" IsVisible="{Binding IsGeneral}">
          <TextBlock Classes="section" Text="General" />
          <CheckBox Content="Confirm before closing a tab where Claude is working" IsChecked="{Binding ConfirmCloseWorkingTab}" />
          <CheckBox Content="Also rename the session in Claude Code when I rename a tab" IsChecked="{Binding RenameInClaudeCode}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Then claude --resume &lt;name&gt; in a terminal finds the session by the same name." Margin="28,-8,0,0" />

          <!-- Claudette's own updates, from its GitHub releases (DESIGN.md §2, "Updating Claudette") -->
          <TextBlock Text="Claudette updates" FontWeight="SemiBold" Margin="0,8,0,0" />
          <CheckBox Content="Check for Claudette updates automatically" IsChecked="{Binding CheckForAppUpdates}" />
          <CheckBox Content="Include pre-releases" IsChecked="{Binding IncludePrereleases}" />
          <Panel IsVisible="{Binding HasAppUpdates}">
            <StackPanel Spacing="8" DataContext="{Binding AppUpdates}" x:DataType="vm:AppUpdateViewModel">
              <TextBlock Text="{Binding CurrentVersionText, FallbackValue=''}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Text="{Binding CheckStatusText, FallbackValue=''}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Text="{Binding ManualText}" TextWrapping="Wrap" IsVisible="{Binding HasManualText}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" IsVisible="{Binding IsDownloading}" />
              <TextBlock Classes="small warning" Text="{Binding ErrorText}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="Check now" Command="{Binding CheckNowCommand}" IsEnabled="{Binding CanCheck}" IsVisible="{Binding !IsSourceBuild}" />
                <Button Classes="accent" Content="{Binding RestartLabel}" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding CanRestartToUpdate}" />
                <Button Content="Download" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
                <Button Content="Cancel download" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
                <Button Content="{Binding OpenPackageLabel}" Command="{Binding OpenPackageCommand}" IsVisible="{Binding CanOpenPackage}" />
                <Button Classes="flat" Content="Release notes" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding HasRelease}" />
              </WrapPanel>
            </StackPanel>
          </Panel>
          <Button Content="Reset to defaults" Command="{Binding ResetGeneralCommand}" />
        </StackPanel>

        <!-- Claude Code -->
        <StackPanel Spacing="12" IsVisible="{Binding IsClaudeCode}">
          <TextBlock Classes="section" Text="Claude Code" />
          <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" IsVisible="{Binding !HasUpdates}" />

          <!-- Version, install method and updates, from claude doctor (DESIGN.md §12) -->
          <Panel IsVisible="{Binding HasUpdates}">
            <StackPanel Spacing="8" DataContext="{Binding Updates}" x:DataType="vm:ClaudeUpdateViewModel">
              <TextBlock Text="{Binding VersionText, FallbackValue=''}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Text="{Binding AutoUpdateText}" TextWrapping="Wrap" IsVisible="{Binding AutoUpdateText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted small" Text="{Binding LastAttemptText}" TextWrapping="Wrap" IsVisible="{Binding LastAttemptText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="small" Text="claude doctor found:" IsVisible="{Binding HasWarnings}" Margin="0,4,0,0" />
              <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="installation:DoctorWarning">
                    <StackPanel Margin="0,2">
                      <TextBlock Classes="small warning" Text="{Binding Issue}" TextWrapping="Wrap" />
                      <SelectableTextBlock Classes="muted small" Text="{Binding Fix, StringFormat='Fix: {0}'}" TextWrapping="Wrap"
                                           IsVisible="{Binding Fix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted small" Text="{Binding CheckStatusText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" IsVisible="{Binding ReadyVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="Check now" Command="{Binding CheckNowCommand}" />
                <Button Classes="accent" Content="Update now" Command="{Binding UpdateNowCommand}" IsVisible="{Binding CanUpdateNow}" />
                <Button Classes="accent" Content="Update on next launch" Command="{Binding UpdateOnNextLaunchCommand}"
                        IsVisible="{Binding CanUpdateOnNextLaunch}" IsEnabled="{Binding !IsUpdateScheduled}" />
                <Button Content="Don't update on next launch" Command="{Binding CancelUpdateOnNextLaunchCommand}" IsVisible="{Binding IsUpdateScheduled}" />
                <Button Classes="flat" Content="What's new" Command="{Binding OpenChangelogCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
              <StackPanel Spacing="4" IsVisible="{Binding HasManualCommand}">
                <TextBlock Classes="small" Text="Run this in a terminal to update:" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="8,6">
                    <SelectableTextBlock Text="{Binding ManualCommand}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                  </Border>
                  <Button Grid.Column="1" Content="Copy" Command="{Binding CopyManualCommandCommand}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
              <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="8,6" MaxHeight="180" IsVisible="{Binding HasOutput}">
                <ScrollViewer>
                  <SelectableTextBlock Text="{Binding Output}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
              </Border>
              <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Panel>
          <CheckBox Content="Check for Claude Code updates automatically" IsChecked="{Binding CheckForUpdates}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="At launch and every few hours. Open tabs keep the version they started with; new tabs use the newest one installed." />
          <!-- The account, with Sign in / Sign out (DESIGN.md §11, §14) -->
          <TextBlock Text="{Binding AccountText, StringFormat='Signed in as {0}'}" TextWrapping="Wrap" IsVisible="{Binding !HasAccount}" />
          <Panel IsVisible="{Binding HasAccount}">
            <StackPanel Spacing="8" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
              <TextBlock Text="{Binding SettingsText, FallbackValue=''}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="Sign out…" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
                <Button Classes="accent" Content="Sign in" Command="{Binding BeginSignInCommand}" IsVisible="{Binding CanBeginSignIn}" />
              </WrapPanel>
              <TextBlock Classes="muted small" Text="Signing out affects Claude Code everywhere on this computer, and every tab stops working until you sign in again."
                         TextWrapping="Wrap" IsVisible="{Binding IsSignedIn}" />
              <TextBlock Classes="error" Text="{Binding SignOutError}" TextWrapping="Wrap" IsVisible="{Binding HasSignOutError}" />
              <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="10,8" IsVisible="{Binding HasSignOutConfirmation}">
                <StackPanel Spacing="8" DataContext="{Binding SignOutConfirmation}" x:DataType="vm:ConfirmationViewModel">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title, FallbackValue=''}" />
                  <TextBlock TextWrapping="Wrap" Text="{Binding Message, FallbackValue=''}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="{Binding ConfirmText, FallbackValue=''}" Command="{Binding ConfirmCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <ContentControl Content="{Binding SignIn}" IsVisible="{Binding HasSignIn}" HorizontalAlignment="Left" />
            </StackPanel>
          </Panel>
          <TextBlock Text="Path to claude" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ClaudePath}" PlaceholderText="Found automatically" />
            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseClaudePathCommand}" />
          </Grid>
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Leave empty to find Claude Code automatically. A change takes effect the next time Claudette starts." />
          <Button Content="Reset to defaults" Command="{Binding ResetClaudeCodeCommand}" />
        </StackPanel>

        <!-- New tabs -->
        <StackPanel Spacing="12" IsVisible="{Binding IsNewTabs}">
          <TextBlock Classes="section" Text="New tabs" />
          <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Text="Default model" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding DefaultModel}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Default effort" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding EffortChoices}" SelectedItem="{Binding DefaultEffort}" />
            <TextBlock Grid.Row="2" Classes="label" Text="Default permission mode" />
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding DefaultMode}" />
            <TextBlock Grid.Row="3" Classes="label" Text="Recent folders to keep" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="100" Increment="1" FormatString="0" Value="{Binding RecentFolderLimit}" />
          </Grid>
          <Button Content="Clear recent folders" Command="{Binding ClearRecentFoldersCommand}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,-6,0,0" Text="Favorites are kept." />

          <!-- Favorite folders: always at the top of the new tab picker (DESIGN.md §4) -->
          <TextBlock Text="Favorite folders" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" Text="None yet. Add one here, or right-click a folder in the new tab picker." IsVisible="{Binding !HasFavorites}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Favorites}" IsVisible="{Binding HasFavorites}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:FavoriteFolderRow">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Margin="0,2">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="muted small" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="flat" Content="↑" ToolTip.Tip="Move up" AutomationProperties.Name="Move up"
                          Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).MoveFavoriteUpCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="flat" Content="↓" ToolTip.Tip="Move down" AutomationProperties.Name="Move down"
                          Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).MoveFavoriteDownCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="3" Classes="flat" Content="Remove"
                          Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveFavoriteCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Add folder…" Command="{Binding AddFavoriteCommand}" />
          <Button Content="Reset to defaults" Command="{Binding ResetNewTabsCommand}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Spacing="12" IsVisible="{Binding IsAppearance}">
          <TextBlock Classes="section" Text="Appearance" />
          <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Text="Theme" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Conversation font" />
            <AutoCompleteBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding InstalledFonts}" Text="{Binding ConversationFont}" FilterMode="ContainsOrdinal"
                             PlaceholderText="Claudette's default" MinimumPrefixLength="0" AutomationProperties.Name="Conversation font" />
            <TextBlock Grid.Row="2" Classes="label" Text="Conversation font size" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="9" Maximum="28" Increment="1" FormatString="0" Value="{Binding ConversationFontSize}" />
            <TextBlock Grid.Row="3" Classes="label" Text="Code font" />
            <AutoCompleteBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding InstalledFonts}" Text="{Binding CodeFont}" FilterMode="ContainsOrdinal"
                             PlaceholderText="Cascadia Mono, Consolas or Menlo" MinimumPrefixLength="0" AutomationProperties.Name="Code font" />
            <TextBlock Grid.Row="4" Classes="label" Text="Code font size" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="8" Maximum="28" Increment="1" FormatString="0" Value="{Binding CodeFontSize}" />
          </Grid>
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,-4,0,0"
                     Text="Leave a font empty for the default. A font that isn't installed on this machine falls back to the default." />
          <CheckBox Content="Show thinking expanded" IsChecked="{Binding ExpandThinking}" />
          <CheckBox Content="Show fun words while Claude works" IsChecked="{Binding FunWorkingWords}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="A twinkling line above the message box, such as “Noodling… 42s · 3.1k tokens”. Off, it says “Working…”. Verbs added to spinnerVerbs in Claude Code's settings show here too." />
          <CheckBox Content="Show what Claude is doing while it works" IsChecked="{Binding ShowToolInWorkingLine}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="While a tool runs, the line says what it's doing instead, such as “Running dotnet test…” or “Reading TabView.axaml…”." />
          <Button Content="Reset to defaults" Command="{Binding ResetAppearanceCommand}" />
        </StackPanel>

        <!-- Sessions -->
        <StackPanel Spacing="12" IsVisible="{Binding IsSessions}">
          <TextBlock Classes="section" Text="Sessions" />
          <CheckBox Content="Also restore unpinned tabs when Claudette starts" IsChecked="{Binding RestoreUnpinnedTabs}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0" Text="Pinned tabs are always restored." />
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Text="Name for this machine" />
            <TextBox Grid.Column="1" Text="{Binding MachineName}" PlaceholderText="{Binding MachineNamePlaceholder}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Keep library sessions for" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LibraryRetentionChoices}" SelectedItem="{Binding KeepLibrarySessions}" />
          </Grid>

          <!-- Session library (DESIGN.md §9) -->
          <TextBlock Text="Session library folder" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Tabs that sync copy their session's transcript here after every turn. Point it at a folder Google Drive, Dropbox or OneDrive keeps in sync, and your other machines can find and continue those sessions in History." />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding LibraryFolder, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseLibraryFolderCommand}" ToolTip.Tip="Use another folder from now on" />
            <Button Grid.Column="2" Content="Move library…" Command="{Binding MoveLibraryCommand}" ToolTip.Tip="Copy the existing sessions to another folder and use it" />
          </Grid>
          <Button Classes="flat" Content="Use the default folder" Command="{Binding UseDefaultLibraryFolderCommand}" IsVisible="{Binding !IsDefaultLibraryFolder}" HorizontalAlignment="Left" />
          <Border Classes="codeblock" IsVisible="{Binding IsConfirmingLibraryFolder}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" Text="{Binding LibraryConfirmText}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Use this folder" Command="{Binding ConfirmLibraryFolderCommand}" />
                <Button Content="Cancel" Command="{Binding CancelLibraryFolderCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="muted small" Text="{Binding LibraryStatus}" TextWrapping="Wrap" IsVisible="{Binding LibraryStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <CheckBox Content="Sync new tabs to the session library" IsChecked="{Binding SyncNewTabs}" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="Any tab can be switched on or off with Sync to other machines in its menu. Sessions opened from the library keep syncing." />

          <!-- Settings sync (DESIGN.md §14) -->
          <CheckBox Content="Sync Claudette's settings through the library" IsChecked="{Binding SyncSettings}" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="Appearance, new-tab defaults, usage thresholds, check-ins, quick suffixes, notifications and process monitor options. The path to claude, this machine's name, the library folder, the diff tool and your folders stay on each machine." />
          <Border Classes="codeblock" IsVisible="{Binding IsChoosingSyncSource}">
            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" Text="The library already has settings from another machine. Which should this machine use?" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Use synced settings" Command="{Binding UseSyncedSettingsCommand}" />
                <Button Content="Replace them with this machine's" Command="{Binding ReplaceSyncedSettingsCommand}" />
                <Button Classes="flat" Content="Cancel" Command="{Binding CancelSyncChoiceCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Button Content="Reset to defaults" Command="{Binding ResetSessionsCommand}" ToolTip.Tip="The library folder and settings sync stay as they are" />
        </StackPanel>

        <!-- Diff tool (DESIGN.md §8, "External diff tool") -->
        <StackPanel Spacing="12" IsVisible="{Binding IsDiffTool}">
          <TextBlock Classes="section" Text="Diff tool" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="How changed files open. Tools that are installed on this machine are listed. With a tool set, double-click a changed file to open it there; the built-in view is still in the file's menu." />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding DiffToolOptions}" SelectedItem="{Binding SelectedDiffTool}" />
          <StackPanel Spacing="6" IsVisible="{Binding IsCustomDiffTool}">
            <TextBlock Text="Command" />
            <TextBox Classes="mono" Text="{Binding CustomDiffCommand}" PlaceholderText="&quot;C:\Program Files\Beyond Compare 5\BCompare.exe&quot; &quot;{left}&quot; &quot;{right}&quot; /title1=&quot;{leftTitle}&quot; /title2=&quot;{rightTitle}&quot;" />
            <TextBlock Classes="small error" Text="{Binding CustomDiffCommandError}" TextWrapping="Wrap" IsVisible="{Binding CustomDiffCommandError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="A program and its arguments. {left} is the file before Claude's changes (a read-only copy), {right} is the file now; {leftTitle} and {rightTitle} are their titles." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanTestDiffTool}">
            <Button Content="Test" Command="{Binding TestDiffToolCommand}" />
            <TextBlock Classes="muted small" Text="{Binding DiffToolTestResult}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <Button Content="Reset to defaults" Command="{Binding ResetDiffToolCommand}" />
        </StackPanel>

        <!-- Processes (DESIGN.md §4, "Process monitor") -->
        <StackPanel Spacing="12" IsVisible="{Binding IsProcesses}">
          <TextBlock Classes="section" Text="Processes" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="See the processes each tab has started (test runs, dev servers, builds, MCP servers) with their CPU and memory use. When a tab closes, the processes it started are stopped too." />
          <CheckBox Content="Show the process monitor" IsChecked="{Binding ShowProcessMonitor}" />
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto" IsEnabled="{Binding ShowProcessMonitor}">
            <TextBlock Classes="label" Text="Refresh the panel every (seconds)" />
            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="60" Increment="1" FormatString="0" Value="{Binding ProcessRefreshSeconds}" />
          </Grid>
          <CheckBox Content="Show command lines" IsChecked="{Binding ShowCommandLines}" IsEnabled="{Binding ShowProcessMonitor}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="Command lines sometimes contain tokens or passwords. Turn this off if others can see your screen." />
          <Button Content="Reset to defaults" Command="{Binding ResetProcessesCommand}" />
        </StackPanel>

        <!-- Usage (DESIGN.md §6) -->
        <StackPanel Spacing="12" IsVisible="{Binding IsUsage}">
          <TextBlock Classes="section" Text="Usage" />
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Text="Warn at (% of session used)" />
            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="100" Increment="5" FormatString="0" Value="{Binding WarnPercent}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Alert at (% of session used)" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="100" Increment="5" FormatString="0" Value="{Binding CriticalPercent}" />
            <TextBlock Grid.Row="2" Classes="label" Text="Burn rate window (minutes)" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="300" Increment="5" FormatString="0" Value="{Binding BurnRateWindowMinutes}" />
          </Grid>
          <CheckBox Content="Show model-specific weekly limits" IsChecked="{Binding ShowModelMeters}" />
          <CheckBox Content="If Claude Code stops reporting them, read model limits from /usage" IsChecked="{Binding UseUsageCommandFallback}" IsEnabled="{Binding ShowModelMeters}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="A fallback that reads the text /usage prints. It's free, but can break when Claude Code changes its wording." />
          <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="8">
            <TextBlock Classes="label" Text="Keep usage history" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding HistoryRetentionChoices}" SelectedItem="{Binding KeepUsageHistory}" />
            <Button Grid.Column="2" Content="Clear usage history…" Command="{Binding ClearUsageHistoryCommand}" />
          </Grid>
          <Border Classes="codeblock" IsVisible="{Binding IsConfirmingClearUsage}">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Clear all usage history?" />
              <TextBlock TextWrapping="Wrap" Text="This deletes every stored usage sample and per-turn token record. The header fills in again at the next update from Claude Code." />
              <CheckBox Content="Also reset per-tab token totals" IsChecked="{Binding AlsoResetTabTotals}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="Clear" Command="{Binding ConfirmClearUsageCommand}" />
                <Button Content="Cancel" Command="{Binding CancelClearUsageCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="muted small" Text="{Binding UsageClearedText}" IsVisible="{Binding UsageClearedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Usage history is kept on this machine only. It holds usage percentages and token counts, never your prompts, replies or code." />
          <Button Content="Reset to defaults" Command="{Binding ResetUsageCommand}" />
        </StackPanel>

        <!-- Check-ins -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCheckIns}">
          <TextBlock Classes="section" Text="Check-ins" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="During a long turn, Claudette can ask Claude how it's going, so a stuck tab doesn't burn usage unnoticed. Set a time to 0 to turn that trigger off." />
          <CheckBox Content="Check in on long turns" IsChecked="{Binding CheckInsEnabled}" />
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="10" IsEnabled="{Binding CheckInsEnabled}">
            <TextBlock Classes="label" Text="After the turn has run (minutes)" />
            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="600" Increment="1" FormatString="0" Value="{Binding CheckInRunTime}" />
            <TextBlock Grid.Row="1" Classes="label" Text="After no output for (minutes)" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="600" Increment="1" FormatString="0" Value="{Binding CheckInQuietTime}" />
          </Grid>
          <TextBlock Text="Message" />
          <TextBox Text="{Binding CheckInMessage}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" IsEnabled="{Binding CheckInsEnabled}" />
          <CheckBox Content="Notify me when a check-in is sent" IsChecked="{Binding NotifyOnCheckIn}" IsEnabled="{Binding CheckInsEnabled}" />
          <Button Content="Reset to defaults" Command="{Binding ResetCheckInsCommand}" />
        </StackPanel>

        <!-- Quick suffixes -->
        <StackPanel Spacing="12" IsVisible="{Binding IsQuickSuffixes}">
          <TextBlock Classes="section" Text="Quick suffixes" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="{Binding SuffixesShortcutText, StringFormat='Snippets you can add to the end of a message from the Suffixes menu ({0}), or with their own shortcut. The label shows on the chip, and the text is sent.'}" />
          <ItemsControl ItemsSource="{Binding Suffixes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:QuickSuffixEditor">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                    <TextBox Text="{Binding Label}" PlaceholderText="Label" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                      <Button Content="↑" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).MoveSuffixUpCommand}" CommandParameter="{Binding}" />
                      <Button Content="↓" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).MoveSuffixDownCommand}" CommandParameter="{Binding}" />
                      <Button Content="Delete" Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveSuffixCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text}" PlaceholderText="Text added to the message" AcceptsReturn="True" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="small" Text="Shortcut" VerticalAlignment="Center" />
                      <Button Content="{Binding ShortcutText}" FontFamily="{StaticResource MonoFont}" MinWidth="150" HorizontalContentAlignment="Left"
                              Classes.accent="{Binding IsRecording}" ToolTip.Tip="Click, then press the keys that add this suffix"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).StartRecordingCommand}" CommandParameter="{Binding}" />
                      <Button Classes="flat" Content="Remove" IsVisible="{Binding HasShortcut}"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ClearShortcutCommand}" CommandParameter="{Binding}" />
                      <TextBlock Classes="small error" Text="{Binding Error}" IsVisible="{Binding HasError}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Add suffix" Command="{Binding AddSuffixCommand}" />
            <Button Content="Reset to defaults" Command="{Binding ResetSuffixesCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Notifications (DESIGN.md §10) -->
        <StackPanel Spacing="12" IsVisible="{Binding IsNotifications}">
          <TextBlock Classes="section" Text="Notifications" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Claudette sends a notification when something needs you and you aren't looking at it. Clicking one brings Claudette to the front, on that tab." />
          <TextBlock Classes="small warning" TextWrapping="Wrap" IsVisible="{Binding !NotificationsAvailable}"
                     Text="Notifications aren't available here. On macOS, Claudette has to run from its app (not with dotnet run); on Linux, it needs notify-send." />
          <TextBlock Text="Notify me when" FontWeight="SemiBold" />
          <CheckBox Content="A tab finishes its turn" IsChecked="{Binding NotifyTurnFinished}" />
          <CheckBox Content="A tab needs permission or an answer" IsChecked="{Binding NotifyNeedsInput}" />
          <CheckBox Content="A tab's Claude Code stops with an error" IsChecked="{Binding NotifyProcessErrors}" />
          <CheckBox Content="Usage crosses a warning level, is on pace to run out, or resets" IsChecked="{Binding NotifyUsageAlerts}" />
          <CheckBox Content="Claude Code needs me to sign in" IsChecked="{Binding NotifySignIn}" />
          <CheckBox Content="A Claude Code update is ready" IsChecked="{Binding NotifyUpdateReady}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Check-in notifications are in Check-ins." />
          <CheckBox Content="Show the number of tabs needing input on the Dock or taskbar icon" IsChecked="{Binding ShowBadge}" Margin="0,8,0,0" />
          <Button Content="Reset to defaults" Command="{Binding ResetNotificationsCommand}" />
        </StackPanel>

        <!-- Keyboard (DESIGN.md §14) -->
        <StackPanel Spacing="12" IsVisible="{Binding IsKeyboard}">
          <TextBlock Classes="section" Text="Keyboard" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Click a shortcut, then press the keys you want. Esc cancels. Quick suffix shortcuts are set in Quick suffixes." />
          <ItemsControl ItemsSource="{Binding ShortcutRows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ShortcutRow">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="220,190,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding ShortcutText}"
                            FontFamily="{StaticResource MonoFont}" Classes.accent="{Binding IsRecording}"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).StartRecordingCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Click, then press the new shortcut" />
                    <Button Grid.Column="2" Classes="flat" Content="Reset" IsVisible="{Binding IsCustomized}"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ResetShortcutCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Classes="flat" Content="Remove" IsVisible="{Binding Shortcut, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ClearShortcutCommand}" CommandParameter="{Binding}" />
                  </Grid>
                  <TextBlock Classes="small error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="228,0,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="In the message box, Enter sends and Shift+Enter starts a new line. In the new tab picker, 1–9 pick a folder; in the quick suffixes menu, 1–9 pick a suffix." />
          <Button Content="Reset to defaults" Command="{Binding ResetKeyboardCommand}" />
        </StackPanel>

        <!-- Perforce (DESIGN.md §18) -->
        <StackPanel Spacing="12" IsVisible="{Binding IsPerforce}">
          <TextBlock Classes="section" Text="Perforce" />
          <CheckBox Content="Keep Perforce logins fresh" IsChecked="{Binding PerforceEnabled}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="In a Perforce workspace, Claudette tells Claude it's one, and logs in again before the ticket expires so p4 commands keep working. Claude never sees the password. Applies to tabs started after the change." />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Classes="label" Text="Password source" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PerforcePasswordSources}" SelectedItem="{Binding SelectedPasswordSource}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Renew the ticket when less than this is left (minutes)" TextWrapping="Wrap" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="1440" Increment="5" FormatString="0" Value="{Binding PerforceRenewBeforeMinutes}" />
          </Grid>
          <TextBlock Classes="small warning" TextWrapping="Wrap" IsVisible="{Binding IsPerforceConfigSource}"
                     Text="P4PASSWD in a P4CONFIG file, in p4 set or in the environment is stored as plain text. Claudette only reads it." />
          <CheckBox Content="Request tickets valid on all hosts (p4 login -a)" IsChecked="{Binding PerforceAllHostsTickets}" />
          <CheckBox Content="Show changelist on tabs" IsChecked="{Binding ShowChangelistOnTabs}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-8,0,0"
                     Text="A CL 12345 badge after the tab's name. The tab info card always shows the changelist Claude is working in." />

          <!-- The stored password: the OS credential store, never settings.json -->
          <TextBlock Text="Stored password" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding StoredPasswordNote}" />
          <TextBlock Classes="small warning" TextWrapping="Wrap" Text="{Binding CredentialStoreUnavailableText}" IsVisible="{Binding !IsCredentialStoreAvailable}" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" IsEnabled="{Binding IsCredentialStoreAvailable}">
            <TextBlock Classes="label" Text="Server (P4PORT)" />
            <TextBox Grid.Column="1" Text="{Binding PerforcePasswordServer}" PlaceholderText="ssl:perforce:1666" />
            <TextBlock Grid.Row="1" Classes="label" Text="User" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PerforcePasswordUser}" />
            <TextBlock Grid.Row="2" Classes="label" Text="Password" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PerforcePassword}" PasswordChar="•" AutomationProperties.Name="Perforce password" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsCredentialStoreAvailable}">
            <Button Content="Save password" Command="{Binding SavePerforcePasswordCommand}" />
            <Button Content="Forget password" Command="{Binding ForgetPerforcePasswordCommand}" />
          </StackPanel>
          <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding PerforcePasswordStatus}"
                     IsVisible="{Binding PerforcePasswordStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <!-- Per-folder overrides -->
          <TextBlock Text="Per-folder server and user" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Normally Perforce finds the server and user itself (P4CONFIG files, p4 set, the environment), the same way Claude's p4 commands do. Set them here for tabs in a folder when that isn't right." />
          <ItemsControl ItemsSource="{Binding PerforceOverrides}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:PerforceOverrideEditor">
                <Grid ColumnDefinitions="*,160,120,Auto" ColumnSpacing="6">
                  <TextBlock Classes="small" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Folder}" />
                  <TextBox Grid.Column="1" Text="{Binding Server}" PlaceholderText="Server" />
                  <TextBox Grid.Column="2" Text="{Binding User}" PlaceholderText="User" />
                  <Button Grid.Column="3" Classes="flat" Padding="6" ToolTip.Tip="Remove" AutomationProperties.Name="Remove this folder's override"
                          Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemovePerforceOverrideCommand}" CommandParameter="{Binding}">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add folder…" Command="{Binding AddPerforceOverrideCommand}" />
            <Button Content="Reset to defaults" Command="{Binding ResetPerforceCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Advanced -->
        <StackPanel Spacing="12" IsVisible="{Binding IsAdvanced}">
          <TextBlock Classes="section" Text="Advanced" />
          <TextBlock Text="Extra arguments for every claude process" />
          <TextBox Text="{Binding ExtraArguments}" FontFamily="{StaticResource MonoFont}" PlaceholderText="for example --add-dir ../shared" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Split on spaces and added after Claudette's own arguments. Applies to tabs started after the change." />

          <!-- DESIGN.md §13, "Logging" -->
          <CheckBox Content="Log protocol traffic" IsChecked="{Binding LogProtocol}" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Writes everything each session sends and receives to the log folder, to help with bug reports when Claude Code changes. Logs hold your prompts and file contents, and are deleted after 7 days. Messages Claudette skips also show in the conversation. Applies to tabs started after the change." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
          </StackPanel>
          <Button Content="Reset to defaults" Command="{Binding ResetAdvancedCommand}" />

          <!-- DESIGN.md §16, "Staying tolerant at runtime" -->
          <TextBlock Classes="section" Text="Diagnostics" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="6">
            <TextBlock Text="Claude Code" />
            <TextBlock Grid.Column="1" Text="{Binding InstalledVersionText}" />
            <TextBlock Grid.Row="1" Text="Minimum supported Claude Code version" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MinimumVersionText}" />
          </Grid>
          <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="8,6">
            <SelectableTextBlock Text="{Binding DiagnosticsText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
          </Border>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Things Claude Code sent this run that Claudette doesn't know yet. They're skipped safely; a count here after a Claude Code update is worth a bug report." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" />
            <Button Content="Refresh" Command="{Binding RefreshDiagnosticsCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
