<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:conv="using:Claudette.App.Conversation"
             x:Class="Claudette.App.Views.AgentTree"
             x:DataType="vm:TabViewModel">

  <!-- The agent map as a tree list (DESIGN.md §18): compact rows, the task description up front. -->
  <UserControl.Styles>
    <Style Selector="TreeView.agents TreeViewItem" x:DataType="conv:AgentNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0,1" />
    </Style>
    <!-- Quiet selection and hover, like the sidebar's rows, rather than the accent fill. -->
    <Style Selector="TreeView.agents TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TreeView.agents TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView.agents TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
    </Style>
    <Style Selector="Border.agentrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <!-- A node waiting on a permission prompt stands out, like the prompt itself (DESIGN.md §7). -->
    <Style Selector="Border.agentrow.waiting">
      <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CautionBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <TextBlock Classes="muted small" Margin="12,4" TextWrapping="Wrap" IsVisible="{Binding !HasAgents}"
               Text="When Claude hands work to subagents, they show here as a tree under the agent that started them." />
    <TreeView x:Name="Tree" Classes="agents" Background="Transparent" Margin="4,0" IsVisible="{Binding HasAgents}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ItemsSource="{Binding Agents.Roots}" SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
              KeyDown="OnTreeKeyDown" AutomationProperties.Name="Agents">
      <!-- Only the rows in view are built; finished agents' subtrees fold away (DESIGN.md §18). -->
      <TreeView.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </TreeView.ItemsPanel>
      <TreeView.ItemTemplate>
        <TreeDataTemplate DataType="conv:AgentNode" ItemsSource="{Binding Children}">
          <Border Classes="agentrow" Classes.waiting="{Binding IsWaiting}" ToolTip.Tip="{Binding Tooltip}">
            <Grid ColumnDefinitions="16,*,Auto">
              <TextBlock Classes="status" Classes.busy="{Binding IsRunning}" Classes.alert="{Binding IsWaiting}"
                         Classes.ok="{Binding IsDone}" Classes.failed="{Binding IsFailed}"
                         Text="{Binding StatusGlyph}" Margin="0,1,0,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted small" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="mono small muted" Text="{Binding RunningText}" Margin="6,2,0,0" />
            </Grid>
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding ShowText}" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).ShowAgentCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding !IsRoot}" />
                <MenuItem Header="Copy prompt" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).CopyAgentPromptCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding HasPrompt}" />
                <MenuItem Header="Copy result" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).CopyAgentResultCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding HasResult}" />
                <MenuItem Header="{Binding StopText, StringFormat='{}{0}…'}" Command="{Binding $parent[UserControl].((vm:TabViewModel)DataContext).StopAgentCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding CanStop}" />
              </ContextMenu>
            </Border.ContextMenu>
          </Border>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Panel>
</UserControl>
