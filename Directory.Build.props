<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- The version being worked on, tagged vX.Y.Z when it's released. Releases pass it too: -p:Version=1.2.3 (packaging/).
         Source builds also show the commit they were built from (DESIGN.md §14, "Version"). -->
    <Version>0.1.0</Version>
    <Authors>Matthew Davey</Authors>
    <Product>Claudette</Product>
    <Copyright>Copyright (c) Matthew Davey</Copyright>
  </PropertyGroup>
</Project>
