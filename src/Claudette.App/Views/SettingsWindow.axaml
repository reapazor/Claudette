<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Claudette.App.ViewModels"
        xmlns:views="using:Claudette.App.Views"
        xmlns:settings="using:Claudette.App.ViewModels.Settings"
        xmlns:pages="using:Claudette.App.Views.Settings"
        x:Class="Claudette.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="820" Height="650" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- A setting's name beside its control: a long one wraps rather than being cut off, whatever the OS's font -->
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </Window.Styles>

  <!-- DESIGN.md §14: a sidebar of categories; changes apply immediately. -->
  <Grid ColumnDefinitions="190,*">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- DESIGN.md §14: a search box filters settings by name -->
        <TextBox DockPanel.Dock="Top" Margin="8,8,8,2" Text="{Binding SearchText}" PlaceholderText="Search settings"
                 AutomationProperties.Name="Search settings" />
        <!-- DESIGN.md §14, "Version": which Claudette this is, copied with a click, and a bug report with it filled in -->
        <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,10" Spacing="0">
          <Button Classes="flat" Command="{Binding CopyVersionCommand}" ToolTip.Tip="{Binding VersionTip}"
                  AutomationProperties.Name="Copy version details">
            <TextBlock Classes="muted small" Text="{Binding VersionLabel}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Button Classes="flat" Command="{Binding ReportIssueCommand}"
                  ToolTip.Tip="Opens a new issue on Claudette's GitHub with the versions filled in. Nothing is sent until you submit it.">
            <TextBlock Classes="muted small" Text="Report an issue" />
          </Button>
        </StackPanel>
        <Panel>
          <ScrollViewer x:Name="SidebarList" IsVisible="{Binding !IsSearching}">
            <StackPanel>
              <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedMainCategory}" Background="Transparent" Margin="6,6,6,0"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Categories" />
              <!-- DESIGN.md §14, "The project's pages": the selected tab's project, below a divider; hidden with no tab open -->
              <StackPanel x:Name="ProjectGroup" IsVisible="{Binding HasProject}">
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="12,6,12,4" />
                <TextBlock Classes="muted small" Text="{Binding Project.Heading, FallbackValue=''}" ToolTip.Tip="{Binding Project.Folder, FallbackValue=''}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="18,4,12,0" />
                <ListBox ItemsSource="{x:Static vm:SettingsViewModel.ProjectPages}" SelectedItem="{Binding SelectedProjectPage}" Background="Transparent" Margin="6,2,6,6"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Project pages" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" Background="Transparent" Margin="6"
                   IsVisible="{Binding IsSearching}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:SettingsSearchResult">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted small" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="muted small" Text="No settings match." Margin="14,10" TextWrapping="Wrap" VerticalAlignment="Top">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsSearching" />
                <Binding Path="!SearchResults.Count" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
        </Panel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="24,20">
      <!-- The page shown: the selected category's, or one of the project's. Each is a view in Views/Settings. -->
      <ContentControl Content="{Binding CurrentPage}" MaxWidth="620" HorizontalAlignment="Left">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="settings:GeneralPage">
            <pages:GeneralPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:ClaudeCodePage">
            <pages:ClaudeCodePageView />
          </DataTemplate>
          <DataTemplate DataType="settings:NewTabsPage">
            <pages:NewTabsPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:AppearancePage">
            <pages:AppearancePageView />
          </DataTemplate>
          <DataTemplate DataType="settings:SessionsPage">
            <pages:SessionsPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:DiffToolPage">
            <pages:DiffToolPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:ProjectToolsPage">
            <pages:ProjectToolsPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:ProcessesPage">
            <pages:ProcessesPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:UsagePage">
            <pages:UsagePageView />
          </DataTemplate>
          <DataTemplate DataType="settings:CheckInsPage">
            <pages:CheckInsPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:QuickSuffixesPage">
            <pages:QuickSuffixesPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:NotificationsPage">
            <pages:NotificationsPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:KeyboardPage">
            <pages:KeyboardPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:PerforcePage">
            <pages:PerforcePageView />
          </DataTemplate>
          <DataTemplate DataType="settings:AdvancedPage">
            <pages:AdvancedPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:ProjectLinksPage">
            <pages:ProjectLinksPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:ProjectActionsPage">
            <pages:ProjectActionsPageView />
          </DataTemplate>
          <DataTemplate DataType="settings:ProjectToolChoicesPage">
            <pages:ProjectToolChoicesPageView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </ScrollViewer>

    <!-- The project pages' small dialogs: a link, or an action (DESIGN.md §18). The action's is taller than the
         window opens, so it scrolls. -->
    <Border Grid.ColumnSpan="2" Classes="overlay" IsVisible="{Binding Project.HasEditor, FallbackValue=False}">
      <ScrollViewer Name="EditorScroller" VerticalScrollBarVisibility="Auto">
        <ContentControl Content="{Binding Project.Editor, FallbackValue={x:Null}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:ProjectActionEditorViewModel">
              <views:ProjectActionEditorView />
            </DataTemplate>
            <DataTemplate DataType="vm:ProjectLinkEditorViewModel">
              <views:ProjectLinkEditorView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
