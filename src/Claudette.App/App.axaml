<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:views="using:Claudette.App.Views"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:tm="clr-namespace:TextMateSharp.Grammars;assembly=TextMateSharp.Grammars"
             x:Class="Claudette.App.App"
             Name="Claudette"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS light/dark setting (DESIGN.md §2); Settings → Appearance can force one. -->

  <Application.DataTemplates>
    <DataTemplate DataType="vm:BusyViewModel">
      <views:BusyView />
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="vm:SignInViewModel">
      <views:SignInView />
    </DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel">
      <views:ShellView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <!-- The spectrum and hue slider of a folder group's color picker (Views/GroupColorPicker). -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <!-- LiveMarkdown brings its own fonts (Arial for text, Consolas for code); use the conversation's and code's from
         Settings → Appearance instead. Later styles win, so these follow the include. -->
    <!-- Claude's replies: the conversation font, or a serif in the Claude style (DESIGN.md §3, "Visual style"). -->
    <Style Selector="md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource ReplyFont}" />
    </Style>
    <!-- Syntax colors for the theme: LiveMarkdown's default is DarkPlus, in light mode too. Set through
         views:CodeBlockTheme, which re-highlights a block that's already shown without losing its code. -->
    <Style Selector="md|CodeBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="views:CodeBlockTheme.Theme" Value="{DynamicResource CodeColorTheme}" />
    </Style>
    <Style Selector="md|CodeBlock md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <!-- Inline code: LiveMarkdown's own is dark in light mode too; these follow the theme, as VS Code's do. -->
    <Style Selector="md|CodeInline">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="Background" Value="{DynamicResource InlineCodeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InlineCodeTextBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="3,0" />
    </Style>
    <!-- Code blocks (DESIGN.md §5): LiveMarkdown's own parts, in Claudette's look. A header line has the language, Wrap
         and Copy; Copy goes through the tab (Views/CodeBlockCopy), which puts the code on the clipboard and gives the
         block the "copied" class for a moment. -->
    <Style Selector="md|CodeBlock">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Classes="codeframe" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="10,2,4,0">
                <TextBlock x:Name="PART_LanguageTextBlock" DockPanel.Dock="Left" Classes="muted small" Text="{TemplateBinding Language}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                  <ToggleButton x:Name="PART_ToggleTextWrapButton" Classes="codetool" Focusable="False" IsChecked="{TemplateBinding IsCodeWrapped, Mode=TwoWay}"
                                ToolTip.Tip="Wrap long lines" AutomationProperties.Name="Wrap lines">
                    <Path Data="{DynamicResource IconWrap}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" StrokeLineCap="Round"
                          Width="12" Height="12" Stretch="None" />
                  </ToggleButton>
                  <Button x:Name="PART_CopyButton" Classes="flat codetool" Focusable="False" ToolTip.Tip="Copy the code" AutomationProperties.Name="Copy code">
                    <TextBlock x:Name="CopyLabel" Classes="muted small" Text="Copy" />
                  </Button>
                </StackPanel>
              </DockPanel>
              <ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="Disabled">
                <md:MarkdownTextBlock x:Name="PART_CodeTextBlock" Margin="10,2,10,8" FontFamily="{TemplateBinding FontFamily}"
                                      TextWrapping="{TemplateBinding TextWrapping}" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="md|CodeBlock /template/ Border.codeframe">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Settings → Appearance → Style → Claude (DESIGN.md §3): rounder, as in the Claude apps. -->
    <Style Selector=".claude md|CodeBlock /template/ Border.codeframe">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="md|CodeBlock.copied /template/ TextBlock#CopyLabel">
      <Setter Property="Text" Value="Copied" />
    </Style>
    <Style Selector=".compact md|CodeBlock /template/ md|MarkdownTextBlock#PART_CodeTextBlock">
      <Setter Property="Margin" Value="10,0,10,5" />
    </Style>
    <Style Selector=":is(Button).codetool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).codetool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.codetool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="MaxWidth" Value="520" />
    </Style>

    <!-- :is() so the classes also apply to SelectableTextBlock. -->
    <Style Selector=":is(TextBlock).title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource CodeFontSize}" />
    </Style>
    <Style Selector=":is(TextBlock).warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).ok">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).added">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector=":is(TextBlock).removed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>

    <!-- Flat buttons: rows, chips and toolbar items that only show a background on hover. -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- Disabled, a flat button is just its muted text: Fluent's disabled background would draw a grey pill. -->
    <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- Tabs: rows in the sidebar (DESIGN.md §4) -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- A tab's row. Settings → Appearance → Density (DESIGN.md §14): ShellView takes the "compact" class. -->
    <Style Selector="Button.tabrow">
      <Setter Property="Padding" Value="6,5,4,5" />
    </Style>
    <Style Selector=".compact Button.tabrow">
      <Setter Property="Padding" Value="6,2,4,2" />
    </Style>
    <!-- The context ring on a tab's row (DESIGN.md §4): muted, amber near auto-compact, red when nearly full. -->
    <Style Selector="Ellipse.contexttrack">
      <Setter Property="Stroke" Value="{DynamicResource MeterTrackBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Arc.contextarc">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <Style Selector="Arc.contextarc.high">
      <Setter Property="Stroke" Value="{DynamicResource MeterWarningBrush}" />
    </Style>
    <Style Selector="Arc.contextarc.critical">
      <Setter Property="Stroke" Value="{DynamicResource MeterCriticalBrush}" />
    </Style>
    <!-- A row's close button shows on hover and on the selected tab, so the list stays quiet and names get the room. -->
    <Style Selector="Button.tab Button.closetab">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.tab:pointerover Button.closetab, Button.tab.selected Button.closetab">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TabSelectedBrush}" />
    </Style>
    <!-- A tab in Bypass permissions mode stands out (DESIGN.md §7). -->
    <Style Selector="Button.tab.bypass /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BypassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- A tab's project runs, under its row (DESIGN.md §4, §18): small rows indented to the tab's name, the name over
         how it's going or how it ended, with the entry whose log the Project page shows picked out. -->
    <Style Selector="ItemsControl.runs">
      <Setter Property="Margin" Value="20,0,0,1" />
    </Style>
    <Style Selector="Button.runrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,3,4,3" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector=".compact Button.runrow">
      <Setter Property="Padding" Value="6,1,4,1" />
    </Style>
    <Style Selector="Button.runrow.showing /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
    </Style>
    <Style Selector="TextBlock.runglyph, TextBlock.runname">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.rundetail">
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- The working line above the composer (DESIGN.md §5, "Working line") -->
    <Style Selector="TextBlock.working-glyph">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.working-verb">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status dots and glyphs -->
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.busy">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.status.alert">
      <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.status.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <!-- After .ok: a failed tool call is also complete, and the failure is what should show. -->
    <Style Selector="TextBlock.status.failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector="TextBlock.status.unread">
      <Setter Property="Foreground" Value="{DynamicResource AccentStatusBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Composer box -->
    <Style Selector="Border.composer">
      <Setter Property="Background" Value="{DynamicResource ComposerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ComposerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6,6,6" />
    </Style>
    <Style Selector=".compact Border.composer">
      <Setter Property="Padding" Value="8,2,4,3" />
    </Style>
    <!-- Settings → Appearance → Style → Claude (DESIGN.md §3): the Claude apps' big rounded message box, lifted a
         little off the page. -->
    <Style Selector=".claude Border.composer">
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Padding" Value="16,8,8,8" />
      <Setter Property="BoxShadow" Value="0 2 12 0 #14000000" />
    </Style>
    <Style Selector=".claude.compact Border.composer">
      <Setter Property="Padding" Value="14,3,6,4" />
    </Style>
    <Style Selector=".claude Button.tabrow">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector=".claude Button.runrow">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.composer.bypass">
      <Setter Property="BorderBrush" Value="{DynamicResource BypassBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.composer TextBox, Border.composer TextBox:focus, Border.composer TextBox:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.composer TextBox:focus /template/ Border#PART_BorderElement, Border.composer TextBox:pointerover /template/ Border#PART_BorderElement, Border.composer TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Overlays -->
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource DialogBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 8 32 0 #40000000" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Updated from Settings → Appearance. -->
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
      <FontFamily x:Key="ConversationFont">$Default</FontFamily>
      <FontFamily x:Key="ReplyFont">$Default</FontFamily>
      <!-- The page's background: none, except under Mica (MainWindow sets it then). -->
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="Transparent" />
      <!-- Updated from Settings → Appearance. -->
      <x:Double x:Key="ConversationFontSize">14</x:Double>
      <x:Double x:Key="CodeFontSize">13</x:Double>

      <!-- Small vector icons, so they look the same on every platform. -->
      <StreamGeometry x:Key="IconClose">M2,2 L10,10 M10,2 L2,10</StreamGeometry>
      <!-- A square, filled: Stop on a running project run in the sidebar (DESIGN.md §18). -->
      <StreamGeometry x:Key="IconStop">M2,2 L10,2 L10,10 L2,10 Z</StreamGeometry>
      <!-- 32×32, the size of the Claude style's round Send and Stop buttons (DESIGN.md §3), so they're drawn about the
           button's own middle. A smaller icon is centered by layout, which rounds it to a whole pixel: at 150% one 10 or
           14 wide lands half a pixel off. The square's 12 is whole pixels at 100%, 150% and 200%. -->
      <StreamGeometry x:Key="IconSendArrow">M16,21 L16,11.5 M11.5,15.5 L16,11 L20.5,15.5</StreamGeometry>
      <StreamGeometry x:Key="IconStopRound">M10,10 L22,10 L22,22 L10,22 Z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M6,1 L6,11 M1,6 L11,6</StreamGeometry>
      <!-- A suffix on the message, in the suffix menu (DESIGN.md §5). -->
      <StreamGeometry x:Key="IconCheck">M1.5,6.5 L4.5,9.5 L10.5,2.5</StreamGeometry>
      <StreamGeometry x:Key="IconPin">M4,1 L8,1 L8,5 L10,7 L6.5,7 L6,11 L5.5,7 L2,7 L4,5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M1,3 L11,3 M1,9 L11,9 M4,1 L4,5 M8,7 L8,11</StreamGeometry>
      <StreamGeometry x:Key="IconHistory">M6,1 A5,5 0 1 1 1.67,3.5 M1.2,1.2 L1.67,3.5 L4,3.2 M6,3.5 L6,6 L8,7.2</StreamGeometry>
      <StreamGeometry x:Key="IconSidebar">M1.5,2 L10.5,2 L10.5,10 L1.5,10 Z M4.5,2 L4.5,10</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M3,4.5 L6,7.5 L9,4.5</StreamGeometry>
      <StreamGeometry x:Key="IconChevronRight">M4.5,3 L7.5,6 L4.5,9</StreamGeometry>
      <StreamGeometry x:Key="IconChevronUp">M3,7.5 L6,4.5 L9,7.5</StreamGeometry>
      <StreamGeometry x:Key="IconUpdate">M6,10.5 L6,2 M2.5,5.5 L6,2 L9.5,5.5</StreamGeometry>
      <StreamGeometry x:Key="IconOpenWindow">M7,1.5 L10.5,1.5 L10.5,5 M10.5,1.5 L6,6 M5,2.5 L1.5,2.5 L1.5,10.5 L9.5,10.5 L9.5,7</StreamGeometry>
      <StreamGeometry x:Key="IconRestart">M10.5,6 A4.5,4.5 0 1 1 9.18,2.82 M9.4,0.6 L9.18,2.82 L6.96,2.6</StreamGeometry>
      <!-- Two arrows chasing round a circle: a tab that syncs to the session library (DESIGN.md §4, "Sidebar"). -->
      <StreamGeometry x:Key="IconSync">M1.5,6 A4.5,4.5 0 0 1 9.9,3.75 M7.83,3 L9.9,3.75 L10.28,1.58 M10.5,6 A4.5,4.5 0 0 1 2.1,8.25 M4.17,9 L2.1,8.25 L1.72,10.42</StreamGeometry>
      <!-- A phone: a tab connected to the Claude app (DESIGN.md §18, "Remote Control"). 7×10. -->
      <StreamGeometry x:Key="IconPhone">M1.5,0.5 L5.5,0.5 A1,1 0 0 1 6.5,1.5 L6.5,8.5 A1,1 0 0 1 5.5,9.5 L1.5,9.5 A1,1 0 0 1 0.5,8.5 L0.5,1.5 A1,1 0 0 1 1.5,0.5 Z M3,7.8 L4,7.8</StreamGeometry>
      <!-- Two sheets: Copy on a message (DESIGN.md §5, "Copy and times"). -->
      <StreamGeometry x:Key="IconCopy">M4,4 L10.5,4 L10.5,10.5 L4,10.5 Z M8,2.5 L8,1.5 L1.5,1.5 L1.5,8 L2.5,8</StreamGeometry>
      <!-- Three dots: a message's menu (DESIGN.md §5, "Rewind and branch"). Filled. -->
      <StreamGeometry x:Key="IconMore">M1.5,6 A1,1 0 1 0 3.5,6 A1,1 0 1 0 1.5,6 Z M5,6 A1,1 0 1 0 7,6 A1,1 0 1 0 5,6 Z M8.5,6 A1,1 0 1 0 10.5,6 A1,1 0 1 0 8.5,6 Z</StreamGeometry>
      <!-- A line wrapping back under itself: Wrap on a code block. -->
      <StreamGeometry x:Key="IconWrap">M1.5,2.5 L10.5,2.5 M1.5,6 L9,6 A2,2 0 0 1 9,10 L6,10 M7.5,8.5 L6,10 L7.5,11.5 M1.5,10 L3.5,10</StreamGeometry>
      <StreamGeometry x:Key="IconAttach">M9.5,5.5 L5.6,9.4 A2.3,2.3 0 0 1 2.35,6.15 L6.6,1.9 A1.5,1.5 0 0 1 8.72,4.02 L4.6,8.14 A0.7,0.7 0 0 1 3.6,7.15 L7.2,3.55</StreamGeometry>
      <!-- Tool cards (DESIGN.md §5); ToolIcons maps tool names to these. -->
      <StreamGeometry x:Key="IconToolRead">M2.5,1 L7,1 L9.5,3.5 L9.5,11 L2.5,11 Z M7,1 L7,3.5 L9.5,3.5 M4.2,6 L7.8,6 M4.2,8.2 L7.8,8.2</StreamGeometry>
      <StreamGeometry x:Key="IconToolEdit">M8,1.5 L10.5,4 L4,10.5 L1.5,10.5 L1.5,8 Z M6.5,3 L9,5.5</StreamGeometry>
      <StreamGeometry x:Key="IconToolWrite">M2.5,1 L7,1 L9.5,3.5 L9.5,11 L2.5,11 Z M7,1 L7,3.5 L9.5,3.5 M6,5.5 L6,9 M4.25,7.25 L7.75,7.25</StreamGeometry>
      <StreamGeometry x:Key="IconToolBash">M1.5,2.5 L5,6 L1.5,9.5 M6,10 L10.5,10</StreamGeometry>
      <StreamGeometry x:Key="IconToolSearch">M5,1.5 A3.5,3.5 0 1 1 5,8.5 A3.5,3.5 0 1 1 5,1.5 M7.5,7.5 L10.5,10.5</StreamGeometry>
      <!-- A project (DESIGN.md §18, "Project tools"): a cube, for the sidebar's project row -->
      <StreamGeometry x:Key="IconProject">M6,1 L10.5,3.5 L10.5,8.5 L6,11 L1.5,8.5 L1.5,3.5 Z M1.5,3.5 L6,6 L10.5,3.5 M6,6 L6,11</StreamGeometry>
      <StreamGeometry x:Key="IconToolFolder">M1,2.5 L4.5,2.5 L5.5,4 L11,4 L11,10 L1,10 Z</StreamGeometry>
      <StreamGeometry x:Key="IconToolWeb">M6,1 A5,5 0 1 1 6,11 A5,5 0 1 1 6,1 M1,6 L11,6 M6,1 C3.6,3.6 3.6,8.4 6,11 M6,1 C8.4,3.6 8.4,8.4 6,11</StreamGeometry>
      <StreamGeometry x:Key="IconToolWebSearch">M5,1.5 A3.5,3.5 0 1 1 5,8.5 A3.5,3.5 0 1 1 5,1.5 M1.5,5 L8.5,5 M5,1.5 C3.7,3 3.7,7 5,8.5 M5,1.5 C6.3,3 6.3,7 5,8.5 M7.5,7.5 L10.5,10.5</StreamGeometry>
      <StreamGeometry x:Key="IconToolAgent">M6,1 A1.5,1.5 0 1 1 6,4 A1.5,1.5 0 1 1 6,1 M2.5,8 A1.5,1.5 0 1 1 2.5,11 A1.5,1.5 0 1 1 2.5,8 M9.5,8 A1.5,1.5 0 1 1 9.5,11 A1.5,1.5 0 1 1 9.5,8 M6,4 L6,6 M2.5,8 L2.5,6 L9.5,6 L9.5,8</StreamGeometry>
      <StreamGeometry x:Key="IconToolTodo">M1.5,3 L2.5,4 L4,2 M6,3 L11,3 M1.5,8 L2.5,9 L4,7 M6,8 L11,8</StreamGeometry>
      <StreamGeometry x:Key="IconToolMcp">M4,1 L4,3.5 M8,1 L8,3.5 M2.5,3.5 L9.5,3.5 L9.5,5.5 A3.5,3.5 0 0 1 2.5,5.5 Z M6,9 L6,11.5</StreamGeometry>
      <StreamGeometry x:Key="IconToolSkill">M6,1 L7.2,4.8 L11,6 L7.2,7.2 L6,11 L4.8,7.2 L1,6 L4.8,4.8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconToolQuestion">M6,1 A5,5 0 1 1 6,11 A5,5 0 1 1 6,1 M4.4,4.6 A1.6,1.6 0 1 1 6.6,6.1 C6.1,6.4 6,6.8 6,7.3 M6,8.7 L6,9.1</StreamGeometry>
      <StreamGeometry x:Key="IconToolPlan">M1.5,2.5 L10.5,2.5 M1.5,6 L10.5,6 M1.5,9.5 L7,9.5</StreamGeometry>
      <!-- A pulse: a Monitor watch, on its card and in the running tasks list (DESIGN.md §5, "Running tasks"). -->
      <StreamGeometry x:Key="IconToolMonitor">M1,6.5 L3.5,6.5 L5,2.5 L7,10 L8.5,6.5 L11,6.5</StreamGeometry>
      <!-- A cloud: a remote agent in the running tasks list. -->
      <StreamGeometry x:Key="IconToolRemote">M3,9.5 L9,9.5 A2.25,2.25 0 0 0 9.2,5 A3,3 0 0 0 3.4,4.6 A2.45,2.45 0 0 0 3,9.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconToolDefault">M6,1 L10.5,3.5 L10.5,8.5 L6,11 L1.5,8.5 L1.5,3.5 Z M1.5,3.5 L6,6 L10.5,3.5 M6,6 L6,11</StreamGeometry>

      <!-- Claudette's color tokens, per theme. Views use only these, never Fluent's internal resource names. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- With Mica on Windows 11 (MainWindow): the page stays opaque and the sidebar lets the backdrop through. -->
          <SolidColorBrush x:Key="MicaPageBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaSidebarBrush" Color="#66F3F3F3" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6368" />
          <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="CardBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="ToolCardBrush" Color="#F3F3F5" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#F4F4F6" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#F0F0F2" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComposerBorderBrush" Color="#2A000000" />
          <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#33000000" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="OkTextBrush" Color="#107C10" />
          <SolidColorBrush x:Key="AccentStatusBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="CautionBorderBrush" Color="#D9A400" />
          <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FFF6D6" />
          <SolidColorBrush x:Key="DiffAddedBrush" Color="#E6F4EA" />
          <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FCE8E6" />
          <SolidColorBrush x:Key="DiffHunkBrush" Color="#EEF1F8" />
          <SolidColorBrush x:Key="UserBoxBrush" Color="#F4F4F6" />
          <SolidColorBrush x:Key="UserBoxBorderBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="SubagentLineBrush" Color="#33000000" />
          <SolidColorBrush x:Key="SelectedRowBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
          <SolidColorBrush x:Key="BypassBorderBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MeterBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="MeterWarningBrush" Color="#D98A00" />
          <SolidColorBrush x:Key="MeterCriticalBrush" Color="#C42B1C" />
          <!-- The detailed usage header's charts (DESIGN.md §6): model-specific weekly limits beside the accent line, and
               the page behind the charts, for the ring around a marker. Checked apart from the accent and each other,
               also with color blindness. -->
          <SolidColorBrush x:Key="ChartModelBrush" Color="#12946A" />
          <SolidColorBrush x:Key="ChartModel2Brush" Color="#4A3AA7" />
          <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#FFFFFF" />
          <!-- The parts of a tab's context window (DESIGN.md §6, "Per-tab context"), in the bar's order: the categorical
               palette, placed so that every two parts that can end up side by side stay apart, also with color
               blindness (ContextBreakdown.Parts). The auto-compact buffer is hatched, beside the free space's track. -->
          <SolidColorBrush x:Key="ContextMemoryBrush" Color="#EB6834" />
          <SolidColorBrush x:Key="ContextSkillsBrush" Color="#1BAF7A" />
          <SolidColorBrush x:Key="ContextPromptBrush" Color="#4A3AA7" />
          <SolidColorBrush x:Key="ContextAgentsBrush" Color="#EDA100" />
          <SolidColorBrush x:Key="ContextToolsBrush" Color="#E87BA4" />
          <SolidColorBrush x:Key="ContextMcpBrush" Color="#008300" />
          <SolidColorBrush x:Key="ContextMessagesBrush" Color="#2A78D6" />
          <SolidColorBrush x:Key="ContextOtherBrush" Color="#E34948" />
          <DrawingBrush x:Key="ContextBufferBrush" TileMode="Tile" DestinationRect="0,0,5,5" Stretch="None">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Brush="#1A000000" Geometry="M0,0 H5 V5 H0 Z" />
                <GeometryDrawing Geometry="M-1,1 L1,-1 M0,5 L5,0 M4,6 L6,4">
                  <GeometryDrawing.Pen>
                    <Pen Brush="#59000000" Thickness="1" />
                  </GeometryDrawing.Pen>
                </GeometryDrawing>
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
          <SolidColorBrush x:Key="InlineCodeBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#A31515" />
          <tm:ThemeName x:Key="CodeColorTheme">LightPlus</tm:ThemeName>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MicaPageBrush" Color="#202020" />
          <SolidColorBrush x:Key="MicaSidebarBrush" Color="#66141416" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#A6A6A6" />
          <SolidColorBrush x:Key="DividerBrush" Color="#2EFFFFFF" />
          <SolidColorBrush x:Key="CardBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="ToolCardBrush" Color="#1A1A1C" />
          <SolidColorBrush x:Key="SubtleBrush" Color="#1C1C1F" />
          <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="TabSelectedBrush" Color="#2B2B2F" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#141416" />
          <SolidColorBrush x:Key="ComposerBrush" Color="#1C1C1F" />
          <SolidColorBrush x:Key="ComposerBorderBrush" Color="#3DFFFFFF" />
          <SolidColorBrush x:Key="DialogBrush" Color="#202023" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="OkTextBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="AccentStatusBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="CautionBorderBrush" Color="#8A6D00" />
          <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#2B2610" />
          <SolidColorBrush x:Key="DiffAddedBrush" Color="#1D3B26" />
          <SolidColorBrush x:Key="DiffRemovedBrush" Color="#46201F" />
          <SolidColorBrush x:Key="DiffHunkBrush" Color="#23283A" />
          <SolidColorBrush x:Key="UserBoxBrush" Color="#1E1E22" />
          <SolidColorBrush x:Key="UserBoxBorderBrush" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="SubagentLineBrush" Color="#40FFFFFF" />
          <SolidColorBrush x:Key="SelectedRowBrush" Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.22" />
          <SolidColorBrush x:Key="BypassBorderBrush" Color="#E0605A" />
          <SolidColorBrush x:Key="MeterTrackBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="MeterBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="MeterWarningBrush" Color="#F2B233" />
          <SolidColorBrush x:Key="MeterCriticalBrush" Color="#FF6B61" />
          <SolidColorBrush x:Key="ChartModelBrush" Color="#199E70" />
          <SolidColorBrush x:Key="ChartModel2Brush" Color="#9D6FE8" />
          <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#000000" />
          <SolidColorBrush x:Key="ContextMemoryBrush" Color="#D95926" />
          <SolidColorBrush x:Key="ContextSkillsBrush" Color="#199E70" />
          <SolidColorBrush x:Key="ContextPromptBrush" Color="#9085E9" />
          <SolidColorBrush x:Key="ContextAgentsBrush" Color="#C98500" />
          <SolidColorBrush x:Key="ContextToolsBrush" Color="#D55181" />
          <SolidColorBrush x:Key="ContextMcpBrush" Color="#008300" />
          <SolidColorBrush x:Key="ContextMessagesBrush" Color="#3987E5" />
          <SolidColorBrush x:Key="ContextOtherBrush" Color="#E66767" />
          <DrawingBrush x:Key="ContextBufferBrush" TileMode="Tile" DestinationRect="0,0,5,5" Stretch="None">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Brush="#26FFFFFF" Geometry="M0,0 H5 V5 H0 Z" />
                <GeometryDrawing Geometry="M-1,1 L1,-1 M0,5 L5,0 M4,6 L6,4">
                  <GeometryDrawing.Pen>
                    <Pen Brush="#66FFFFFF" Thickness="1" />
                  </GeometryDrawing.Pen>
                </GeometryDrawing>
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
          <SolidColorBrush x:Key="InlineCodeBrush" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#D7BA7D" />
          <tm:ThemeName x:Key="CodeColorTheme">DarkPlus</tm:ThemeName>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
